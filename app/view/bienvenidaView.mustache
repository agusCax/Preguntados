<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cerebrito</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Nunito:wght@600;700;800&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet" />

    <style>
        /* =========================================================
           TOKENS CEREBRITO CARTOON
           ========================================================= */
        :root {
            --color-ink: #0f172a;
            --color-ink-soft: #334155;
            --color-cream: #fff8e8;
            --color-white: #ffffff;

            --color-primary: #0284c7;
            --color-primary-dark: #0369a1;
            --color-sky-soft: #bfe6fb;
            --color-sun: #fcd34d;
            --color-amber: #f59e0b;

            --font-ui: "Outfit", system-ui, -apple-system, "Segoe UI", sans-serif;
            --font-display: "Fredoka", "Outfit", system-ui, sans-serif;
            --font-text: "Nunito", "Outfit", system-ui, sans-serif;

            --fs-display-mobile: 34px;
            --lh-display-mobile: 38px;
            --fs-display: 56px;
            --lh-display: 60px;
            --fs-body-md: 16px;
            --lh-body-md: 24px;
            --fs-body-lg: 18px;
            --lh-body-lg: 26px;
            --fs-label-lg: 16px;

            --radius-full: 9999px;
            --border-edge: 3px solid var(--color-ink);
            --shadow-button: 0 5px 0 var(--color-ink);

            --space-xs: 0.25rem;
            --space-sm: 0.5rem;
            --space-md: 1rem;
            --space-lg: 1.5rem;
            --space-xl: 2.25rem;

            --margin: 1rem;
            --gutter: 1rem;
        }

        /* =========================================================
           RESET / BASE
           ========================================================= */
        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            -webkit-text-size-adjust: 100%;
        }

        body {
            font-family: var(--font-text);
            font-weight: 700;
            color: var(--color-ink);
            background-color: var(--color-cream);
            -webkit-font-smoothing: antialiased;
        }

        img {
            display: block;
            max-width: 100%;
            height: auto;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* =========================================================
           COMPONENTE: BOTONES TÁCTILES CARTOON
           ========================================================= */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 56px;
            padding: 0 var(--space-lg);
            border: var(--border-edge);
            border-radius: var(--radius-full);
            font-family: var(--font-ui);
            font-size: var(--fs-label-lg);
            font-weight: 800;
            line-height: 20px;
            white-space: nowrap;
            cursor: pointer;
            box-shadow: var(--shadow-button);
            transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease;
        }

        .btn--primary {
            background-color: var(--color-amber);
            color: var(--color-ink);
        }

        .btn--secondary {
            background-color: var(--color-white);
            color: var(--color-ink);
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 7px 0 var(--color-ink);
        }

        .btn--secondary:hover {
            background-color: var(--color-sky-soft);
        }

        .btn:active {
            transform: translateY(5px);
            box-shadow: 0 0 0 var(--color-ink);
        }

        .btn:focus-visible {
            outline: 3px solid var(--color-primary);
            outline-offset: 3px;
        }

        /* =========================================================
           PANTALLA: BIENVENIDA (mobile first)
           ========================================================= */
        .welcome {
            position: relative;
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            overflow: hidden;
            background-color: var(--color-cream);
        }

        /* Marca (esquina superior izquierda) */
        .welcome__brand {
            position: absolute;
            top: var(--space-lg);
            left: var(--margin);
            z-index: 2;
            font-family: var(--font-display);
            font-size: 28px;
            line-height: 1;
            font-weight: 700;
            letter-spacing: -0.01em;
            color: var(--color-primary-dark);
            text-shadow: 2px 2px 0 var(--color-sky-soft);
        }

        /* Formas decorativas */
        .welcome__shape {
            position: absolute;
            pointer-events: none;
            z-index: 0;
        }

        .welcome__shape--circle {
            top: -10%;
            right: -20%;
            width: 90vw;
            height: 90vw;
            border-radius: 50%;
            background-color: var(--color-sky-soft);
            opacity: 0.65;
        }

        .welcome__shape--ring {
            bottom: -5%;
            left: -10%;
            width: 55vw;
            height: 55vw;
            border: 5px dashed var(--color-sun);
            border-radius: 50%;
            opacity: 0.85;
        }

        /* Contenedor principal: columna */
        .welcome__container {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 540px;
            margin: 0 auto;
            padding: calc(var(--space-xl) + var(--space-lg)) var(--margin)
            calc(var(--space-xl) + var(--space-md));
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            gap: var(--space-lg);
        }

        /* Mascota */
        .welcome__media {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
        }

        .welcome__mascot {
            width: min(70%, 280px);
            animation: mascot-float 3.5s ease-in-out infinite;
        }

        /* Contenido */
        .welcome__content {
            width: 100%;
            text-align: center;
        }

        .welcome__title {
            font-family: var(--font-display);
            font-size: var(--fs-display-mobile);
            line-height: var(--lh-display-mobile);
            font-weight: 700;
            color: var(--color-ink);
            text-shadow: 3px 3px 0 var(--color-white);
            margin-bottom: var(--space-md);
        }

        .welcome__subtitle {
            font-family: var(--font-text);
            font-size: var(--fs-body-md);
            line-height: var(--lh-body-md);
            font-weight: 700;
            color: var(--color-ink-soft);
            margin-bottom: var(--space-xl);
        }

        /* Acciones: dos botones en fila */
        .welcome__actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            align-items: center;
            gap: var(--gutter);
        }

        @media (max-width: 359px) {
            .welcome__actions {
                grid-template-columns: 1fr;
            }
        }

        /* =========================================================
           TABLET (≥ 768px)
           ========================================================= */
        @media (min-width: 768px) {
            :root {
                --margin: 1.5rem;
                --gutter: 1.25rem;
            }

            .welcome__container {
                max-width: 640px;
            }

            .welcome__mascot {
                width: min(60%, 340px);
            }

            .welcome__title {
                font-size: 42px;
                line-height: 48px;
            }

            .welcome__subtitle {
                font-size: var(--fs-body-lg);
                line-height: var(--lh-body-lg);
            }
        }

        /* =========================================================
           DESKTOP (≥ 1024px)
           ========================================================= */
        @media (min-width: 1024px) {
            :root {
                --margin: 2.5rem;
                --gutter: 1.5rem;
            }

            .welcome {
                align-items: center;
            }

            .welcome__brand {
                top: var(--space-xl);
                font-size: 32px;
            }

            .welcome__shape--circle {
                top: 50%;
                left: 45vw;
                right: auto;
                width: max(60vw, 100dvh);
                height: max(60vw, 100dvh);
                transform: translateY(-50%);
            }

            .welcome__shape--circle::after {
                content: "";
                position: absolute;
                top: 50%;
                left: 50%;
                width: 100vw;
                height: 200vh;
                transform: translateY(-50%);
                background-color: inherit;
            }

            .welcome__shape--ring {
                bottom: -15%;
                left: -5%;
                width: 30vw;
                height: 30vw;
            }

            .welcome__container {
                max-width: 1200px;
                flex-direction: row;
                justify-content: center;
                gap: 4rem;
                padding: 4rem var(--margin);
            }

            .welcome__media {
                flex: 1 1 0;
                min-width: 0;
                justify-content: center;
            }

            .welcome__mascot {
                width: min(100%, 460px);
                transform: translateX(calc(-1 * clamp(0px, 4vw, 80px)));
            }

            .welcome__content {
                flex: 1 1 0;
                min-width: 0;
                text-align: left;
            }

            .welcome__title {
                font-size: var(--fs-display);
                line-height: var(--lh-display);
                margin-bottom: var(--space-lg);
            }

            .welcome__subtitle {
                font-size: 22px;
                line-height: 30px;
                margin-bottom: 2.5rem;
            }

            .welcome__actions {
                display: flex;
                align-items: center;
                gap: var(--space-lg);
            }

            .btn {
                min-height: 60px;
                padding: 0 2.5rem;
                font-size: 18px;
            }
        }

        /* =========================================================
           BURBUJAS DE CATEGORÍAS (≥ 1400px)
           ========================================================= */
        .welcome__bubbles {
            display: none;
            list-style: none;
        }

        @media (min-width: 1400px) {
            .welcome__bubbles {
                display: block;
            }

            .bubble {
                position: absolute;
                z-index: 1;
                left: calc(50% + 600px + var(--ox) * (50% - 600px));
                top: var(--y);
                width: var(--s);
                height: var(--s);
                margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
                display: grid;
                place-items: center;
                font-size: calc(var(--s) * 0.5);
                line-height: 1;
                background-color: var(--tint);
                border: var(--border-edge);
                border-radius: 50%;
                box-shadow: 0 4px 0 var(--color-ink);
                animation: bubble-float var(--d) ease-in-out var(--delay) infinite;
            }
        }

        @keyframes bubble-float {
            0%, 100% {
                translate: 0 0;
            }
            50% {
                translate: 0 -10px;
            }
        }

        @keyframes mascot-float {
            0%, 100% {
                translate: 0 0;
            }
            50% {
                translate: 0 -8px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .bubble,
            .welcome__mascot {
                animation: none;
            }

            .btn {
                transition: none;
            }
        }
    </style>
</head>
<body>

<main class="welcome">
    <!-- Marca -->
    <a href="{{base_url}}/inicio/show" class="welcome__brand">Cerebrito</a>

    <!-- Formas decorativas de fondo -->
    <span class="welcome__shape welcome__shape--circle" aria-hidden="true"></span>
    <span class="welcome__shape welcome__shape--ring" aria-hidden="true"></span>

    <!-- Burbujas de categorías (decorativas, solo desktop grande) -->
    <ul class="welcome__bubbles" aria-hidden="true">
        <li class="bubble" style="--ox:0.05; --y:11.5%; --s:62px; --tint:#d1fae5; --d:6s;   --delay:0s">🔬</li>
        <li class="bubble" style="--ox:0.26; --y:22.5%; --s:68px; --tint:#fef3c7; --d:7s;   --delay:-2s">🏛️</li>
        <li class="bubble" style="--ox:0.40; --y:33.5%; --s:74px; --tint:#e0f2fe; --d:5.5s; --delay:-1s">🌎</li>
        <li class="bubble" style="--ox:0.47; --y:44.5%; --s:80px; --tint:#fce7f3; --d:6.5s; --delay:-3s">🎨</li>
        <li class="bubble" style="--ox:0.47; --y:55.5%; --s:80px; --tint:#fee2e2; --d:7.5s; --delay:-4s">⚽</li>
        <li class="bubble" style="--ox:0.40; --y:66.5%; --s:74px; --tint:#ede9fe; --d:6s;   --delay:-2.5s">🎬</li>
        <li class="bubble" style="--ox:0.26; --y:77.5%; --s:68px; --tint:#ffedd5; --d:5s;   --delay:-1.5s">🎵</li>
        <li class="bubble" style="--ox:0.05; --y:88.5%; --s:62px; --tint:#cffafe; --d:7s;   --delay:-3.5s">💻</li>
    </ul>

    <div class="welcome__container">

        <!-- Mascota -->
        <figure class="welcome__media">
            <img
                    class="welcome__mascot"
                    src="{{base_url}}/public/img/imagenPreguntadosLogo.png"
                    alt="Cerebrito, la mascota, pensando con un signo de pregunta"
            />
        </figure>

        <!-- Contenido -->
        <section class="welcome__content">
            <h1 class="welcome__title">Jugá y aprendé al mismo tiempo</h1>
            <p class="welcome__subtitle">¡Creá tu cuenta y accedé a Cerebrito!</p>

            <div class="welcome__actions">
                <a href="{{base_url}}/registro/show" class="btn btn--primary">Registrarse</a>
                <a href="{{base_url}}/login/show" class="btn btn--secondary">Iniciar Sesión</a>
            </div>
        </section>

    </div>
</main>

</body>
</html>