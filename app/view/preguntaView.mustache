<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cerebrito | Pregunta</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Nunito:wght@600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --color-primary: #0284c7;
            --color-primary-dark: #0369a1;
            --color-sky-soft: #bfe6fb;
            --color-sun: #fcd34d;
            --color-ink: #0f172a;
            --color-ink-soft: #334155;
            --color-white: #ffffff;
            --color-border: #e2e8f0;
            --color-correct: #10b981;
            --color-wrong: #ef4444;

            --font-family: "Outfit", system-ui, -apple-system, "Segoe UI", sans-serif;
            --font-display: "Fredoka", "Outfit", system-ui, sans-serif;
            --font-text: "Nunito", "Outfit", system-ui, sans-serif;

            --radius-full: 9999px;
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            min-height: 100dvh;
            font-family: var(--font-text);
            color: var(--color-ink);
            background-color: #fff8e8;
            background-color: color-mix(in srgb, var(--cat, #0284c7) 16%, #fff8e8);
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            margin: -1px;
            padding: 0;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        .q__top {
            position: relative;
            padding: 1rem 1rem 4.5rem;
            background-color: var(--cat, #0284c7);
            background-image:
                    linear-gradient(160deg, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0) 55%),
                    repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.09) 0 14px, rgba(255, 255, 255, 0) 14px 28px);
            border-bottom: 3px solid var(--color-ink);
            border-radius: 0 0 2.5rem 2.5rem;
            box-shadow: 0 6px 0 var(--color-ink);
        }

        .q__top-inner {
            display: grid;
            gap: 0.9rem;
            max-width: 720px;
            margin: 0 auto;
        }

        .q__bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
        }

        .q__exit,
        .q__score,
        .q__cat {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            min-height: 44px;
            padding: 0 1.1rem;
            font-family: var(--font-family);
            font-weight: 800;
            color: var(--color-ink);
            background-color: var(--color-white);
            border: 2.5px solid var(--color-ink);
            border-radius: var(--radius-full);
            box-shadow: 0 4px 0 var(--color-ink);
        }

        .q__exit {
            text-decoration: none;
            font-size: 0.95rem;
            transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease;
            cursor: pointer;
        }

        .q__exit:hover {
            background-color: var(--color-sky-soft);
            transform: translateY(-2px);
            box-shadow: 0 6px 0 var(--color-ink);
        }

        .q__exit:active {
            transform: translateY(4px);
            box-shadow: 0 0 0 var(--color-ink);
        }

        .q__score {
            font-size: 1.15rem;
        }

        .q__star {
            display: inline-block;
            font-size: 1.3rem;
            animation: star-bounce 2.4s ease-in-out infinite;
        }

        .q__cat {
            justify-self: center;
            font-size: 1.1rem;
            transform: rotate(-2deg);
            animation: pop-in 0.5s 0.05s cubic-bezier(0.34, 1.56, 0.64, 1) both;
        }

        .q__cat-icon {
            font-size: 1.35rem;
        }

        .q__timer {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .q__track {
            flex: 1;
            height: 24px;
            padding: 3px;
            background-color: rgba(15, 23, 42, 0.28);
            border: 2.5px solid var(--color-ink);
            border-radius: var(--radius-full);
        }

        .q__fill {
            width: 100%;
            height: 100%;
            min-width: 0;
            background-color: #ffffff;
            background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.55));
            border-radius: var(--radius-full);
            transition: width 1s linear, background-color 0.3s ease;
        }

        .q__seconds {
            display: grid;
            place-items: center;
            flex-shrink: 0;
            width: 52px;
            height: 52px;
            font-family: var(--font-display);
            font-size: 1.4rem;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
            color: var(--color-ink);
            background-color: var(--color-white);
            border: 3px solid var(--color-ink);
            border-radius: 50%;
            box-shadow: 0 4px 0 var(--color-ink);
        }

        .q__timer.is-low .q__fill {
            background-color: var(--color-wrong);
            background-image: none;
            animation: blink 0.5s ease-in-out infinite alternate;
        }

        .q__timer.is-low .q__seconds {
            color: var(--color-wrong);
            border-color: var(--color-wrong);
            animation: heartbeat 0.5s ease-in-out infinite alternate;
        }

        .q__body {
            position: relative;
            display: grid;
            gap: 1.5rem;
            max-width: 720px;
            margin: -3rem auto 0;
            padding: 0 1rem 2.5rem;
        }

        .q__question {
            position: relative;
            padding: 1.75rem 1.25rem;
            font-family: var(--font-display);
            font-size: 1.5rem;
            line-height: 1.25;
            font-weight: 700;
            text-align: center;
            color: var(--color-ink);
            background-color: var(--color-white);
            border: 4px solid var(--color-ink);
            border-radius: 1.75rem;
            box-shadow: 0 8px 0 var(--color-ink);
            animation: drop-in 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) both;
        }

        .q__question::after {
            content: "?";
            position: absolute;
            top: -22px;
            right: -6px;
            display: grid;
            place-items: center;
            width: 44px;
            height: 44px;
            font-family: var(--font-display);
            font-size: 1.7rem;
            color: var(--color-ink);
            background-color: var(--color-sun);
            border: 3px solid var(--color-ink);
            border-radius: 50%;
            box-shadow: 0 3px 0 var(--color-ink);
            transform: rotate(14deg);
        }

        .q__options {
            display: grid;
            gap: 0.9rem;
        }

        .q__option {
            --opt-bg: var(--color-white);
            --opt-edge: var(--cat, #0284c7);
            --opt-ink: var(--color-ink);

            display: flex;
            align-items: center;
            gap: 0.9rem;
            width: 100%;
            min-height: 68px;
            padding: 0.6rem 1rem;
            font-family: var(--font-display);
            font-size: 1.15rem;
            font-weight: 700;
            text-align: left;
            color: var(--opt-ink);
            background-color: var(--opt-bg);
            border: 3px solid var(--opt-edge);
            border-radius: 1.25rem;
            box-shadow: 0 5px 0 var(--opt-edge);
            cursor: pointer;
            transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.15s ease;
            animation: pop-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
        }

        .q__option:nth-child(1) { animation-delay: 0.15s; }
        .q__option:nth-child(2) { animation-delay: 0.25s; }
        .q__option:nth-child(3) { animation-delay: 0.35s; }
        .q__option:nth-child(4) { animation-delay: 0.45s; }

        .q__option:hover {
            --opt-bg: color-mix(in srgb, var(--cat, #0284c7) 8%, #ffffff);
            transform: translateY(-3px);
            box-shadow: 0 8px 0 var(--opt-edge);
        }

        .q__option:active {
            transform: translateY(5px);
            box-shadow: 0 0 0 var(--opt-edge);
        }

        .q__letter {
            display: grid;
            place-items: center;
            flex-shrink: 0;
            width: 44px;
            height: 44px;
            font-family: var(--font-family);
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--color-ink);
            background-color: color-mix(in srgb, var(--cat, #0284c7) 18%, #ffffff);
            border: 3px solid var(--cat, #0284c7);
            border-radius: 50%;
        }

        .q__text {
            flex: 1;
            line-height: 1.2;
        }

        .game__mascot {
            display: none;
        }

        /* ---------- Modales (rendición - Cerebrito Cartoon) ---------- */
        .rep-modal {
            position: fixed;
            inset: 0;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            background-color: rgba(15, 23, 42, 0.55);
        }

        .rep-modal[hidden] {
            display: none;
        }

        #rendirse-modal .rep-modal__card {
            width: 100%;
            max-width: 420px;
            padding: 2rem 1.5rem;
            text-align: center;
            background-color: var(--color-white);
            border: 3px solid var(--color-ink);
            border-radius: 1.75rem;
            box-shadow: 0 8px 0 var(--color-ink);
            animation: pop-in 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) both;
        }

        #rendirse-modal .rep-modal__title {
            margin: 0 0 0.75rem;
            font-family: var(--font-display);
            font-size: 1.65rem;
            line-height: 1.15;
            font-weight: 700;
            color: var(--color-ink);
        }

        #rendirse-modal .rep-modal__text {
            margin: 0 0 1.35rem;
            font-weight: 800;
            line-height: 1.45;
            color: #b91c1c;
        }

        #rendirse-modal .rep-modal__actions {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.75rem;
        }

        #rendirse-modal .rep-modal__btn {
            width: min(100%, 18rem);
            min-height: 48px;
            padding: 0.65rem 1.25rem;
            font-family: var(--font-family);
            font-size: 1rem;
            font-weight: 800;
            border: 3px solid var(--color-ink);
            border-radius: var(--radius-full);
            box-shadow: 0 4px 0 var(--color-ink);
            cursor: pointer;
            transition: transform 0.1s ease, box-shadow 0.1s ease, filter 0.15s ease;
        }

        #rendirse-modal .rep-modal__btn--secondary {
            color: var(--color-white);
            background-color: var(--color-primary);
        }

        #rendirse-modal .rep-modal__btn--primary {
            color: var(--color-ink);
            background-color: var(--color-sky-soft);
        }

        #rendirse-modal .rep-modal__btn:hover {
            filter: brightness(1.04);
            transform: translateY(-2px);
            box-shadow: 0 6px 0 var(--color-ink);
        }

        #rendirse-modal .rep-modal__btn:active {
            transform: translateY(4px);
            box-shadow: 0 0 0 var(--color-ink);
        }

        @keyframes pop-in {
            from { opacity: 0; transform: scale(0.8) translateY(14px); }
            to   { opacity: 1; transform: none; }
        }

        @keyframes drop-in {
            from { opacity: 0; transform: translateY(-24px) scale(0.96); }
            to   { opacity: 1; transform: none; }
        }

        @keyframes star-bounce {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50%      { transform: translateY(-3px) rotate(12deg); }
        }

        @keyframes blink {
            from { opacity: 1; }
            to   { opacity: 0.55; }
        }

        @keyframes heartbeat {
            from { transform: scale(1); }
            to   { transform: scale(1.14); }
        }

        @media (min-width: 768px) {
            .q__top {
                padding: 1.5rem 1.5rem 5.5rem;
            }

            .q__body {
                gap: 2rem;
                margin-top: -3.75rem;
            }

            .q__body > * {
                position: relative;
                z-index: 1;
            }

            .q__question {
                padding: 2.5rem 3rem;
                font-size: 2rem;
            }

            .q__options {
                grid-template-columns: 1fr 1fr;
                gap: 1.1rem;
            }

            .q__option {
                min-height: 88px;
                font-size: 1.3rem;
            }

            .game__mascot {
                position: fixed;
                right: 2vw;
                bottom: 1.5vh;
                z-index: 0;
                display: block;
                width: clamp(110px, 14vw, 200px);
                height: auto;
                pointer-events: none;
                animation: star-bounce 3s ease-in-out infinite;
            }
        }

        /* Racha hacia el bono */
        .q__racha {
            display: grid;
            gap: 0.45rem;
            text-align: center;
        }

        .q__racha-texto {
            margin: 0;
            font-family: var(--font-family);
            font-weight: 800;
            color: var(--color-ink);
        }

        .q__racha-barra {
            height: 18px;
            padding: 3px;
            background-color: var(--color-white);
            border: 2.5px solid var(--color-ink);
            border-radius: var(--radius-full);
            box-shadow: 0 3px 0 var(--color-ink);
        }

        .q__racha-relleno {
            width: var(--ancho);
            height: 100%;
            background-color: #f59e0b;
            border-radius: var(--radius-full);
            animation: llenar 0.6s ease-out;
        }

        @keyframes llenar {
            from {
                width: 0;
            }
        }

        /* Cartel animado de puntos (+1, bono) */
        .efecto {
            position: fixed;
            top: 35%;
            left: 50%;
            z-index: 10;
            pointer-events: none;
            font-family: var(--font-display);
            font-size: 2.5rem;
            font-weight: 700;
            animation: subir 1.4s ease-out forwards;
        }

        .efecto--correcta {
            color: #16a34a;
        }

        .efecto--bono {
            color: #f59e0b;
        }

        @keyframes subir {
            0% {
                opacity: 0;
                transform: translate(-50%, 20px) scale(0.6);
            }
            20% {
                opacity: 1;
                transform: translate(-50%, 0) scale(1.2);
            }
            100% {
                opacity: 0;
                transform: translate(-50%, -80px) scale(1);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .q__question,
            .q__option,
            .q__cat,
            .q__star,
            .game__mascot,
            .q__racha-relleno,
            .efecto {
                animation: none;
            }

            .q__exit,
            .q__option,
            #rendirse-modal .rep-modal__btn {
                transition: none;
            }
        }
    </style>
</head>
<body style="--cat: {{categoria_color}};">

<main class="q">

    {{> headerPartida}}

    <section class="q__body">

        <h1 class="q__question" id="pregunta">{{pregunta_texto}}</h1>

        <!-- Enviar a responder para procesar la opción elegida -->
        <form id="form-respuesta" method="post" action="{{base_url}}/pregunta/responder">
            <input type="hidden" name="pregunta_id" value="{{pregunta_id}}" />
            <input type="hidden" name="tiempo_agotado" id="tiempo-agotado" value="0" />

            <div class="q__options" role="group" aria-labelledby="pregunta">
                {{#respuestas}}
                    <button type="submit" class="q__option" name="respuesta_id" value="{{id}}">
                        <span class="q__letter">{{letra}}</span>
                        <span class="q__text">{{texto}}</span>
                    </button>
                {{/respuestas}}
            </div>
        </form>

        <div class="q__racha">
            <p class="q__racha-texto">Racha: {{racha}} de {{racha_total}} para el bono</p>
            <div class="q__racha-barra">
                <div class="q__racha-relleno" style="--ancho: {{racha_porcentaje}}%;"></div>
            </div>
        </div>

    </section>

    {{> footerPartida}}

</main>

<!-- Modal de rendición -->
<div class="rep-modal" id="rendirse-modal" hidden>
    <div class="rep-modal__card" role="dialog" aria-modal="true" aria-labelledby="rendirse-titulo">
        <h2 class="rep-modal__title" id="rendirse-titulo">¿Estás seguro de que querés rendirte?</h2>
        <p class="rep-modal__text">Si te rendís, la partida termina con <strong>0 puntos</strong>, sin importar cuántos hayas sumado.</p>

        <form method="post" action="{{base_url}}/pregunta/rendirse">
            <div class="rep-modal__actions">
                <button type="button" class="rep-modal__btn rep-modal__btn--secondary" id="rendirse-cancelar">Seguir jugando</button>
                <button type="submit" class="rep-modal__btn rep-modal__btn--primary">Sí, rendirme</button>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        const timer = document.getElementById('timer');
        const fill = document.getElementById('timer-fill');
        const segundos = document.getElementById('timer-seconds');
        const form = document.getElementById('form-respuesta');
        const agotado = document.getElementById('tiempo-agotado');

        const total = Number(timer.dataset.total) || 10;
        let restante = Number(timer.dataset.restante) || 10;

        function actualizar() {
            const visible = Math.max(restante, 0);
            segundos.textContent = visible;
            fill.style.width = ((visible / total) * 100) + '%';
            timer.classList.toggle('is-low', restante <= 5);
        }

        function tiempoAgotado() {
            agotado.value = '1';
            form.submit();
        }

        actualizar();

        const reloj = setInterval(function () {
            restante -= 1;
            actualizar();

            if (restante <= 0) {
                clearInterval(reloj);
                tiempoAgotado();
            }
        }, 1000);
    })();
</script>
<script>
    // Modal de rendición: el botón "Rendirse" del encabezado lo abre
    (function () {
        const modal = document.getElementById('rendirse-modal');
        const btnAbrir = document.getElementById('btn-rendirse');
        const btnCancelar = document.getElementById('rendirse-cancelar');

        function cerrar() {
            modal.hidden = true;
        }

        btnAbrir.addEventListener('click', function () {
            modal.hidden = false;
            btnCancelar.focus();
        });

        btnCancelar.addEventListener('click', cerrar);

        modal.addEventListener('click', function (e) {
            if (e.target === modal) cerrar();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !modal.hidden) cerrar();
        });
    })();
</script>
{{#sonido}}
    <audio src="{{base_url}}/public/sounds/{{sonido}}.wav" autoplay></audio>
{{/sonido}}
{{#efecto}}
    <div class="efecto efecto--{{clase}}">{{texto}}</div>
{{/efecto}}
</body>
</html>