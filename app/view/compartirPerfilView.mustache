<style>
    body {
        background-color: var(--color-cream, #fff8e8);
    }

    .cp,
    .cp *,
    .cp *::before,
    .cp *::after {
        box-sizing: border-box;
    }

    .cp {
        --cp-ink: var(--color-ink, #0f172a);
        --cp-primary: var(--color-primary, #0284c7);
        --cp-sky: var(--color-sky-soft, #bfe6fb);

        width: min(100% - 2rem, 520px);
        margin: 2rem auto 2.5rem;
        padding: clamp(1.35rem, 4vw, 2rem);
        color: var(--cp-ink);
        font-family: var(--font-text, "Nunito", "Outfit", system-ui, sans-serif);
        background-color: var(--color-white, #ffffff);
        border: 3px solid var(--cp-ink);
        border-radius: 1.75rem;
        box-shadow: 0 8px 0 var(--cp-ink);
        animation: cp-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    .cp__top {
        display: flex;
        align-items: center;
    }

    .cp__back {
        display: inline-grid;
        place-items: center;
        width: 44px;
        height: 44px;
        color: var(--cp-ink);
        background-color: var(--color-white, #ffffff);
        border: 2px solid var(--cp-ink);
        border-radius: 9999px;
        box-shadow: 0 3px 0 var(--cp-ink);
        text-decoration: none;
        transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease;
    }

    .cp__back:hover {
        background-color: var(--cp-sky);
        transform: translateY(-2px);
        box-shadow: 0 5px 0 var(--cp-ink);
    }

    .cp__back:active {
        transform: translateY(3px);
        box-shadow: 0 0 0 var(--cp-ink);
    }

    .cp__back:focus-visible {
        outline: 3px solid var(--cp-primary);
        outline-offset: 3px;
    }

    .cp__panel {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        padding: 1.25rem 0.5rem 0.75rem;
    }

    .cp__title {
        margin: 0;
        color: var(--cp-ink);
        font-family: var(--font-display, "Fredoka", "Outfit", system-ui, sans-serif);
        font-size: clamp(1.55rem, 5vw, 2rem);
        font-weight: 700;
        line-height: 1.15;
        text-align: center;
    }

    .cp__qr {
        display: block;
        width: min(68vw, 260px);
        height: auto;
        padding: 0.85rem;
        background-color: #fffdf8;
        border: 3px solid var(--cp-ink);
        border-radius: 1.35rem;
        box-shadow: 0 5px 0 var(--cp-ink);
    }

    @keyframes cp-pop {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(12px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .cp {
            animation: none;
        }

        .cp__back {
            transition: none;
        }
    }
</style>

<main class="cp">
    <div class="cp__top">
        <a href="{{base_url}}/perfil/show" class="cp__back" aria-label="Volver al perfil">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6" />
            </svg>
        </a>
    </div>
    {{#urlQr}}
        <section class="cp__panel">
            <h1 class="cp__title">¡Compartí tu perfil <br>con otros jugadores!</h1>
            <img class="cp__qr" src="{{urlQr}}" alt="Código QR de mi perfil">
        </section>
    {{/urlQr}}
</main>