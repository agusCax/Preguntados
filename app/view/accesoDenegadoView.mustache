<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cerebrito | Acceso denegado</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Nunito:wght@600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --color-primary: #0284c7;
            --color-primary-dark: #0369a1;
            --color-error: #ef4444;
            --color-error-dark: #b91c1c;
            --color-ink: #0f172a;
            --color-ink-soft: #334155;
            --color-white: #ffffff;

            --font-family: "Outfit", system-ui, sans-serif;
            --font-display: "Fredoka", "Outfit", system-ui, sans-serif;
            --font-text: "Nunito", "Outfit", system-ui, sans-serif;

            --space-sm: 0.5rem;
            --space-md: 1rem;
            --space-lg: 1.5rem;
            --space-xl: 2.25rem;
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            min-height: 100dvh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: var(--space-lg) var(--space-md) calc(var(--space-xl) + env(safe-area-inset-bottom, 0px));
            color: var(--color-ink);
            font-family: var(--font-text);
            /* mismo fondo que la pantalla de resultado */
            background: linear-gradient(135deg, #e0f2fe 0%, #e0f2fe 55%, #fff4dc 100%);
        }

        /* ---------- Tarjeta (nivel 2: diálogo con la mascota) ---------- */
        .denied {
            position: relative;
            width: 100%;
            max-width: 440px;
            margin-top: 4.5rem;
            padding: 4rem var(--space-lg) var(--space-xl);
            text-align: center;
            background-color: var(--color-white);
            border: 2px solid var(--color-ink);
            border-radius: 2rem;
            box-shadow: 0 20px 30px -8px rgba(2, 132, 199, 0.18);
            animation: denied-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
        }

        /* La mascota asoma por encima del borde superior */
        .denied__mascot {
            position: absolute;
            top: -4.5rem;
            left: 50%;
            width: 112px;
            height: 112px;
            object-fit: contain;
            transform: translateX(-50%);
            animation: denied-float 3s ease-in-out infinite;
        }

        /* ---------- Chip de categoría (error) ---------- */
        .denied__chip {
            display: inline-block;
            padding: 0.3rem 0.9rem;
            font-family: var(--font-family);
            font-size: 11px;
            line-height: 14px;
            font-weight: 700;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            color: var(--color-error-dark);
            background-color: rgba(239, 68, 68, 0.12);
            border: 2px solid var(--color-error);
            border-radius: 9999px;
        }

        .denied__title {
            margin: var(--space-md) 0 var(--space-sm);
            font-family: var(--font-display);
            font-size: 32px;
            line-height: 38px;
            font-weight: 700;
            color: var(--color-ink);
        }

        .denied__text {
            margin: 0 0 var(--space-lg);
            font-size: 18px;
            line-height: 26px;
            font-weight: 700;
            color: var(--color-ink-soft);
        }

        /* ---------- Botón táctil primario ---------- */
        .denied__btn {
            display: inline-block;
            min-width: 200px;
            padding: 0.9rem 2rem;
            font-family: var(--font-family);
            font-size: 16px;
            line-height: 20px;
            font-weight: 700;
            color: var(--color-white);
            text-decoration: none;
            background-color: var(--color-primary);
            border-radius: 9999px;
            box-shadow: 0 4px 0 var(--color-primary-dark);
            transition: filter 0.15s ease, transform 0.1s ease, box-shadow 0.1s ease;
        }

        .denied__btn:hover {
            filter: brightness(1.05);
        }

        .denied__btn:active {
            transform: translateY(4px);
            box-shadow: 0 0 0 transparent;
        }

        .denied__btn:focus-visible {
            outline: none;
            box-shadow: 0 4px 0 var(--color-primary-dark), 0 0 0 4px rgba(2, 132, 199, 0.2);
        }

        /* ---------- Animaciones ---------- */
        @keyframes denied-pop {
            from { opacity: 0; transform: scale(0.92) translateY(16px); }
            to   { opacity: 1; transform: scale(1) translateY(0); }
        }

        @keyframes denied-float {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50%      { transform: translateX(-50%) translateY(-6px); }
        }

        @media (prefers-reduced-motion: reduce) {
            .denied,
            .denied__mascot {
                animation: none;
            }
        }
    </style>
</head>
<body>
    <main class="denied">
        <img class="denied__mascot" src="{{base_url}}/public/img/imagenPreguntadosLogo.png" alt="" />

        <span class="denied__chip">Error 403</span>
        <h1 class="denied__title">Acceso denegado</h1>
        <p class="denied__text">No tenés permisos para ver esta página.</p>

        <a href="{{base_url}}/inicio/show" class="denied__btn">Volver al inicio</a>
    </main>
</body>
</html>
