<style>
    .sugerir-page {
        min-height: 100vh;
        padding: 2rem 1rem 3rem;
        background-color: var(--color-cream, #fff8e8);
        display: flex;
        justify-content: center;
        align-items: flex-start;
    }

    .sugerir-card {
        width: 100%;
        max-width: 680px;
        padding: 2rem;
        background: var(--color-white, #ffffff);
        border: 3px solid var(--color-ink, #0f172a);
        border-radius: 1.5rem;
        box-shadow: 0 8px 0 var(--color-ink, #0f172a);
    }

    .sugerir-header {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .btn-volver {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 44px;
        height: 44px;
        background: var(--color-white, #ffffff);
        border: 2.5px solid var(--color-ink, #0f172a);
        border-radius: 9999px;
        box-shadow: 0 3px 0 var(--color-ink, #0f172a);
        color: var(--color-ink, #0f172a);
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.4rem;
        font-weight: 700;
        text-decoration: none;
        transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease;
    }

    .btn-volver:hover {
        background: var(--color-sky-soft, #bfe6fb);
        transform: translateY(-2px);
        box-shadow: 0 5px 0 var(--color-ink, #0f172a);
    }

    .btn-volver:active {
        transform: translateY(3px);
        box-shadow: 0 0 0 var(--color-ink, #0f172a);
    }

    .sugerir-titulo {
        margin: 0;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.75rem;
        font-weight: 700;
        line-height: 1.15;
        color: var(--color-ink, #0f172a);
    }

    .sugerir-subtitulo {
        margin: 0.3rem 0 0;
        font-family: var(--font-text, "Nunito", system-ui, sans-serif);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-ink-soft, #334155);
    }

    /* =========================================
       ESTILOS UNIFICADOS CON formPreguntaView
    ========================================= */

    .form-grupo {
        margin-bottom: 1.25rem;
    }

    .form-grupo label,
    .form-label {
        display: block;
        margin-bottom: 0.45rem;
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        color: var(--color-ink, #0f172a);
        font-weight: 800;
        font-size: 0.95rem;
    }

    .form-control {
        width: 100%;
        min-height: 48px;
        padding: 0.75rem 0.95rem;
        box-sizing: border-box;
        background: var(--color-white, #ffffff);
        border: 2.5px solid var(--color-ink, #0f172a);
        border-radius: 0.95rem;
        box-shadow: 0 3px 0 var(--color-ink, #0f172a);
        color: var(--color-ink, #0f172a);
        font-family: var(--font-text, "Nunito", system-ui, sans-serif);
        font-size: 0.98rem;
        font-weight: 700;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--color-primary, #0284c7);
        box-shadow: 0 3px 0 var(--color-primary, #0284c7);
    }

    textarea.form-control {
        min-height: 112px;
        resize: vertical;
    }

    select.form-control {
        cursor: pointer;
    }

    .respuestas-titulo {
        margin: 1.6rem 0 0.35rem;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--color-ink, #0f172a);
    }

    .respuestas-ayuda {
        margin: 0 0 1rem;
        color: var(--color-ink-soft, #334155);
        font-size: 0.9rem;
        font-weight: 700;
        line-height: 1.5;
    }

    .respuesta-item {
        padding: 1.1rem;
        margin-bottom: 1rem;
        background: #fffdf8;
        border: 2.5px solid var(--color-ink, #0f172a);
        border-radius: 1.25rem;
        box-shadow: 0 4px 0 var(--color-ink, #0f172a);
        transition: background-color 0.15s ease;
    }

    .respuesta-item:has(input[type="radio"]:checked) {
        background: #f0fdf4;
    }

    .respuesta-cabecera {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 0.65rem;
    }

    .respuesta-letra {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.75rem;
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 0.85rem;
        font-weight: 800;
        color: var(--color-ink, #0f172a);
        background: var(--color-sky-soft, #bfe6fb);
        border: 2px solid var(--color-ink, #0f172a);
        border-radius: 9999px;
    }

    .respuesta-item label[for^="respuesta-"] {
        display: block;
        margin-bottom: 0.4rem;
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 0.88rem;
        font-weight: 800;
        color: var(--color-ink-soft, #334155);
    }

    .respuesta-correcta {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        width: fit-content;
        min-height: 36px;
        padding: 0.3rem 0.9rem;
        margin-top: 0.85rem;
        background: var(--color-white, #ffffff);
        color: var(--color-ink, #0f172a);
        border: 2px solid var(--color-ink, #0f172a);
        border-radius: 9999px;
        box-shadow: 0 2px 0 var(--color-ink, #0f172a);
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 0.86rem;
        font-weight: 800;
        cursor: pointer;
        transition: background-color 0.15s ease, transform 0.1s ease, box-shadow 0.1s ease;
    }

    .respuesta-correcta:hover {
        background: var(--color-sky-soft, #bfe6fb);
    }

    .respuesta-correcta:has(input:checked) {
        background: var(--color-success, #4ade80);
        color: var(--color-ink, #0f172a);
    }

    .respuesta-correcta input {
        width: 17px;
        height: 17px;
        margin: 0;
        accent-color: var(--color-ink, #0f172a);
        cursor: pointer;
    }

    .btn-guardar {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        min-height: 48px;
        padding: 0.7rem 1.5rem;
        background: var(--color-primary, #0284c7);
        color: var(--color-white, #ffffff);
        border: 3px solid var(--color-ink, #0f172a);
        border-radius: 9999px;
        box-shadow: 0 5px 0 var(--color-ink, #0f172a);
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 1rem;
        font-weight: 800;
        cursor: pointer;
        transition: transform 0.1s ease, box-shadow 0.1s ease, filter 0.15s ease;
    }

    .btn-guardar:hover {
        filter: brightness(1.05);
        transform: translateY(-2px);
        box-shadow: 0 7px 0 var(--color-ink, #0f172a);
    }

    .btn-guardar:active {
        transform: translateY(5px);
        box-shadow: 0 0 0 var(--color-ink, #0f172a);
    }

    @media (min-width: 768px) {
        .btn-guardar {
            width: auto;
            min-width: 200px;
        }
    }
</style>

<main class="sugerir-page">
    <section class="sugerir-card">
        <header class="sugerir-header">
            <a href="{{base_url}}/inicio/show" class="btn-volver" aria-label="Volver">‹</a>
            <div>
                <h1 class="sugerir-titulo">¡Sumá tu pregunta!</h1>
                <p class="sugerir-subtitulo">Proponé una pregunta nueva para que sea revisada y sumada al juego.</p>
            </div>
        </header>

        <!-- Ajustá el action y los atributos name si tu controlador de sugerencias usa otros nombres -->
        <form action="{{base_url}}/pregunta/sugerir" method="POST">
            <div class="form-grupo">
                <label for="pregunta_texto">Pregunta</label>
                <textarea
                        class="form-control"
                        id="pregunta_texto"
                        name="pregunta_texto"
                        required
                ></textarea>
            </div>

            <h3 class="respuestas-titulo">Opciones de respuesta</h3>
            <p class="respuestas-ayuda">
                Completá las cuatro opciones y marcá cuál es la correcta.
            </p>

            <div class="respuesta-item">
                <div class="respuesta-cabecera">
                    <span class="respuesta-letra">Opción A</span>
                </div>
                <label for="respuesta-0">Texto de la respuesta</label>
                <input type="text" class="form-control" id="respuesta-0" name="respuestas[0][texto]" required>
                <label class="respuesta-correcta">
                    <input type="radio" name="respuesta_correcta" value="0" required>
                    Es la respuesta correcta
                </label>
            </div>

            <div class="respuesta-item">
                <div class="respuesta-cabecera">
                    <span class="respuesta-letra">Opción B</span>
                </div>
                <label for="respuesta-1">Texto de la respuesta</label>
                <input type="text" class="form-control" id="respuesta-1" name="respuestas[1][texto]" required>
                <label class="respuesta-correcta">
                    <input type="radio" name="respuesta_correcta" value="1" required>
                    Es la respuesta correcta
                </label>
            </div>

            <div class="respuesta-item">
                <div class="respuesta-cabecera">
                    <span class="respuesta-letra">Opción C</span>
                </div>
                <label for="respuesta-2">Texto de la respuesta</label>
                <input type="text" class="form-control" id="respuesta-2" name="respuestas[2][texto]" required>
                <label class="respuesta-correcta">
                    <input type="radio" name="respuesta_correcta" value="2" required>
                    Es la respuesta correcta
                </label>
            </div>

            <div class="respuesta-item">
                <div class="respuesta-cabecera">
                    <span class="respuesta-letra">Opción D</span>
                </div>
                <label for="respuesta-3">Texto de la respuesta</label>
                <input type="text" class="form-control" id="respuesta-3" name="respuestas[3][texto]" required>
                <label class="respuesta-correcta">
                    <input type="radio" name="respuesta_correcta" value="3" required>
                    Es la respuesta correcta
                </label>
            </div>

            <div class="form-grupo">
                <label for="categoria_id">Categoría</label>
                <select class="form-control" id="categoria_id" name="categoria_id" required>
                    <option value="" disabled selected>Seleccioná una categoría</option>
                    {{#categorias}}
                        <option value="{{id}}">{{icono}} {{nombre}}</option>
                    {{/categorias}}
                </select>
            </div>

            <button type="submit" class="btn-guardar">Enviar pregunta</button>
        </form>
    </section>
</main>