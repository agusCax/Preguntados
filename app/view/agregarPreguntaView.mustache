<style>
    .agregar-pregunta,
    .agregar-pregunta *,
    .agregar-pregunta *::before,
    .agregar-pregunta *::after {
        box-sizing: border-box;
    }

    .agregar-pregunta {
        --agregar-pregunta-ink: var(--color-ink, #0f172a);
        --agregar-pregunta-muted: #64748b;
        --agregar-pregunta-border: var(--color-border, #e2e8f0);

        width: min(100% - 2rem, 680px);
        margin: 2rem auto;
        padding: clamp(1.25rem, 4vw, 2rem);
        color: var(--agregar-pregunta-ink);
        font-family: var(--font-text, "Nunito", system-ui, sans-serif);
        background: var(--color-white, #ffffff);
        border: 1px solid var(--agregar-pregunta-border);
        border-radius: 1.5rem;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.07);
    }

    .agregar-pregunta__header {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .agregar-pregunta__back {
        display: grid;
        flex: 0 0 44px;
        place-items: center;
        width: 44px;
        height: 44px;
        color: var(--agregar-pregunta-ink);
        border-radius: 50%;
        text-decoration: none;
    }

    .agregar-pregunta__back:hover {
        background: #f1f5f9;
    }

    .agregar-pregunta__title {
        margin: 0;
        font-family: var(--font-family, "Outfit", system-ui, sans-serif);
        font-size: clamp(1.5rem, 5vw, 2rem);
        line-height: 1.2;
    }

    .agregar-pregunta__intro {
        margin: 0.4rem 0 0;
        color: var(--agregar-pregunta-muted);
        line-height: 1.5;
    }

    .agregar-pregunta__fields {
        display: grid;
        gap: 1.25rem;
    }

    .agregar-pregunta__field {
        display: grid;
        gap: 0.45rem;
    }

    .agregar-pregunta__category {
        display: grid;
        gap: 0.45rem;
        margin-top: 0.35rem;
    }

    .agregar-pregunta__label,
    .agregar-pregunta__category-label,
    .agregar-pregunta__legend {
        font-weight: 800;
    }

    .agregar-pregunta__input {
        width: 100%;
        min-height: 48px;
        padding: 0.75rem 0.9rem;
        color: var(--agregar-pregunta-ink);
        font: inherit;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 0.75rem;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .agregar-pregunta__input:focus-visible,
    .agregar-pregunta__check:focus-visible {
        outline: 3px solid rgba(2, 132, 199, 0.28);
        outline-offset: 2px;
    }

    .agregar-pregunta__input:focus {
        border-color: var(--color-primary, #0284c7);
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.12);
    }

    .agregar-pregunta__input--question {
        min-height: 112px;
        resize: vertical;
    }

    .agregar-pregunta__category select {
        cursor: pointer;
    }

    .agregar-pregunta__category-selection {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .agregar-pregunta__category-select {
        flex: 1;
        min-width: 0;
    }

    .agregar-pregunta__category-badge {
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        gap: 7px;
        max-width: 100%;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 0.82rem;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .agregar-pregunta__category-badge[hidden] {
        display: none;
    }

    .agregar-pregunta__answers {
        display: grid;
        gap: 0.9rem;
        margin: 0;
        padding: 0;
        border: 0;
    }

    .agregar-pregunta__legend {
        margin-bottom: 0.15rem;
        font-size: 1.1rem;
    }

    .agregar-pregunta__answer {
        display: grid;
        gap: 0.8rem;
        padding: 1rem;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
    }

    .agregar-pregunta__answer:focus-within {
        border-color: #94a3b8;
    }

    .agregar-pregunta__answer-label {
        font-weight: 800;
        color: #475569;
    }

    .agregar-pregunta__correct {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        width: fit-content;
        min-height: 32px;
        color: #64748b;
        font-family: inherit;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        margin-left: auto;
        flex-direction: row-reverse;
    }

    .agregar-pregunta__correct--selected {
        color: var(--color-primary-dark, #0369a1);
    }

    .agregar-pregunta__check {
        width: 18px;
        height: 18px;
        margin: 0;
        accent-color: var(--color-primary, #0284c7);
        cursor: pointer;
    }

    .agregar-pregunta__actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        margin-top: 1.5rem;
        justify-content: center
    }

    .agregar-pregunta__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0.65rem 1.2rem;
        font: inherit;
        font-weight: 800;
        border: 0;
        border-radius: 9999px;
        cursor: pointer;
        text-decoration: none;
    }

    .agregar-pregunta__button--cancel {
        color: var(--agregar-pregunta-ink);
        background: #f1f5f9;
    }

    .agregar-pregunta__button--submit {
        color: #ffffff;
        background: var(--color-primary, #0284c7);
        box-shadow: 0 3px 0 var(--color-primary-dark, #0369a1);
    }

    .agregar-pregunta__button--submit:hover {
        background: var(--color-primary-dark, #0369a1);
    }

    .agregar-pregunta__back:focus-visible,
    .agregar-pregunta__button:focus-visible {
        outline: 3px solid rgba(2, 132, 199, 0.4);
        outline-offset: 3px;
    }

    @media (max-width: 480px) {
        .agregar-pregunta__actions {
            flex-direction: column-reverse;
        }

        .agregar-pregunta__button {
            width: 100%;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .agregar-pregunta__input {
            transition: none;
        }
    }
</style>

<main class="agregar-pregunta">
    <header class="agregar-pregunta__header">
        <a href="{{base_url}}/inicio/show" class="agregar-pregunta__back" aria-label="Volver al inicio">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6" />
            </svg>
        </a>
        <div>
            <h1 class="agregar-pregunta__title">¡Sumá tu pregunta!</h1>
            <p class="agregar-pregunta__intro">Completá la pregunta y sus cuatro respuestas. Marcá cuál es la correcta.</p>
        </div>
    </header>

    <form class="agregar-pregunta__form" id="agregar-pregunta-form" action="{{base_url}}/pregunta/agregar" method="post">
        <div class="agregar-pregunta__fields">
            <div class="agregar-pregunta__field">
                <label class="agregar-pregunta__label" for="agregar-pregunta-question">Pregunta</label>
                <textarea class="agregar-pregunta__input agregar-pregunta__input--question" id="agregar-pregunta-question" name="pregunta" maxlength="500" required></textarea>
            </div>

            <fieldset class="agregar-pregunta__answers">

                <div class="agregar-pregunta__answer">
                    <label class="agregar-pregunta__answer-label" for="agregar-pregunta-answer-1">Respuesta 1</label>
                    <input class="agregar-pregunta__input" type="text" id="agregar-pregunta-answer-1" name="respuestas[]" maxlength="255" required>
                    <label class="agregar-pregunta__correct" for="agregar-pregunta-correct-1">
                        <input class="agregar-pregunta__check" type="checkbox" id="agregar-pregunta-correct-1" name="respuesta_correcta" value="1" checked>
                        Es la respuesta correcta
                    </label>
                </div>

                <div class="agregar-pregunta__answer">
                    <label class="agregar-pregunta__answer-label" for="agregar-pregunta-answer-2">Respuesta 2</label>
                    <input class="agregar-pregunta__input" type="text" id="agregar-pregunta-answer-2" name="respuestas[]" maxlength="255" required>
                    <label class="agregar-pregunta__correct" for="agregar-pregunta-correct-2">
                        <input class="agregar-pregunta__check" type="checkbox" id="agregar-pregunta-correct-2" name="respuesta_correcta" value="2">
                        Es la respuesta correcta
                    </label>
                </div>

                <div class="agregar-pregunta__answer">
                    <label class="agregar-pregunta__answer-label" for="agregar-pregunta-answer-3">Respuesta 3</label>
                    <input class="agregar-pregunta__input" type="text" id="agregar-pregunta-answer-3" name="respuestas[]" maxlength="255" required>
                    <label class="agregar-pregunta__correct" for="agregar-pregunta-correct-3">
                        <input class="agregar-pregunta__check" type="checkbox" id="agregar-pregunta-correct-3" name="respuesta_correcta" value="3">
                        Es la respuesta correcta
                    </label>
                </div>

                <div class="agregar-pregunta__answer">
                    <label class="agregar-pregunta__answer-label" for="agregar-pregunta-answer-4">Respuesta 4</label>
                    <input class="agregar-pregunta__input" type="text" id="agregar-pregunta-answer-4" name="respuestas[]" maxlength="255" required>
                    <label class="agregar-pregunta__correct" for="agregar-pregunta-correct-4">
                        <input class="agregar-pregunta__check" type="checkbox" id="agregar-pregunta-correct-4" name="respuesta_correcta" value="4">
                        Es la respuesta correcta
                    </label>
                </div>

                <div class="agregar-pregunta__category">
                    <label class="agregar-pregunta__category-label" for="agregar-pregunta-categoria">Categoría</label>
                    <div class="agregar-pregunta__category-selection">
                        <select class="agregar-pregunta__input agregar-pregunta__category-select" id="agregar-pregunta-categoria" name="categoria" required>
                            <option value="">Seleccionar categoría</option>
                            <option value="Ciencia" data-icon="🔬" data-color="#10b981" name="categoria" value="Ciencia">🔬 Ciencia</option>
                            <option value="Historia" data-icon="🏛️" data-color="#f59e0b" name="categoria" value="Historia">🏛️ Historia</option>
                            <option value="Geografía" data-icon="🌎" data-color="#0ea5e9" name="categoria" value="Geografía">🌎 Geografía</option>
                            <option value="Arte" data-icon="🎨" data-color="#ec4899" name="categoria" value="Arte">🎨 Arte</option>
                            <option value="Deportes" data-icon="⚽" data-color="#ef4444" name="categoria" value="Deportes">⚽ Deportes</option>
                            <option value="Cine" data-icon="🎬" data-color="#8b5cf6" name="categoria" value="Cine">🎬 Cine</option>
                        </select>
                        <span class="agregar-pregunta__category-badge" id="agregar-pregunta-category-badge" hidden aria-hidden="true">
                            <span id="agregar-pregunta-category-icon"></span>
                            <span id="agregar-pregunta-category-name"></span>
                        </span>
                    </div>
                </div>
            </fieldset>
        </div>

        <div class="agregar-pregunta__actions">
            <a class="agregar-pregunta__button agregar-pregunta__button--cancel" href="{{base_url}}/inicio/show">Cancelar</a>
            <button class="agregar-pregunta__button agregar-pregunta__button--submit" type="submit">Enviar</button>
        </div>
    </form>
</main>

<script>
    (function () {
        var form = document.getElementById('agregar-pregunta-form');
        var correctas = form.querySelectorAll('input[name="respuesta_correcta"]');
        var categoria = document.getElementById('agregar-pregunta-categoria');
        var categoriaBadge = document.getElementById('agregar-pregunta-category-badge');
        var categoriaIcon = document.getElementById('agregar-pregunta-category-icon');
        var categoriaNombre = document.getElementById('agregar-pregunta-category-name');

        function actualizarCategoria() {
            var opcion = categoria.options[categoria.selectedIndex];

            if (!opcion.value) {
                categoriaBadge.hidden = true;
                return;
            }

            categoriaIcon.textContent = opcion.dataset.icon;
            categoriaNombre.textContent = opcion.value;
            categoriaBadge.style.color = opcion.dataset.color;
            categoriaBadge.style.backgroundColor = opcion.dataset.color + '30';
            categoriaBadge.hidden = false;
        }

        categoria.addEventListener('change', actualizarCategoria);
        actualizarCategoria();

        function actualizarSeleccion(checkbox) {
            checkbox.closest('.agregar-pregunta__correct')
                .classList.toggle('agregar-pregunta__correct--selected', checkbox.checked);
        }

        correctas.forEach(function (checkbox) {
            actualizarSeleccion(checkbox);
            checkbox.addEventListener('change', function () {
                if (!checkbox.checked) {
                    checkbox.checked = true;
                } else {
                    correctas.forEach(function (otra) {
                        if (otra !== checkbox) {
                            otra.checked = false;
                        }
                    });
                }

                correctas.forEach(actualizarSeleccion);
            });
        });
    })();
</script>
