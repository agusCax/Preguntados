<style>
    /* Fondo suave de las pantallas con sesión (igual que el mockup) */
    body {
        background-color: var(--color-canvas, #f8fafc);
    }

    .ini,
    .ini *,
    .ini *::before,
    .ini *::after {
        box-sizing: border-box;
    }

    .ini {
        --ini-pad: 1rem;

        max-width: 960px;
        margin: 0 auto;
        padding: 1.5rem var(--ini-pad) 0;
        font-family: var(--font-text, "Nunito", system-ui, sans-serif);
        color: var(--color-ink, #0f172a);
    }

    /* ---------- Tarjeta: Crear partida ---------- */
    .ini__hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 1.25rem;
        background-color: #e0f2fe;
        border-radius: 1.75rem;
    }

    .ini__hero-title {
        margin: 0;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.6rem;
        line-height: 1.15;
        font-weight: 700;
        color: var(--color-primary-dark, #0369a1);
    }

    .ini__hero-text {
        margin: 0.25rem 0 1rem;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--color-ink-soft, #334155);
    }

    .ini__play {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 1.75rem;
        font-family: var(--font-family, "Outfit", system-ui, sans-serif);
        font-size: 1rem;
        font-weight: 700;
        text-decoration: none;
        color: #ffffff;
        background-color: var(--color-primary, #0284c7);
        border-radius: 9999px;
        box-shadow: 0 4px 0 var(--color-primary-dark, #0369a1);
        transition: transform 0.1s ease, box-shadow 0.1s ease, filter 0.15s ease;
    }

    .ini__play:hover {
        filter: brightness(1.05);
    }

    .ini__play:active {
        transform: translateY(4px);
        box-shadow: 0 0 0 transparent;
    }

    .ini__play:focus-visible {
        outline: 3px solid rgba(2, 132, 199, 0.4);
        outline-offset: 3px;
    }

    .ini__hero-img {
        display: block;
        flex-shrink: 0;
        width: clamp(96px, 34%, 150px);
        height: auto;
        filter: drop-shadow(0 8px 16px rgba(11, 91, 220, 0.15));
    }

    /* ---------- Usuarios (sección de prueba, viene de la base) ---------- */
    .ini__section {
        margin-top: 2rem;
    }

    .ini__section-title {
        margin: 0 0 0.25rem;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.25rem;
        font-weight: 700;
    }

    .ini__section-text {
        margin: 0 0 1rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: #64748b;
    }

    .ini__users {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .ini__user {
        display: inline-flex;
        align-items: center;
        min-height: 40px;
        padding: 0 1rem;
        font-weight: 700;
        color: var(--color-ink, #0f172a);
        background-color: #ffffff;
        border: 1px solid var(--color-border, #e2e8f0);
        border-radius: 9999px;
    }

    @media (prefers-reduced-motion: reduce) {
        .ini__play {
            transition: none;
        }
    }

    /* ---------- Tablet (≥ 768px) ---------- */
    @media (min-width: 768px) {
        .ini {
            --ini-pad: 1.5rem;
            padding-top: 2rem;
        }

        .ini__hero {
            gap: 1.5rem;
            padding: 2rem 2.5rem;
        }

        .ini__hero-title {
            font-size: 2.4rem;
        }

        .ini__hero-text {
            margin-bottom: 1.5rem;
            font-size: 1.1rem;
        }

        .ini__play {
            min-height: 56px;
            padding: 0 2.5rem;
            font-size: 1.1rem;
        }

        .ini__hero-img {
            width: 200px;
        }
    }

    /* ---------- Desktop (≥ 1024px) ---------- */
    @media (min-width: 1024px) {
        .ini {
            --ini-pad: 2.5rem;
            padding-top: 2.5rem;
        }

        .ini__hero-title {
            font-size: 2.75rem;
        }

        .ini__hero-img {
            width: 240px;
        }
    }
</style>

<div class="ini">

    <section class="ini__hero" aria-labelledby="ini-partida">
        <div class="ini__hero-body">
            <h1 class="ini__hero-title" id="ini-partida">Crear partida</h1>
            <p class="ini__hero-text">Respondé y sumá puntos</p>
            <a href="{{base_url}}/partida/show" class="ini__play">Jugar</a>
        </div>
        <img class="ini__hero-img" src="{{base_url}}/public/img/imagenPreguntadosLogo.png" alt="" />
    </section>


    <section class="ini__section" aria-labelledby="ini-usuarios">
        <h2 class="ini__section-title" id="ini-usuarios">Jugadores registrados</h2>
        <p class="ini__section-text">Usuarios recuperados de la base de datos.</p>
        <ul class="ini__users">
            {{#usuarios}}
            <li class="ini__user">{{nombre_usuario}}</li>
            {{/usuarios}}
        </ul>
    </section>

</div>
