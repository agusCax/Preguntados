<style>
    body {
        background-color: var(--color-cream, #fff8e8);
    }

    .ep,
    .ep *,
    .ep *::before,
    .ep *::after {
        box-sizing: border-box;
    }

    /* =========================================================
       EDITAR PERFIL (Cerebrito Cartoon)
       ========================================================= */
    .ep {
        --ep-ink: var(--color-ink, #0f172a);
        --ep-muted: var(--color-ink-soft, #334155);
        --ep-primary: var(--color-primary, #0284c7);
        --ep-sky: var(--color-sky-soft, #bfe6fb);
        --ep-sun: var(--color-sun, #fcd34d);

        width: min(100% - 2rem, 560px);
        margin: 2rem auto 2.75rem;
        font-family: var(--font-text, "Nunito", "Outfit", system-ui, sans-serif);
        color: var(--ep-ink);
        background-color: var(--color-white, #ffffff);
        border: 3px solid var(--ep-ink);
        border-radius: 1.75rem;
        box-shadow: 0 8px 0 var(--ep-ink);
        overflow: hidden;
        animation: ep-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    .ep a:focus-visible,
    .ep button:focus-visible,
    .ep input:focus-visible,
    .ep textarea:focus-visible {
        outline: 3px solid var(--ep-primary);
        outline-offset: 2px;
    }

    /* ---------- Barra superior: volver + Guardar ---------- */
    .ep__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.9rem 1.25rem;
        background-color: #fffdf8;
        border-bottom: 2.5px solid var(--ep-ink);
    }

    .ep__back {
        display: inline-grid;
        place-items: center;
        width: 44px;
        height: 44px;
        color: var(--ep-ink);
        background-color: var(--color-white, #ffffff);
        border: 2px solid var(--ep-ink);
        border-radius: 9999px;
        box-shadow: 0 3px 0 var(--ep-ink);
        text-decoration: none;
        transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease;
    }

    .ep__back:hover {
        background-color: var(--ep-sky);
        transform: translateY(-2px);
        box-shadow: 0 5px 0 var(--ep-ink);
    }

    .ep__back:active {
        transform: translateY(3px);
        box-shadow: 0 0 0 var(--ep-ink);
    }

    .ep__save {
        min-height: 44px;
        padding: 0 1.35rem;
        font-family: var(--font-ui, "Outfit", system-ui, sans-serif);
        font-size: 1rem;
        font-weight: 800;
        color: var(--color-white, #ffffff);
        background-color: var(--ep-primary);
        border: 2.5px solid var(--ep-ink);
        border-radius: 9999px;
        box-shadow: 0 4px 0 var(--ep-ink);
        cursor: pointer;
        transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease, filter 0.15s ease;
    }

    .ep__save:hover:not(:disabled) {
        filter: brightness(1.05);
        transform: translateY(-2px);
        box-shadow: 0 6px 0 var(--ep-ink);
    }

    .ep__save:active:not(:disabled) {
        transform: translateY(4px);
        box-shadow: 0 0 0 var(--ep-ink);
    }

    /* Sin cambios todavía */
    .ep__save:disabled {
        color: #64748b;
        background-color: #e2e8f0;
        border-color: #94a3b8;
        box-shadow: none;
        cursor: not-allowed;
    }

    /* ---------- Portada + avatar ---------- */
    .ep__media {
        position: relative;
        margin-bottom: 3.4rem;
    }

    .ep__cover {
        display: grid;
        place-items: center;
        height: 120px;
        background-color: var(--ep-sky);
        border-bottom: 3px solid var(--ep-ink);
    }

    .ep__cover-btn,
    .ep__avatar-btn {
        display: grid;
        place-items: center;
        padding: 0;
        cursor: pointer;
    }

    .ep__avatar-foto {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .ep__cover-btn {
        width: 46px;
        height: 46px;
        color: var(--ep-ink);
        background-color: var(--color-white, #ffffff);
        border: 2.5px solid var(--ep-ink);
        border-radius: 50%;
        box-shadow: 0 3px 0 var(--ep-ink);
        transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease;
    }

    .ep__cover-btn:hover {
        background-color: var(--ep-sun);
        transform: translateY(-2px);
        box-shadow: 0 5px 0 var(--ep-ink);
    }

    .ep__avatar {
        position: absolute;
        left: 1.25rem;
        bottom: -44px;
        width: 92px;
        height: 92px;
        background-color: var(--ep-sun);
        border: 3px solid var(--ep-ink);
        border-radius: 50%;
        box-shadow: 0 4px 0 var(--ep-ink);
        overflow: hidden;
    }

    .ep__avatar-letter {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        font-family: var(--font-display, "Fredoka", "Outfit", system-ui, sans-serif);
        font-size: 2.6rem;
        font-weight: 700;
        color: var(--ep-ink);
    }

    .ep__avatar-btn {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        color: var(--color-white, #ffffff);
        background-color: rgba(15, 23, 42, 0.38);
        border: 0;
        border-radius: 50%;
        transition: background-color 0.15s ease;
    }

    .ep__avatar-btn:hover {
        background-color: rgba(15, 23, 42, 0.52);
    }

    /* ---------- Campos ---------- */
    .ep__fields {
        display: grid;
        gap: 1.1rem;
        padding: 0 1.25rem 1.75rem;
    }

    .ep__field {
        position: relative;
        display: grid;
        gap: 0.4rem;
    }

    .ep__label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
    }

    .ep__label {
        font-family: var(--font-ui, "Outfit", system-ui, sans-serif);
        font-size: 0.98rem;
        font-weight: 800;
        color: var(--ep-ink);
    }

    .ep__input {
        display: block;
        width: 100%;
        min-height: 48px;
        padding: 0.65rem 0.9rem;
        font-family: var(--font-text, "Nunito", system-ui, sans-serif);
        font-size: 1.05rem;
        font-weight: 700;
        line-height: 1.35;
        color: var(--ep-ink);
        background-color: var(--color-white, #ffffff);
        border: 2.5px solid var(--ep-ink);
        border-radius: 0.95rem;
        box-shadow: 0 3px 0 var(--ep-ink);
        -webkit-appearance: none;
        appearance: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .ep__input:focus {
        border-color: var(--ep-primary);
        box-shadow: 0 3px 0 var(--ep-primary);
    }

    .ep__input::placeholder {
        color: #94a3b8;
        font-weight: 600;
    }

    /* Bio: área de varias líneas */
    .ep__input--area {
        min-height: 5.5rem;
        resize: vertical;
    }

    /* Email | Nombre: se muestra pero no se edita */
    .ep__input[readonly] {
        color: #64748b;
        background-color: #f1f5f9;
        border-color: #94a3b8;
        box-shadow: none;
        cursor: not-allowed;
    }

    .ep__count {
        font-family: var(--font-ui, "Outfit", system-ui, sans-serif);
        font-size: 0.85rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        color: var(--ep-muted);
    }

    @keyframes ep-pop {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(12px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .ep {
            animation: none;
        }

        .ep__back,
        .ep__save,
        .ep__input,
        .ep__cover-btn,
        .ep__avatar-btn {
            transition: none;
        }
    }

    @media (min-width: 768px) {
        .ep__cover {
            height: 132px;
        }

        .ep__avatar {
            left: 1.5rem;
        }

        .ep__fields {
            padding: 0 1.5rem 2rem;
        }
    }
</style>

<main class="ep">
    <form action="{{base_url}}/perfil/actualizar" method="POST" id="ep-form" novalidate>

        <!-- Barra superior -->
        <div class="ep__top">
            <a href="{{base_url}}/perfil/show" class="ep__back" aria-label="Volver al perfil">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="15 18 9 12 15 6" />
                </svg>
            </a>
            <button type="submit" class="ep__save" id="ep-save">Guardar</button>
        </div>

        <!-- Portada y avatar -->
        <div class="ep__media">
            <div class="ep__cover">
                <button type="button" class="ep__cover-btn" aria-label="Cambiar foto de portada">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                        <circle cx="12" cy="13" r="4" />
                    </svg>
                </button>
            </div>

            <div class="ep__avatar">
                {{#foto}}
                    <img class="ep__avatar-foto" src="{{base_url}}/{{foto}}" alt="">
                {{/foto}}
                {{^foto}}
                    <span class="ep__avatar-letter" aria-hidden="true">{{inicial}}</span>
                {{/foto}}
                <button type="button" class="ep__avatar-btn" aria-label="Cambiar foto de perfil">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                        <circle cx="12" cy="13" r="4" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Campos -->
        <div class="ep__fields">

            <div class="ep__field">
                <div class="ep__label-row">
                    <label class="ep__label" for="ep-nombre">Nombre Completo</label>
                    <span class="ep__count" data-count-for="ep-nombre" aria-hidden="true"></span>
                </div>
                <input class="ep__input" type="text" id="ep-nombre" name="nombre" value="{{nombre}}" maxlength="40" readonly autocomplete="name">
            </div>

            <div class="ep__field">
                <div class="ep__label-row">
                    <label class="ep__label" for="ep-usuario">Usuario</label>
                    <span class="ep__count" data-count-for="ep-usuario" aria-hidden="true"></span>
                </div>
                <input class="ep__input" type="text" id="ep-usuario" name="usuario" value="{{usuario}}" maxlength="16" autocomplete="username" autocapitalize="none" spellcheck="false">
            </div>

            <div class="ep__field ep__field--area">
                <div class="ep__label-row">
                    <label class="ep__label" for="ep-bio">Bio</label>
                    <span class="ep__count" data-count-for="ep-bio" aria-hidden="true"></span>
                </div>
                <textarea class="ep__input ep__input--area" id="ep-bio" name="bio" maxlength="80" rows="3">{{bio}}</textarea>
            </div>

            <div class="ep__field">
                <div class="ep__label-row">
                    <label class="ep__label" for="ep-email">Email</label>
                    <span class="ep__count" data-count-for="ep-email" aria-hidden="true"></span>
                </div>
                <input class="ep__input" type="email" id="ep-email" name="email" value="{{email}}" maxlength="80" readonly autocomplete="email">
            </div>

            <div class="ep__field">
                <div class="ep__label-row">
                    <label class="ep__label" for="ep-ubicacion">Ubicación</label>
                </div>
                <input class="ep__input" type="text" id="ep-ubicacion" name="ubicacion" value="{{ubicacion}}" autocomplete="country-name">
            </div>
        </div>

    </form>
</main>

<script>
    // Contadores de caracteres y "Guardar" activo solo si hubo cambios
    (function () {
        var form = document.getElementById('ep-form');
        var guardar = document.getElementById('ep-save');
        var campos = form.querySelectorAll('.ep__input');
        var iniciales = {};

        function actualizarContador(campo) {
            var contador = form.querySelector('[data-count-for="' + campo.id + '"]');
            if (contador) {
                contador.textContent = campo.value.length + ' / ' + campo.maxLength;
            }
        }

        function hayCambios() {
            for (var i = 0; i < campos.length; i++) {
                if (campos[i].value !== iniciales[campos[i].id]) {
                    return true;
                }
            }
            return false;
        }

        campos.forEach(function (campo) {
            iniciales[campo.id] = campo.value;
            actualizarContador(campo);

            campo.addEventListener('input', function () {
                actualizarContador(campo);
                guardar.disabled = !hayCambios();
            });
        });

        guardar.disabled = true;
    })();
</script>