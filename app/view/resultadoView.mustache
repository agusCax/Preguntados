<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cerebrito | Resultado de la partida</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Nunito:wght@600;700;800&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --color-ink: #0f172a;
            --color-ink-soft: #334155;
            --color-ink-muted: #475569;
            --color-cream: #fff8e8;
            --color-white: #ffffff;

            --color-primary: #0284c7;
            --color-primary-dark: #0369a1;
            --color-sky: #7dd3fc;
            --color-sky-soft: #bfe6fb;
            --color-sun: #fcd34d;
            --color-amber: #f59e0b;
            --color-violet: #7c3aed;
            --color-success: #4ade80;
            --color-success-dark: #15803d;
            --color-error: #f87171;
            --color-error-dark: #b91c1c;

            --color-tint-lila: #ddd6fe;
            --color-tint-amarillo: #fde68a;
            --color-tint-verde: #dcfce7;
            --color-tint-celeste: #e0f2fe;
            --color-tint-rojo: #fecaca;

            --font-display: "Fredoka", "Outfit", system-ui, sans-serif;
            --font-text: "Nunito", "Outfit", system-ui, sans-serif;
            --font-ui: "Outfit", system-ui, sans-serif;

            --radius-pill: 9999px;
            --radius-card-lg: 1.75rem;
            --radius-card-md: 1.25rem;
            --radius-blob: 58% 42% 55% 45% / 50% 56% 44% 50%;

            --border-edge: 3px solid var(--color-ink);
            --border-edge-small: 2px solid var(--color-ink);

            --shadow-card-hero: 0 8px 0 var(--color-ink);
            --shadow-card: 0 6px 0 var(--color-ink);
            --shadow-button: 0 5px 0 var(--color-ink);
            --shadow-control: 0 3px 0 var(--color-ink);

            --space-sm: 0.5rem;
            --space-md: 1rem;
            --space-lg: 1.5rem;
            --space-xl: 2.5rem;
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        body {
            position: relative;
            min-height: 100vh;
            min-height: 100dvh;
            margin: 0;
            padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom, 0px));
            color: var(--color-ink);
            font-family: var(--font-text);
            background-color: var(--color-cream);
            overflow-x: hidden;
        }

        /* ---------- Fondo decorativo cartoon ---------- */
        .bg {
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            overflow: hidden;
        }

        .bg__blob {
            position: absolute;
            border-radius: var(--radius-blob);
            opacity: 0.48;
            animation: bg-float 16s ease-in-out infinite;
        }

        .bg__blob--sky {
            width: 340px;
            height: 340px;
            bottom: -90px;
            left: -80px;
            background-color: var(--color-sky-soft);
        }

        .bg__blob--sun {
            width: 300px;
            height: 300px;
            top: 24%;
            right: -95px;
            background-color: var(--color-tint-amarillo);
            animation-delay: -5s;
        }

        .bg__blob--lila {
            width: 220px;
            height: 220px;
            top: 38%;
            left: 5%;
            background-color: var(--color-tint-lila);
            animation-delay: -10s;
        }

        .bg__star {
            position: absolute;
            color: var(--color-ink);
            opacity: 0.16;
        }

        .bg__star--1 {
            top: 36%;
            left: 12%;
        }

        .bg__star--2 {
            bottom: 16%;
            right: 16%;
        }

        .bg__zigzag {
            position: absolute;
            opacity: 0.22;
        }

        .bg__zigzag--1 {
            top: 34%;
            right: 11%;
            color: var(--color-violet);
        }

        .bg__zigzag--2 {
            bottom: 22%;
            left: 8%;
            color: var(--color-primary);
        }

        /* ---------- Banner superior (headerPartida) ---------- */
        .result__top {
            position: relative;
            min-height: 250px;
            padding: 1.15rem 1rem 4.75rem;
            background-color: var(--color-sky);
            border-bottom: var(--border-edge);
            border-radius: 0 0 2.5rem 2.5rem;
            box-shadow: var(--shadow-card);
        }

        .result--ganada {
            background-color: #f0fdf4;
        }

        .result--ganada .result__top {
            background-color: var(--color-success);
        }

        .result--ganada .result__title {
            color: var(--color-success-dark);
        }

        .result--perdida {
            background-color: #f0f9ff;
        }

        .result--perdida .result__top {
            background-color: var(--color-sky);
        }

        .result--perdida .result__title {
            color: var(--color-primary-dark);
        }

        .result--tiempo {
            background-color: #fef2f2;
        }

        .result--tiempo .result__top {
            background-color: var(--color-error);
        }

        .result--tiempo .result__title {
            color: var(--color-error-dark);
        }

        .result__top-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            max-width: 720px;
            margin: 0 auto;
        }

        .result__exit,
        .result__score {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            min-height: 44px;
            padding: 0 1.15rem;
            color: var(--color-ink);
            font-family: var(--font-ui);
            font-weight: 800;
            background-color: var(--color-white);
            border: var(--border-edge-small);
            border-radius: var(--radius-pill);
            box-shadow: var(--shadow-control);
        }

        .result__exit {
            text-decoration: none;
            transition: transform 0.1s ease, box-shadow 0.1s ease;
        }

        .result__exit:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 0 var(--color-ink);
        }

        .result__exit:active {
            transform: translateY(3px);
            box-shadow: 0 0 0 var(--color-ink);
        }

        .result__score {
            margin: 0;
            font-size: 1.1rem;
        }

        .result__star {
            font-size: 1.25rem;
        }

        /* ---------- Tarjeta principal de resultado ---------- */
        .result__content {
            position: relative;
            z-index: 1;
            display: grid;
            justify-items: center;
            gap: 0.9rem;
            width: min(100% - 2rem, 34rem);
            margin: -3.25rem auto 0;
            padding: 2rem 1.5rem 2.25rem;
            text-align: center;
            background-color: var(--color-white);
            border: var(--border-edge);
            border-radius: var(--radius-card-lg);
            box-shadow: var(--shadow-card-hero);
            animation: result-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
        }

        .result__trophy {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 88px;
            height: 88px;
            margin: 0 0 0.25rem;
            font-size: 2.85rem;
            line-height: 1;
            background-color: var(--color-sun);
            border: var(--border-edge);
            border-radius: var(--radius-blob);
            box-shadow: 0 4px 0 var(--color-ink);
            animation: trophy-float 3s ease-in-out infinite;
        }

        .result__title {
            margin: 0;
            font-family: var(--font-display);
            font-size: clamp(1.8rem, 6vw, 2.5rem);
            line-height: 1.12;
            font-weight: 700;
            color: var(--color-ink);
        }

        .result__message {
            margin: 0;
            font-family: var(--font-text);
            font-size: 1.05rem;
            line-height: 1.5;
            font-weight: 700;
            color: var(--color-ink-soft);
        }

        .result__message strong {
            color: var(--color-ink);
            font-weight: 800;
        }

        .result__points {
            display: inline-block;
            margin: 0.25rem 0 0;
            padding: 0.45rem 1.25rem;
            font-family: var(--font-ui);
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--color-ink);
            background-color: var(--color-tint-amarillo);
            border: var(--border-edge-small);
            border-radius: var(--radius-pill);
            box-shadow: var(--shadow-control);
        }

        .result__penalty {
            display: inline-block;
            margin: 0.15rem 0 0;
            padding: 0.4rem 1.1rem;
            font-family: var(--font-ui);
            font-size: 0.95rem;
            font-weight: 800;
            color: var(--color-error-dark);
            background-color: var(--color-tint-rojo);
            border: var(--border-edge-small);
            border-radius: var(--radius-pill);
            box-shadow: var(--shadow-control);
            animation: temblar 0.5s;
        }

        /* ---------- Bloque de respuesta correcta ---------- */
        .result__correct {
            width: 100%;
            margin-top: 0.25rem;
            padding: 1rem 1.15rem;
            text-align: center;
            background-color: var(--color-tint-verde);
            border: var(--border-edge-small);
            border-radius: var(--radius-card-md);
            box-shadow: 0 4px 0 var(--color-ink);
        }

        .result__correct-pregunta {
            margin: 0 0 0.45rem;
            color: var(--color-ink-soft);
            font-size: 0.92rem;
            font-weight: 700;
        }

        .result__correct-label {
            margin: 0;
            color: var(--color-success-dark);
            font-family: var(--font-ui);
            font-size: 0.82rem;
            font-weight: 800;
            letter-spacing: 0.03em;
            text-transform: uppercase;
        }

        .result__correct-texto {
            margin: 0.25rem 0 0;
            color: var(--color-ink);
            font-family: var(--font-display);
            font-size: 1.2rem;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        /* ---------- Botones de acción táctiles ---------- */
        .result__actions {
            display: grid;
            justify-items: center;
            gap: 0.85rem;
            width: 100%;
            margin-top: 0.5rem;
        }

        .result__actions form {
            display: contents;
        }

        .result__button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: min(100%, 19rem);
            min-height: 48px;
            padding: 0.7rem 1.5rem;
            font-family: var(--font-ui);
            font-size: 1.02rem;
            line-height: 1.2;
            font-weight: 800;
            color: var(--color-ink);
            text-align: center;
            text-decoration: none;
            background-color: var(--color-white);
            border: var(--border-edge);
            border-radius: var(--radius-pill);
            box-shadow: var(--shadow-button);
            cursor: pointer;
            transition: transform 0.1s ease, box-shadow 0.1s ease, filter 0.15s ease;
        }

        .result__button--play {
            color: var(--color-ink);
            background-color: var(--color-sun);
        }

        .result__button--home {
            color: var(--color-white);
            background-color: var(--color-primary);
        }

        .result--ganada .result__button--play {
            color: var(--color-ink);
            background-color: var(--color-success);
        }

        .result--ganada .result__button--home {
            color: var(--color-ink);
            background-color: var(--color-tint-verde);
        }

        .result--perdida .result__button--play {
            color: var(--color-ink);
            background-color: var(--color-sky);
        }

        .result--perdida .result__button--home {
            color: var(--color-ink);
            background-color: var(--color-tint-celeste);
        }

        .result--tiempo .result__button--play {
            color: var(--color-ink);
            background-color: var(--color-error);
        }

        .result--tiempo .result__button--home {
            color: var(--color-ink);
            background-color: var(--color-tint-rojo);
        }

        button.result__button.result__button--report {
            color: var(--color-ink-soft);
            background-color: var(--color-white);
            border: 3px dashed var(--color-ink);
        }

        button.result__button.result__button--report:hover {
            color: var(--color-error-dark);
            background-color: var(--color-tint-rojo);
        }

        .result__button:hover {
            filter: brightness(1.04);
            transform: translateY(-2px);
            box-shadow: 0 7px 0 var(--color-ink);
        }

        .result__button:active {
            transform: translateY(5px);
            box-shadow: 0 0 0 var(--color-ink);
        }

        .result__button:focus-visible,
        .result__exit:focus-visible,
        .rep-modal__btn:focus-visible,
        .rep-item__btn:focus-visible {
            outline: 3px solid var(--color-primary);
            outline-offset: 3px;
        }

        /* ---------- Mascota y footer (footerPartida) ---------- */
        .game__mascot {
            display: block;
            width: clamp(100px, 30vw, 145px);
            height: auto;
            margin: 1.75rem auto 1rem;
        }

        .game__footer {
            position: relative;
            z-index: 0;
        }

        /* ---------- Modales de reporte ---------- */
        .rep-modal {
            position: fixed;
            inset: 0;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            background-color: rgba(15, 23, 42, 0.55);
        }

        .rep-modal[hidden] {
            display: none;
        }

        .rep-modal__card {
            width: 100%;
            max-width: 480px;
            max-height: 90vh;
            overflow-y: auto;
            padding: 1.5rem;
            text-align: left;
            background-color: var(--color-white);
            border: var(--border-edge);
            border-radius: var(--radius-card-lg);
            box-shadow: var(--shadow-card-hero);
            animation: result-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both;
        }

        .rep-modal__title {
            margin: 0 0 0.45rem;
            font-family: var(--font-display);
            font-size: 1.45rem;
            font-weight: 700;
            color: var(--color-ink);
        }

        .rep-modal__text {
            margin: 0 0 1rem;
            font-weight: 700;
            color: var(--color-ink-soft);
            overflow-wrap: anywhere;
        }

        .rep-modal__label {
            display: block;
            margin: 0.85rem 0 0.35rem;
            font-family: var(--font-ui);
            font-size: 0.92rem;
            font-weight: 800;
            color: var(--color-ink);
        }

        .rep-modal__field {
            width: 100%;
            padding: 0.65rem 0.85rem;
            font-family: var(--font-text);
            font-size: 1rem;
            font-weight: 700;
            color: var(--color-ink);
            background-color: var(--color-white);
            border: var(--border-edge-small);
            border-radius: 0.85rem;
            box-shadow: var(--shadow-control);
        }

        .rep-modal__field:focus {
            outline: 3px solid var(--color-primary);
            outline-offset: 2px;
        }

        textarea.rep-modal__field {
            min-height: 90px;
            resize: vertical;
        }

        .rep-modal__msg {
            min-height: 1.4rem;
            margin: 0.75rem 0 0;
            font-size: 0.92rem;
            font-weight: 800;
            color: var(--color-error-dark);
        }

        .rep-modal__actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.65rem;
            justify-content: flex-end;
            margin-top: 1.15rem;
        }

        .rep-modal__btn {
            min-height: 44px;
            padding: 0 1.25rem;
            font-family: var(--font-ui);
            font-size: 0.95rem;
            font-weight: 800;
            color: var(--color-ink);
            background-color: var(--color-white);
            border: var(--border-edge-small);
            border-radius: var(--radius-pill);
            box-shadow: var(--shadow-control);
            cursor: pointer;
            transition: transform 0.1s ease, box-shadow 0.1s ease;
        }

        .rep-modal__btn--primary {
            color: var(--color-white);
            background-color: var(--color-primary);
        }

        .rep-modal__btn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 5px 0 var(--color-ink);
        }

        .rep-modal__btn:active:not(:disabled) {
            transform: translateY(3px);
            box-shadow: 0 0 0 var(--color-ink);
        }

        .rep-modal__btn:disabled {
            opacity: 0.55;
            cursor: default;
        }

        /* Listado de preguntas de la partida */
        .rep-lista {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .rep-item {
            display: grid;
            gap: 0.45rem;
            padding: 0.9rem 0;
            border-bottom: 2px solid #e2e8f0;
        }

        .rep-item:last-child {
            border-bottom: 0;
        }

        .rep-item__texto {
            margin: 0;
            font-weight: 800;
            color: var(--color-ink);
            overflow-wrap: anywhere;
        }

        .rep-item__correcta {
            margin: 0;
            color: var(--color-success-dark);
            font-size: 0.92rem;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .rep-item__btn {
            justify-self: start;
            min-height: 38px;
            padding: 0 1.1rem;
            font-family: var(--font-ui);
            font-size: 0.88rem;
            font-weight: 800;
            color: var(--color-error-dark);
            background-color: var(--color-tint-rojo);
            border: var(--border-edge-small);
            border-radius: var(--radius-pill);
            box-shadow: var(--shadow-control);
            cursor: pointer;
            transition: transform 0.1s ease, box-shadow 0.1s ease;
        }

        .rep-item__btn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 5px 0 var(--color-ink);
        }

        .rep-item__btn:active:not(:disabled) {
            transform: translateY(3px);
            box-shadow: 0 0 0 var(--color-ink);
        }

        .rep-item__btn:disabled {
            color: var(--color-ink-muted);
            background-color: #f1f5f9;
            border-color: #94a3b8;
            box-shadow: none;
            cursor: default;
        }

        /* ---------- Responsive ---------- */
        @media (min-width: 768px) {
            .result__top {
                min-height: 275px;
                padding: 1.5rem 1.5rem 5.5rem;
            }

            .result__content {
                margin-top: -3.85rem;
                padding: 2.35rem 2.25rem 2.5rem;
            }

            .game__mascot {
                position: fixed;
                right: 2vw;
                bottom: 1.5vh;
                z-index: 0;
                width: clamp(110px, 14vw, 200px);
                margin: 0;
                pointer-events: none;
            }
        }

        @media (max-width: 767px) {
            .bg__blob--lila,
            .bg__star--2,
            .bg__zigzag {
                display: none;
            }

            .bg__blob--sky {
                width: 240px;
                height: 240px;
            }

            .bg__blob--sun {
                width: 210px;
                height: 210px;
            }
        }

        /* ---------- Animaciones ---------- */
        @keyframes result-pop {
            from {
                opacity: 0;
                transform: scale(0.92) translateY(16px);
            }
            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        @keyframes trophy-float {
            0%, 100% {
                transform: translateY(0) rotate(-2deg);
            }
            50% {
                transform: translateY(-6px) rotate(2deg);
            }
        }

        @keyframes bg-float {
            0%, 100% {
                transform: translateY(0) rotate(0deg);
            }
            50% {
                transform: translateY(-14px) rotate(4deg);
            }
        }

        @keyframes temblar {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-8px); }
            75% { transform: translateX(8px); }
        }

        @media (prefers-reduced-motion: reduce) {
            .result__content,
            .result__trophy,
            .rep-modal__card,
            .bg__blob,
            .result__penalty {
                animation: none;
            }

            .result__button,
            .result__exit,
            .rep-modal__btn,
            .rep-item__btn {
                transition: none;
            }
        }

        @media print {
            body {
                background-color: var(--color-white);
            }

            .bg {
                display: none;
            }

            .result__top,
            .result__exit,
            .result__score,
            .result__content,
            .result__trophy,
            .result__points,
            .result__penalty,
            .result__correct,
            .result__button {
                box-shadow: none;
            }
        }
    </style>
</head>
<body class="result--{{resultado_tipo}}">
<div class="bg" aria-hidden="true">
    <div class="bg__blob bg__blob--sky"></div>
    <div class="bg__blob bg__blob--sun"></div>
    <div class="bg__blob bg__blob--lila"></div>

    <svg class="bg__star bg__star--1" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
        <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" />
    </svg>

    <svg class="bg__star bg__star--2" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
        <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" />
    </svg>

    <svg class="bg__zigzag bg__zigzag--1" width="76" height="18" viewBox="0 0 76 18" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="2,14 14,4 26,14 38,4 50,14 62,4 74,14" />
    </svg>

    <svg class="bg__zigzag bg__zigzag--2" width="68" height="16" viewBox="0 0 68 16" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="2,12 13,4 24,12 35,4 46,12 57,4 66,12" />
    </svg>
</div>

{{> headerPartida}}

<main class="result__content">
    {{#gano}}
        <p class="result__trophy" aria-hidden="true">🏆</p>
        <h1 class="result__title">{{resultado_titulo}}</h1>
        <p class="result__message">{{resultado_mensaje}}</p>
        <p class="result__message">Respuestas correctas: <strong>{{correctas}}</strong></p>
    {{/gano}}

    <p class="result__points">Puntaje {{#etapa}}actual{{/etapa}}{{^etapa}}obtenido{{/etapa}}: {{puntaje}}</p>

    {{#penalizacion_mensaje}}
        <p class="result__penalty">{{penalizacion_mensaje}}</p>
    {{/penalizacion_mensaje}}

    {{#respuesta_correcta_final}}
        <div class="result__correct">
            <p class="result__correct-pregunta">{{pregunta_final}}</p>
            <p class="result__correct-label">La respuesta correcta era:</p>
            <p class="result__correct-texto">{{respuesta_correcta_final}}</p>
        </div>
    {{/respuesta_correcta_final}}

    {{#etapa}}
        <div class="result__actions">
            <form method="post" action="{{base_url}}/pregunta/retirarse">
                <button type="submit" class="result__button result__button--play">Retirarme y ganar</button>
            </form>
            <form method="post" action="{{base_url}}/pregunta/seguir">
                <button type="submit" class="result__button result__button--home">Seguir jugando</button>
            </form>
        </div>
    {{/etapa}}

    {{^etapa}}
        <nav class="result__actions" aria-label="Opciones de partida">
            <a class="result__button result__button--play" href="{{base_url}}/pregunta/show">Jugar otra partida</a>
            {{#hay_preguntas}}
                <button type="button" class="result__button result__button--report" id="btn-abrir-reportes">Reportar una pregunta</button>
            {{/hay_preguntas}}
            <a class="result__button result__button--home" href="{{base_url}}/inicio/show">Volver al inicio</a>
        </nav>
    {{/etapa}}
</main>

{{> footerPartida}}

{{#hay_preguntas}}
    <!-- 1) Listado de las preguntas de la partida -->
    <div class="rep-modal" id="rep-lista-modal" hidden>
        <div class="rep-modal__card" role="dialog" aria-modal="true" aria-labelledby="rep-lista-titulo">
            <h2 class="rep-modal__title" id="rep-lista-titulo">Reportar una pregunta</h2>
            <p class="rep-modal__text">Estas son las preguntas de tu partida. Elegí la que querés reportar.</p>

            <ul class="rep-lista">
                {{#preguntas_partida}}
                    <li class="rep-item">
                        <p class="rep-item__texto">{{numero}}. {{texto}}</p>
                        <p class="rep-item__correcta">Respuesta correcta: {{respuesta_correcta}}</p>
                        {{#puede_reportar}}
                            <button type="button" class="rep-item__btn" data-pregunta-id="{{id}}" data-texto="{{texto}}">Reportar</button>
                        {{/puede_reportar}}
                        {{^puede_reportar}}
                            <button type="button" class="rep-item__btn" disabled>{{etiqueta_no_reportar}}</button>
                        {{/puede_reportar}}
                    </li>
                {{/preguntas_partida}}
            </ul>

            <div class="rep-modal__actions">
                <button type="button" class="rep-modal__btn" id="rep-lista-cerrar">Cerrar</button>
            </div>
        </div>
    </div>

    <!-- 2) Formulario de reporte de la pregunta elegida (se envía por fetch a /pregunta/reportar) -->
    <div class="rep-modal" id="rep-form-modal" hidden>
        <div class="rep-modal__card" role="dialog" aria-modal="true" aria-labelledby="rep-titulo">
            <h2 class="rep-modal__title" id="rep-titulo">Reportar pregunta</h2>
            <p class="rep-modal__text" id="rep-pregunta-texto"></p>

            <form id="form-reporte" method="post" action="{{base_url}}/pregunta/reportar">
                <input type="hidden" name="pregunta_id" id="rep-pregunta-id" value="">

                <label class="rep-modal__label" for="rep-motivo">Motivo</label>
                <select class="rep-modal__field" id="rep-motivo" name="motivo" required>
                    <option value="" disabled selected>Elegí un motivo</option>
                    {{#motivos_reporte}}
                        <option value="{{.}}">{{.}}</option>
                    {{/motivos_reporte}}
                </select>

                <label class="rep-modal__label" for="rep-descripcion">Descripción (opcional)</label>
                <textarea class="rep-modal__field" id="rep-descripcion" name="descripcion" maxlength="500"></textarea>

                <p class="rep-modal__msg" id="rep-mensaje" role="status"></p>

                <div class="rep-modal__actions">
                    <button type="button" class="rep-modal__btn" id="rep-cancelar">Cancelar</button>
                    <button type="submit" class="rep-modal__btn rep-modal__btn--primary" id="rep-enviar">Enviar reporte</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 3) Después de reportar: ¿otro reporte? -->
    <div class="rep-modal" id="rep-otro-modal" hidden>
        <div class="rep-modal__card" role="dialog" aria-modal="true" aria-labelledby="rep-otro-titulo">
            <h2 class="rep-modal__title" id="rep-otro-titulo">¡Reporte enviado!</h2>
            <p class="rep-modal__text" id="rep-otro-texto">¿Querés realizar otro reporte?</p>

            <div class="rep-modal__actions">
                <button type="button" class="rep-modal__btn" id="rep-otro-no">No, gracias</button>
                <button type="button" class="rep-modal__btn rep-modal__btn--primary" id="rep-otro-si">Sí, reportar otra</button>
            </div>
        </div>
    </div>

    <script>
        // La validación real está en PreguntaController::reportar()
        (function () {
            var modalLista = document.getElementById('rep-lista-modal');
            var modalForm = document.getElementById('rep-form-modal');
            var modalOtro = document.getElementById('rep-otro-modal');
            var form = document.getElementById('form-reporte');
            var campoPregunta = document.getElementById('rep-pregunta-id');
            var textoPregunta = document.getElementById('rep-pregunta-texto');
            var mensaje = document.getElementById('rep-mensaje');
            var btnEnviar = document.getElementById('rep-enviar');
            var textoOtro = document.getElementById('rep-otro-texto');
            var btnOtroSi = document.getElementById('rep-otro-si');
            var botonElegido = null;

            function mostrar(modal) { modal.hidden = false; }
            function ocultar(modal) { modal.hidden = true; }

            function cerrarTodo() {
                ocultar(modalLista);
                ocultar(modalForm);
                ocultar(modalOtro);
            }

            // Botón "Reportar una pregunta" de la pantalla
            document.getElementById('btn-abrir-reportes').addEventListener('click', function () {
                mostrar(modalLista);
            });

            document.getElementById('rep-lista-cerrar').addEventListener('click', cerrarTodo);

            // Se elige una pregunta del listado: se abre el formulario
            modalLista.addEventListener('click', function (e) {
                if (e.target === modalLista) {
                    cerrarTodo();
                    return;
                }

                var boton = e.target.closest('[data-pregunta-id]');
                if (!boton || boton.disabled) {
                    return;
                }

                botonElegido = boton;
                form.reset();
                campoPregunta.value = boton.dataset.preguntaId;
                textoPregunta.textContent = boton.dataset.texto;   // textContent: nunca interpreta HTML
                mensaje.textContent = '';
                btnEnviar.disabled = false;

                ocultar(modalLista);
                mostrar(modalForm);
                form.elements.motivo.focus();
            });

            // Cancelar vuelve al listado
            document.getElementById('rep-cancelar').addEventListener('click', function () {
                ocultar(modalForm);
                mostrar(modalLista);
            });

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                btnEnviar.disabled = true;   // evita doble envío
                mensaje.textContent = 'Enviando...';

                try {
                    var respuesta = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form)
                    });
                    var datos = await respuesta.json();

                    // fetch NO falla con 400/403/409: hay que mirar respuesta.ok
                    if (respuesta.ok && datos.exito) {
                        botonElegido.disabled = true;
                        botonElegido.textContent = 'Reportada';

                        var quedan = modalLista.querySelectorAll('[data-pregunta-id]:not(:disabled)').length > 0;
                        textoOtro.textContent = quedan
                                ? '¿Querés realizar otro reporte?'
                                : 'Ya reportaste todas las preguntas disponibles de esta partida.';
                        btnOtroSi.hidden = !quedan;

                        ocultar(modalForm);
                        mostrar(modalOtro);
                    } else {
                        mensaje.textContent = datos.mensaje || 'No se pudo enviar el reporte.';
                        btnEnviar.disabled = false;
                    }
                } catch (error) {
                    // sin conexión, o el servidor devolvió algo que no es JSON
                    mensaje.textContent = 'No se pudo enviar el reporte. Intentá de nuevo.';
                    btnEnviar.disabled = false;
                }
            });

            btnOtroSi.addEventListener('click', function () {
                ocultar(modalOtro);
                mostrar(modalLista);
            });

            document.getElementById('rep-otro-no').addEventListener('click', cerrarTodo);

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    cerrarTodo();
                }
            });
        })();
    </script>
{{/hay_preguntas}}

{{#sonido}}
    <audio src="{{base_url}}/public/sounds/{{sonido}}.wav" autoplay></audio>
{{/sonido}}
</body>
</html>