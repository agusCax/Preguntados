<style>
    body {
        background-color: var(--color-cream, #fff8e8);
    }

    .editor-resultado {
        --er-ink: var(--color-ink, #0f172a);
        --er-primary: var(--color-primary, #0284c7);
        --er-sky: var(--color-sky-soft, #bfe6fb);
        --er-amber: var(--color-amber, #f59e0b);

        width: 100%;
        max-width: 600px;
        margin: 2rem auto 3rem;
        padding: 1.75rem 1.4rem;
        background-color: var(--color-white, #ffffff);
        border: 3px solid var(--er-ink);
        border-radius: 1.75rem;
        box-shadow: 0 8px 0 var(--er-ink);
        font-family: var(--font-text, "Nunito", system-ui, sans-serif);
        color: var(--er-ink);
        box-sizing: border-box;
    }

    .mensaje-exito,
    .mensaje-error {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        box-sizing: border-box;
        padding: 1rem 1.15rem;
        margin-bottom: 1.5rem;
        border: 2.5px solid var(--er-ink);
        border-radius: 1.25rem;
        box-shadow: 0 4px 0 var(--er-ink);
        color: var(--er-ink);
        font-weight: 700;
    }

    .mensaje-exito {
        background: #bbf7d0;
    }

    .mensaje-error {
        background: #fecaca;
    }

    .mensaje-exito-icono,
    .mensaje-error-icono {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        background: var(--color-white, #ffffff);
        border: 2px solid var(--er-ink);
        border-radius: 50%;
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-weight: 800;
    }

    .mensaje-exito p,
    .mensaje-error p {
        margin: 0;
        font-size: 0.98rem;
        line-height: 1.45;
    }

    .editor-resultado__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        justify-content: center;
    }

    .editor-resultado__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 1.4rem;
        border: 3px solid var(--er-ink);
        border-radius: 9999px;
        box-shadow: 0 5px 0 var(--er-ink);
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 0.96rem;
        font-weight: 800;
        color: var(--er-ink);
        text-decoration: none;
        transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease;
    }

    .editor-resultado__button--primary {
        background: var(--er-amber);
    }

    .editor-resultado__button--primary:hover {
        filter: brightness(1.04);
        transform: translateY(-2px);
        box-shadow: 0 7px 0 var(--er-ink);
    }

    .editor-resultado__button--secondary {
        background: var(--color-white, #ffffff);
    }

    .editor-resultado__button--secondary:hover {
        background: var(--er-sky);
        transform: translateY(-2px);
        box-shadow: 0 7px 0 var(--er-ink);
    }

    .editor-resultado__button:active {
        transform: translateY(5px);
        box-shadow: 0 0 0 var(--er-ink);
    }

    .editor-resultado__button:focus-visible {
        outline: 3px solid var(--er-primary);
        outline-offset: 3px;
    }
</style>

<main class="editor-resultado">
    {{#confirmacion}}
        <div class="mensaje-exito">
            <span class="mensaje-exito-icono">✓</span>
            <p>{{mensaje}}</p>
        </div>
    {{/confirmacion}}

    {{^confirmacion}}
        <div class="mensaje-error">
            <span class="mensaje-error-icono">!</span>
            <p>{{mensaje}}</p>
        </div>
    {{/confirmacion}}

    <nav class="editor-resultado__actions" aria-label="Volver al panel">
        <a class="editor-resultado__button editor-resultado__button--primary" href="{{volverUrl}}">Volver al listado</a>
        <a class="editor-resultado__button editor-resultado__button--secondary" href="{{base_url}}/editor/show">Volver al inicio</a>
    </nav>
</main>