<style>
    /* =========================================
    CONTENEDOR GENERAL
    ========================================= */

    body {
        background-color: var(--color-cream, #fff8e8);
    }

    .moderacion-container {
        --mod-ink: var(--color-ink, #0f172a);
        --mod-muted: var(--color-ink-soft, #334155);
        --mod-primary: var(--color-primary, #0284c7);
        --mod-sky: var(--color-sky-soft, #bfe6fb);
        --mod-sun: var(--color-sun, #fcd34d);
        --mod-amber: var(--color-amber, #f59e0b);

        width: 100%;
        max-width: 1100px;
        margin-inline: auto;
        padding: 1.5rem 1rem 2.5rem;
        font-family: var(--font-text, "Nunito", system-ui, sans-serif);
        color: var(--mod-ink);
        box-sizing: border-box;
    }

    @media (max-width: 499px) {
        .moderacion-container {
            max-width: 100%;
            margin-left: auto;
            margin-right: auto;
        }
    }

    /* Encabezado */
    .editor__hero {
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        background-color: var(--mod-sky);
        border: 3px solid var(--mod-ink);
        border-radius: 1.75rem;
        box-shadow: 0 8px 0 var(--mod-ink);
    }

    .editor__title {
        margin: 0 0 0.45rem;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.85rem;
        font-weight: 700;
        color: var(--mod-ink);
    }

    .editor__description {
        margin: 0;
        font-size: 0.98rem;
        font-weight: 700;
        line-height: 1.5;
        color: var(--mod-muted);
    }

    /* Encabezado con acción: texto a la izquierda, botón a la derecha */
    .editor__hero--accion {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1.1rem;
    }

    .editor__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 100%;
        min-height: 50px;
        padding: 0 1.4rem;
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 0.98rem;
        font-weight: 800;
        text-decoration: none;
        text-align: center;
        color: var(--mod-ink);
        background-color: var(--mod-amber);
        border: 3px solid var(--mod-ink);
        border-radius: 9999px;
        box-shadow: 0 5px 0 var(--mod-ink);
        transition: transform 0.1s ease, box-shadow 0.1s ease, filter 0.15s ease;
    }

    .editor__button:hover {
        filter: brightness(1.04);
        transform: translateY(-2px);
        box-shadow: 0 7px 0 var(--mod-ink);
    }

    .editor__button:active {
        transform: translateY(5px);
        box-shadow: 0 0 0 var(--mod-ink);
    }

    .editor__button:focus-visible {
        outline: 3px solid var(--mod-primary);
        outline-offset: 3px;
    }

    @media (prefers-reduced-motion: reduce) {
        .editor__button {
            transition: none;
        }
    }

    /* =========================================
    LISTADO MOBILE
    ========================================= */

    .tabla-container {
        width: 100%;
    }

    .tabla-moderacion {
        display: block;
        width: 100%;
        max-width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .tabla-moderacion thead {
        display: none;
    }

    .tabla-moderacion tbody {
        display: block;
        width: 100%;
    }

    .tabla-moderacion tr {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;

        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        margin-bottom: 1rem;
        padding: 1.25rem 1rem;

        background: var(--color-white, #ffffff);
        border: 2.5px solid var(--mod-ink);
        border-radius: 1.35rem;
        box-shadow: 0 5px 0 var(--mod-ink);

        cursor: pointer;
        text-align: center;

        transition: background-color 0.15s ease, transform 0.1s ease;
    }

    .tabla-moderacion td {
        display: block;
        width: 100%;
        min-width: 0;
        padding: 0;
        border: none;
        box-sizing: border-box;
    }

    /* =========================================
    CATEGORÍA
    ========================================= */

    .categoria-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;

        max-width: 100%;
        padding: 0.38rem 0.85rem;

        border: 2px solid var(--mod-ink);
        border-radius: 9999px;
        box-shadow: 0 2px 0 var(--mod-ink);
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 0.84rem;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    /* =========================================
    PREGUNTA Y MOTIVO
    ========================================= */

    .pregunta-texto {
        width: 100%;
        color: var(--mod-ink);
        font-size: 0.96rem;
        font-weight: 700;
        line-height: 1.5;

        white-space: normal;
        overflow-wrap: anywhere;
        text-align: center;
    }

    .motivo-texto {
        color: var(--mod-muted);
        font-size: 0.88rem;
        font-weight: 700;
        line-height: 1.4;

        white-space: normal;
        overflow-wrap: anywhere;
        text-align: center;
    }

    .motivo-texto::before {
        content: "Motivo: ";
        font-weight: 800;
        color: var(--mod-ink);
    }

    /* =========================================
    ESTADO PREGUNTA
    ========================================= */

    .pregunta-estado {
        width: 100%;
        color: var(--mod-muted);
        font-size: 0.92rem;
        font-weight: 800;
        line-height: 1.5;

        white-space: normal;
        overflow-wrap: anywhere;
    }

    /* =========================================
    BOTÓN VER
    ========================================= */

    .btn-ver {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        min-width: 104px;
        min-height: 42px;
        padding: 0.45rem 1.25rem;

        border: 2.5px solid var(--mod-ink);
        border-radius: 9999px;
        box-shadow: 0 3px 0 var(--mod-ink);
        text-decoration: none;
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-weight: 800;
        font-size: 0.9rem;
        color: var(--mod-ink);

        transition: transform 0.1s ease, box-shadow 0.1s ease, filter 0.15s ease;
    }

    .btn-sugerencia {
        background: var(--mod-sky);
    }

    .btn-reporte {
        background: var(--mod-sun);
    }

    .btn-ver:active {
        transform: translateY(3px);
        box-shadow: 0 0 0 var(--mod-ink);
    }

    /* =========================================
    PAGINACIÓN
    ========================================= */

    .paginacion {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 1.5rem;
    }

    .paginacion__link {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        min-width: 42px;
        min-height: 42px;
        padding: 0 0.9rem;

        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 0.9rem;
        font-weight: 800;
        text-decoration: none;
        color: var(--mod-ink);

        background: var(--color-white, #ffffff);
        border: 2px solid var(--mod-ink);
        border-radius: 9999px;
        box-shadow: 0 3px 0 var(--mod-ink);
        transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease;
    }

    .paginacion__link:hover {
        background: var(--mod-sky);
        transform: translateY(-2px);
        box-shadow: 0 5px 0 var(--mod-ink);
    }

    .paginacion__link:active {
        transform: translateY(3px);
        box-shadow: 0 0 0 var(--mod-ink);
    }

    .paginacion__link.is-actual {
        background: var(--mod-sun);
    }

    .paginacion__info {
        margin: 0.9rem 0 0;
        text-align: center;
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--mod-muted);
    }

    /* =========================================
    ESTADO VACÍO
    ========================================= */

    .sin-resultados {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        width: 100%;
        min-height: 190px;
        box-sizing: border-box;
        padding: 2rem 1.25rem;

        text-align: center;
        color: var(--mod-muted);
        font-weight: 700;

        background: var(--color-white, #ffffff);
        border: 3px solid var(--mod-ink);
        border-radius: 1.75rem;
        box-shadow: 0 8px 0 var(--mod-ink);
    }

    .sin-resultados span {
        font-size: 2.2rem;
        margin-bottom: 0.65rem;
    }

    .sin-resultados p {
        margin: 0;
        line-height: 1.5;
    }

    /* =========================================
    TABLET: 768px EN ADELANTE
    ========================================= */

    @media (min-width: 768px) {

        .moderacion-container {
            padding: 2rem 1.5rem 2.75rem;
        }

        .tabla-container {
            overflow-x: auto;
            background: var(--color-white, #ffffff);
            border: 3px solid var(--mod-ink);
            border-radius: 1.75rem;
            box-shadow: 0 8px 0 var(--mod-ink);
        }

        .tabla-moderacion {
            display: table;
            max-width: none;
            border-collapse: collapse;
            border-spacing: 0;
        }

        .tabla-moderacion thead {
            display: table-header-group;
        }

        .tabla-moderacion tbody {
            display: table-row-group;
        }

        .tabla-moderacion tr {
            display: table-row;
            max-width: none;
            margin-bottom: 0;
            padding: 0;
            background: transparent;
            border: none;
            border-radius: 0;
            box-shadow: none;
            text-align: left;
        }

        .tabla-moderacion tbody tr:hover {
            background-color: #fffdf8;
        }

        .tabla-moderacion td {
            display: table-cell;
            width: auto;
            padding: 1rem 1.25rem;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        .tabla-moderacion th {
            padding: 1rem 1.25rem;
            text-align: left;
            background: #f8fafc;
            color: var(--mod-ink);
            font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
            font-size: 0.88rem;
            font-weight: 800;
            border-bottom: 1px solid #e2e8f0;
        }

        .tabla-moderacion tbody tr:last-child td {
            border-bottom: none;
        }

        .pregunta-texto,
        .motivo-texto {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            text-align: left;
        }

        .pregunta-texto {
            max-width: 450px;
        }

        .motivo-texto {
            max-width: 220px;
        }

        .motivo-texto::before {
            content: none;
        }

        .btn-ver:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 0 var(--mod-ink);
            filter: brightness(1.03);
        }

        .editor__hero {
            padding: 2rem 2.5rem;
        }

        .editor__title {
            font-size: 2.35rem;
        }

        .editor__description {
            font-size: 1.05rem;
        }

        .editor__hero--accion {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
        }

        .editor__button {
            width: auto;
            min-width: 190px;
            font-size: 1rem;
        }

        .tabla-moderacion th.col-accion,
        .tabla-moderacion td.col-accion {
            text-align: center;
        }
    }

    /* =========================================
    ESCRITORIO: 1024px EN ADELANTE
    ========================================= */

    @media (min-width: 1024px) {

        .tabla-moderacion th,
        .tabla-moderacion td {
            padding: 1.1rem 1.4rem;
        }
    }
</style>

<main class="moderacion-container">

    <!-- Encabezado -->
    <section class="editor__hero editor__hero--accion">
        <div>
            <h1 class="editor__title">Banco de preguntas</h1>

            <p class="editor__description">
                Visualizá la totalidad de preguntas y sus detalles.
            </p>
        </div>

        <a href="{{urlNueva}}" class="editor__button">
            Nueva pregunta
        </a>
    </section>

    {{#hayPreguntas}}

        <div class="tabla-container">
            <table class="tabla-moderacion">

                <thead>
                <tr>
                    <th>Categoría</th>
                    <th>Pregunta</th>

                    {{#esReporte}}
                        <th>Motivo</th>
                    {{/esReporte}}

                    <th>Estado</th>

                    <th class="col-accion">Acción</th>
                </tr>
                </thead>

                <tbody>
                {{#preguntas}}
                    <tr
                            class="fila-moderacion"
                            onclick="window.location.href='{{urlDetalle}}'"
                    >
                        <td>
                                <span
                                        class="categoria-badge"
                                        style="background-color: {{pregunta.color}}30; color: #0f172a;"
                                >
                                    <span>{{pregunta.icono}}</span>
                                    {{pregunta.categoria}}
                                </span>
                        </td>

                        <td>
                            <div class="pregunta-texto" title="{{pregunta.texto}}">
                                {{pregunta.texto}}
                            </div>
                        </td>

                        <td>
                            <div class="pregunta-estado" title="{{pregunta.estado}}">
                                {{pregunta.estado}}
                            </div>
                        </td>

                        <td class="col-accion">
                            <a
                                    href="{{urlDetalle}}"
                                    class="btn-ver {{#esReporte}}btn-reporte{{/esReporte}}{{^esReporte}}btn-sugerencia{{/esReporte}}"
                                    onclick="event.stopPropagation();"
                            >
                                Ver
                            </a>
                        </td>
                    </tr>
                {{/preguntas}}
                </tbody>

            </table>
        </div>

        {{#hayPaginacion}}
            <nav class="paginacion" aria-label="Paginación del banco de preguntas">
                {{#hayAnterior}}
                    <a class="paginacion__link" href="{{urlAnterior}}">&laquo; Anterior</a>
                {{/hayAnterior}}

                {{#paginas}}
                    <a class="paginacion__link{{#esActual}} is-actual{{/esActual}}" href="{{url}}"{{#esActual}} aria-current="page"{{/esActual}}>{{numero}}</a>
                {{/paginas}}

                {{#haySiguiente}}
                    <a class="paginacion__link" href="{{urlSiguiente}}">Siguiente &raquo;</a>
                {{/haySiguiente}}
            </nav>

            <p class="paginacion__info">Página {{paginaActual}} de {{totalPaginas}} · {{totalPreguntas}} preguntas</p>
        {{/hayPaginacion}}

    {{/hayPreguntas}}

    {{^hayPreguntas}}
        <div class="sin-resultados">
            <span>📭</span>
            {{^esReporte}}
                <p>Aún no hay preguntas por mostrar.</p>
            {{/esReporte}}
        </div>
    {{/hayPreguntas}}

</main>