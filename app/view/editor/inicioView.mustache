<style>
    .editor {
        max-width: 960px;
        margin: 0 auto;
        padding: 1.5rem 1rem 2rem;
        font-family: var(--font-text, "Nunito", system-ui, sans-serif);
        color: var(--color-ink, #0f172a);
        box-sizing: border-box;
    }

    .editor *,
    .editor *::before,
    .editor *::after {
        box-sizing: border-box;
    }

    /* Saludo */
    .editor__hello {
        margin: 0 0 0.5rem;
        font-size: 1rem;
        font-weight: 600;
        color: #64748b;
    }

    .editor__hello strong {
        color: var(--color-ink, #0f172a);
        font-weight: 800;
    }

    /* Encabezado */
    .editor__hero {
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        background: linear-gradient(
            135deg,
            #e0f2fe 0%,
            #e0f2fe 50%,
            #fff4dc 100%
        );
        border-radius: 1.75rem;
    }

    .editor__title {
        margin: 0 0 0.5rem;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--color-primary-dark, #0369a1);
    }

    .editor__description {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 600;
        line-height: 1.5;
        color: var(--color-ink-soft, #334155);
    }

    /* Título de sección */
    .editor__section-title {
        margin: 2rem 0 0.35rem;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.4rem;
        font-weight: 700;
    }

    .editor__section-text {
        margin: 0 0 1rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: #64748b;
    }

    /* Tarjetas */
    .editor__cards {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .editor__card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1.25rem;
        min-height: 230px;
        padding: 1.25rem;
        border-radius: 1.5rem;
        border: 2px solid var(--card-edge);
        background: var(--card-bg);
    }

    .editor__card--suggestions {
        --card-bg: #e0f2fe;
        --card-edge: #7dd3fc;
    }

    .editor__card--reports {
        --card-bg: #ffedd5;
        --card-edge: #fdba74;
    }

    .editor__card-header {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .editor__icon {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 52px;
        height: 52px;
        font-size: 1.6rem;
        background-color: #ffffff;
        border-radius: 50%;
    }

    .editor__card-title {
        margin: 0;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.25rem;
        font-weight: 700;
    }

    .editor__card-description {
        margin: 0.85rem 0 0;
        font-size: 0.95rem;
        font-weight: 600;
        line-height: 1.5;
        color: #334155;
    }

    /* Pendientes */
    .editor__pending {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        width: fit-content;
        min-height: 34px;
        padding: 0 0.85rem;
        font-size: 0.9rem;
        font-weight: 800;
        background-color: #ffffff;
        border-radius: 9999px;
    }

    /* Botones */
    .editor__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 1.25rem;
        font-family: var(--font-family, "Outfit", system-ui, sans-serif);
        font-size: 0.95rem;
        font-weight: 700;
        text-decoration: none;
        text-align: center;
        color: var(--color-ink, #7C2D12);
        background-color: var(--color-secondary, #FDBA74);
        border-radius: 9999px;
        box-shadow: 0 4px 0 var(--color-secondary-dark, #b45309);
        transition: transform 0.1s ease, box-shadow 0.1s ease;
    }

    .editor__button:hover {
        background: #FB923C;
        filter: brightness(1.05);
    }

    .editor__button:active {
        transform: translateY(4px);
        box-shadow: 0 0 0 transparent;
    }

    .editor__button:focus-visible {
        outline: 3px solid rgba(2, 132, 199, 0.4);
        outline-offset: 3px;
    }

    .editor__button--suggestions {
        background-color:rgb(140, 203, 231);
        color: #0c4a6e;
        border: 2px solid #7dd3fc;
        box-shadow: 0 4px 0 #0369a1;
    }

    .editor__button--suggestions:hover {
        background-color: #38bdf8;
        border-color: #38bdf8;
        filter: none;
    }

    @media (min-width: 768px) {
        .editor {
            padding: 2rem 1.5rem;
        }

        .editor__hero {
            padding: 2rem 2.5rem;
        }

        .editor__title {
            font-size: 2.4rem;
        }

        .editor__description {
            font-size: 1.1rem;
        }

        .editor__hello {
            font-size: 1.15rem;
        }

        .editor__section-title {
            font-size: 1.6rem;
        }

        .editor__cards {
            grid-template-columns: repeat(2, 1fr);
            gap: 1.25rem;
        }

        .editor__card {
            min-height: 270px;
            padding: 1.5rem;
        }

        .editor__card-title {
            font-size: 1.4rem;
        }

        .editor__button {
            min-height: 50px;
            font-size: 1rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .editor__button {
            transition: none;
        }
    }
</style>

{{> header}}

<main class="editor">

    <!-- Saludo -->
    <p class="editor__hello">
        ¡Hola, <strong>{{nombreUsuario}}</strong>!
    </p>

    <!-- Encabezado -->
    <section class="editor__hero">
        <h1 class="editor__title">Panel de moderación</h1>

        <p class="editor__description">
            ¡Tu ayuda mantiene la calidad del juego!
            Revisá las preguntas sugeridas por los jugadores
            y los reportes recibidos.
        </p>
    </section>

    <!-- Opciones de moderación -->
    <section>
        <h2 class="editor__section-title">Tareas</h2>

        <p class="editor__section-text">
            Elegí una para comenzar.
        </p>

        <div class="editor__cards">

            <!-- Preguntas sugeridas -->
            <article class="editor__card editor__card--suggestions">

                <div>
                    <div class="editor__card-header">
                        <span class="editor__icon" aria-hidden="true">💡</span>
                        <h3 class="editor__card-title">
                            Preguntas sugeridas
                        </h3>
                    </div>

                    <p class="editor__card-description">
                        Revisá las nuevas preguntas propuestas por
                        los jugadores y decidí si cumplen con los
                        requisitos para incorporarse al juego.
                    </p>
                </div>

                <div>
                    <p class="editor__pending">
                        📋 {{totalSugerencias}} pendientes
                    </p>

                    <a href="{{base_url}}/editor/listarSugerencias"
                       class="editor__button editor__button--suggestions">
                        Revisar sugerencias
                    </a>
                </div>

            </article>

            <!-- Preguntas reportadas -->
            <article class="editor__card editor__card--reports">

                <div>
                    <div class="editor__card-header">
                        <span class="editor__icon" aria-hidden="true">🚩</span>
                        <h3 class="editor__card-title">
                            Preguntas reportadas
                        </h3>
                    </div>

                    <p class="editor__card-description">
                        Analizá los reportes realizados por los jugadores
                        sobre preguntas existentes y determiná si
                        corresponde tomar alguna medida.
                    </p>
                </div>

                <div>
                    <p class="editor__pending">
                        📋 {{totalReportes}} pendientes
                    </p>

                    <a href="{{base_url}}/editor/listarReportes"
                       class="editor__button">
                        Revisar reportes
                    </a>
                </div>

            </article>

        </div>
    </section>

</main>

{{> footer}}
