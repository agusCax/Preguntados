<style>
    .categoria-form-container {
        width: 100%;
        max-width: 560px;
        margin-inline: auto;
        padding: 1.5rem 1rem 2.5rem;
        font-family: var(--font-text, "Nunito", system-ui, sans-serif);
        box-sizing: border-box;
    }

    .categoria-form-header {
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .categoria-form-header h1 {
        margin: 0 0 8px;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.9rem;
        font-weight: 700;
        color: var(--color-ink, #0f172a);
    }

    .categoria-form-header p {
        margin: 0;
        color: var(--color-ink-soft, #334155);
        font-weight: 700;
        line-height: 1.5;
    }

    .categoria-form {
        padding: 1.75rem 1.5rem;
        background: var(--color-white, #ffffff);
        border: 3px solid var(--color-ink, #0f172a);
        border-radius: 1.75rem;
        box-shadow: 0 8px 0 var(--color-ink, #0f172a);
    }

    .categoria-form__campo {
        margin-bottom: 1.25rem;
    }

    .categoria-form__campo label {
        display: block;
        margin-bottom: 0.45rem;
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-weight: 800;
        font-size: 0.95rem;
        color: var(--color-ink, #0f172a);
    }

    .categoria-form__campo small {
        display: block;
        margin-top: 4px;
        color: var(--color-ink-soft, #334155);
        font-weight: 700;
    }

    .categoria-form__campo input[type="text"] {
        width: 100%;
        box-sizing: border-box;
        min-height: 48px;
        padding: 0 14px;
        font-family: inherit;
        font-size: 1rem;
        font-weight: 700;
        color: var(--color-ink, #0f172a);
        background: var(--color-white, #ffffff);
        border: 2.5px solid var(--color-ink, #0f172a);
        border-radius: 0.95rem;
        box-shadow: 0 3px 0 var(--color-ink, #0f172a);
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .categoria-form__campo input[type="text"]:focus {
        outline: none;
        border-color: var(--color-primary, #0284c7);
        box-shadow: 0 3px 0 var(--color-primary, #0284c7);
    }

    .categoria-form__campo select {
        width: 100%;
        box-sizing: border-box;
        min-height: 48px;
        padding: 0 14px;
        font-family: inherit;
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--color-ink, #0f172a);
        background: var(--color-white, #ffffff);
        border: 2.5px solid var(--color-ink, #0f172a);
        border-radius: 0.95rem;
        box-shadow: 0 3px 0 var(--color-ink, #0f172a);
        cursor: pointer;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .categoria-form__campo select:focus {
        outline: none;
        border-color: var(--color-primary, #0284c7);
        box-shadow: 0 3px 0 var(--color-primary, #0284c7);
    }

    .categoria-form__campo input[type="color"] {
        width: 84px;
        height: 48px;
        padding: 3px;
        background: var(--color-white, #ffffff);
        border: 2.5px solid var(--color-ink, #0f172a);
        border-radius: 0.95rem;
        box-shadow: 0 3px 0 var(--color-ink, #0f172a);
        cursor: pointer;
    }

    .categoria-form__acciones {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
        margin-top: 1.5rem;
    }

    .categoria-form__boton {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 1.4rem;
        border: 3px solid var(--color-ink, #0f172a);
        border-radius: 9999px;
        box-shadow: 0 5px 0 var(--color-ink, #0f172a);
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 0.95rem;
        font-weight: 800;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease, filter 0.15s ease;
    }

    .categoria-form__boton--primario {
        color: var(--color-white, #ffffff);
        background: var(--color-primary, #0284c7);
    }

    .categoria-form__boton--primario:hover {
        filter: brightness(1.05);
        transform: translateY(-2px);
        box-shadow: 0 7px 0 var(--color-ink, #0f172a);
    }

    .categoria-form__boton--secundario {
        color: var(--color-ink, #0f172a);
        background: var(--color-white, #ffffff);
    }

    .categoria-form__boton--secundario:hover {
        background: var(--color-sky-soft, #bfe6fb);
        transform: translateY(-2px);
        box-shadow: 0 7px 0 var(--color-ink, #0f172a);
    }

    .categoria-form__boton:active {
        transform: translateY(5px);
        box-shadow: 0 0 0 var(--color-ink, #0f172a);
    }

    @media (prefers-reduced-motion: reduce) {
        .categoria-form__campo input[type="text"],
        .categoria-form__campo select,
        .categoria-form__boton {
            transition: none;
        }
    }
</style>

<main class="categoria-form-container">

    <header class="categoria-form-header">
        <h1>{{titulo}}</h1>
        <p>{{descripcion}}</p>
    </header>

    <form class="categoria-form" method="post" action="{{urlForm}}">
        <input type="hidden" name="id" value="{{idCategoria}}">

        <div class="categoria-form__campo">
            <label for="nombre">Nombre</label>
            <input type="text" id="nombre" name="nombre" value="{{nombre}}" maxlength="50" required>
        </div>

        <div class="categoria-form__campo">
            <label for="icono">Ícono</label>
            <select id="icono" name="icono" required>
                <option value="">Elegí un ícono</option>
                {{#iconos}}
                    <option value="{{icono}}"{{#seleccionado}} selected{{/seleccionado}}>{{icono}}</option>
                {{/iconos}}
            </select>
        </div>

        <div class="categoria-form__campo">
            <label for="color">Color</label>
            <input type="color" id="color" name="color" value="{{color}}" required>
        </div>

        <div class="categoria-form__acciones">
            <button type="submit" class="categoria-form__boton categoria-form__boton--primario">{{textoBoton}}</button>
            <a href="{{urlVolver}}" class="categoria-form__boton categoria-form__boton--secundario">Cancelar</a>
        </div>
    </form>

</main>