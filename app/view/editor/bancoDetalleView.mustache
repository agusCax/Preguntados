<style>
    body {
        background-color: var(--color-cream, #fff8e8);
    }

    .mod-detalle,
    .mod-detalle *,
    .mod-detalle *::before,
    .mod-detalle *::after {
        box-sizing: border-box;
    }

    .mod-detalle {
        --md-ink: var(--color-ink, #0f172a);
        --md-muted: var(--color-ink-soft, #475569);
        --md-sky: var(--color-sky-soft, #bfe6fb);

        max-width: 720px;
        margin: 0 auto;
        padding: 1.5rem 1rem 3rem;
        font-family: var(--font-text, "Nunito", system-ui, sans-serif);
        color: var(--md-ink);
    }

    /* Barra superior liviana sin contenedor */
    .mod-detalle__topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.1rem;
    }

    .mod-detalle__back {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.45rem 1rem;
        font-family: var(--font-ui, "Outfit", system-ui, sans-serif);
        font-size: 0.9rem;
        font-weight: 800;
        color: var(--md-ink);
        background-color: #ffffff;
        border: 2.5px solid var(--md-ink);
        border-radius: 9999px;
        box-shadow: 0 3px 0 var(--md-ink);
        text-decoration: none;
        transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease;
    }

    .mod-detalle__back:hover {
        background-color: var(--md-sky);
        transform: translateY(-2px);
        box-shadow: 0 5px 0 var(--md-ink);
    }

    .mod-detalle__back:active {
        transform: translateY(3px);
        box-shadow: 0 0 0 var(--md-ink);
    }

    /* ÚNICO CONTENEDOR PRINCIPAL */
    .mod-detalle__card {
        background-color: #ffffff;
        border: 3px solid var(--md-ink);
        border-radius: 1.75rem;
        box-shadow: 0 8px 0 var(--md-ink);
        overflow: hidden;
    }

    .mod-detalle__header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 1.35rem 1.75rem;
        background-color: var(--md-sky);
        border-bottom: 3px solid var(--md-ink);
    }

    .mod-detalle__title {
        margin: 0;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.65rem;
        font-weight: 700;
        color: var(--md-ink);
    }

    .mod-detalle__subtitle {
        margin: 0.15rem 0 0;
        font-size: 0.92rem;
        font-weight: 700;
        color: var(--md-muted);
    }

    .mod-detalle__category {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.35rem 0.9rem;
        font-family: var(--font-ui, "Outfit", system-ui, sans-serif);
        font-size: 0.85rem;
        font-weight: 800;
        color: var(--md-ink);
        background-color: #ffffff;
        border: 2px solid var(--md-ink);
        border-radius: 9999px;
    }

    .mod-detalle__body {
        padding: 1.75rem;
    }

    .mod-detalle__question-title {
        margin: 0 0 1.4rem;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.45rem;
        font-weight: 700;
        line-height: 1.35;
        color: var(--md-ink);
    }

    .mod-detalle__section-label {
        display: block;
        margin-bottom: 0.65rem;
        font-family: var(--font-ui, "Outfit", system-ui, sans-serif);
        font-size: 0.82rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--md-muted);
    }

    /* Opciones livianas sin doble sombra */
    .mod-detalle__options {
        display: grid;
        gap: 0.6rem;
        margin: 0;
        padding: 0;
        list-style: none;
        counter-reset: opcion-item;
    }

    .mod-detalle__option {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding: 0.65rem 0.95rem;
        font-size: 0.96rem;
        font-weight: 700;
        color: var(--md-ink);
        background-color: #f8fafc;
        border: 2px solid #cbd5e1;
        border-radius: 1rem;
        counter-increment: opcion-item;
    }

    .mod-detalle__option-icon {
        display: grid;
        flex-shrink: 0;
        place-items: center;
        width: 28px;
        height: 28px;
        font-family: var(--font-ui, "Outfit", system-ui, sans-serif);
        font-size: 0.85rem;
        font-weight: 800;
        color: var(--md-ink);
        background-color: var(--md-sky);
        border: 2px solid var(--md-ink);
        border-radius: 50%;
    }

    .mod-detalle__option-icon::before {
        content: counter(opcion-item);
    }

    /* Pie de tarjeta con acciones integradas */
    .mod-detalle__actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.8rem;
        margin-top: 1.75rem;
        padding-top: 1.35rem;
        border-top: 2px dashed #cbd5e1;
    }

    .mod-detalle__actions form {
        display: flex;
        margin: 0;
    }

    .mod-detalle__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        min-width: 155px;
        padding: 0 1.35rem;
        font-family: var(--font-ui, "Outfit", system-ui, sans-serif);
        font-size: 0.95rem;
        font-weight: 800;
        color: var(--md-ink);
        text-decoration: none;
        border: 3px solid var(--md-ink);
        border-radius: 9999px;
        box-shadow: 0 4px 0 var(--md-ink);
        cursor: pointer;
        transition: transform 0.1s ease, box-shadow 0.1s ease, filter 0.15s ease;
    }

    .mod-detalle__button--estado {
        background-color: #fecaca;
    }

    .mod-detalle__button--modify {
        background-color: var(--md-sky);
    }

    .mod-detalle__button:hover {
        filter: brightness(1.03);
        transform: translateY(-2px);
        box-shadow: 0 6px 0 var(--md-ink);
    }

    .mod-detalle__button:active {
        transform: translateY(4px);
        box-shadow: 0 0 0 var(--md-ink);
    }
</style>

<section class="mod-detalle">
    <div class="mod-detalle__topbar">
        <a class="mod-detalle__back" href="{{urlListado}}">
            ← Volver al banco de preguntas
        </a>
    </div>

    <article class="mod-detalle__card">
        <header class="mod-detalle__header">
            <div>
                <h1 class="mod-detalle__title">Pregunta {{estado}}</h1>
                <p class="mod-detalle__subtitle">Podés cambiar el estado de la pregunta o modificarla.</p>
            </div>

            <span class="mod-detalle__category">
                {{pregunta.icono}} {{pregunta.categoria}}
            </span>
        </header>

        <div class="mod-detalle__body">
            <h2 class="mod-detalle__question-title">{{pregunta.texto}}</h2>

            <span class="mod-detalle__section-label">Opciones de respuesta</span>
            <ol class="mod-detalle__options">
                {{#opciones}}
                    <li class="mod-detalle__option">
                        <span class="mod-detalle__option-icon" aria-hidden="true"></span>
                        <span>{{texto}}</span>
                    </li>
                {{/opciones}}
            </ol>

            <div class="mod-detalle__actions">
                <form action="{{urlCambiarEstado}}" method="POST" data-confirmar="{{confirmacionEstado}}">
                    <input type="hidden" name="pregunta_id" value="{{pregunta.id}}">
                    <input type="hidden" name="nuevo_estado" value="{{nuevoEstado}}">
                    <button class="mod-detalle__button mod-detalle__button--estado" type="submit">
                        {{textoBtn}}
                    </button>
                </form>

                <a class="mod-detalle__button mod-detalle__button--modify" href="{{urlEditar}}">
                    Modificar
                </a>
            </div>
        </div>
    </article>
</section>

{{> editor/confirmarView}}