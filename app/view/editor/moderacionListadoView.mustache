<style>
    /* =========================================
    CONTENEDOR GENERAL
    ========================================= */

    body {
        background-color: var(--color-cream, #fff8e8);
    }

    .moderacion-container {
        --mod-ink: var(--color-ink, #0f172a);
        --mod-muted: var(--color-ink-soft, #334155);
        --mod-primary: var(--color-primary, #0284c7);
        --mod-sky: var(--color-sky-soft, #bfe6fb);
        --mod-sun: var(--color-sun, #fcd34d);

        width: 100%;
        max-width: 1100px;
        margin-inline: auto;
        padding: 1.5rem 1rem 2.5rem;
        font-family: var(--font-text, "Nunito", system-ui, sans-serif);
        color: var(--mod-ink);
        box-sizing: border-box;
    }

    @media (max-width: 499px) {
        .moderacion-container {
            max-width: 100%;
            margin-left: auto;
            margin-right: auto;
        }
    }

    .moderacion-header {
        width: 100%;
        margin-bottom: 1.5rem;
        padding: 1.5rem;
        text-align: center;
        background-color: var(--mod-sky);
        border: 3px solid var(--mod-ink);
        border-radius: 1.75rem;
        box-shadow: 0 8px 0 var(--mod-ink);
        box-sizing: border-box;
    }

    .moderacion-header h1 {
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.75rem;
        font-weight: 700;
        line-height: 1.2;
        margin: 0 0 0.4rem;
        color: var(--mod-ink);
    }

    .moderacion-header p {
        color: var(--mod-muted);
        font-size: 0.98rem;
        font-weight: 700;
        line-height: 1.5;
        margin: 0;
    }

    /* =========================================
    LISTADO MOBILE
    ========================================= */

    .tabla-container {
        width: 100%;
    }

    .tabla-moderacion {
        display: block;
        width: 100%;
        max-width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .tabla-moderacion thead {
        display: none;
    }

    .tabla-moderacion tbody {
        display: block;
        width: 100%;
    }

    .tabla-moderacion tr {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;

        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        margin-bottom: 1rem;
        padding: 1.25rem 1rem;

        background: var(--color-white, #ffffff);
        border: 2.5px solid var(--mod-ink);
        border-radius: 1.35rem;
        box-shadow: 0 5px 0 var(--mod-ink);

        cursor: pointer;
        text-align: center;

        transition: background-color 0.15s ease, transform 0.1s ease;
    }

    .tabla-moderacion td {
        display: block;
        width: 100%;
        min-width: 0;
        padding: 0;
        border: none;
        box-sizing: border-box;
    }

    /* =========================================
    CATEGORÍA
    ========================================= */

    .categoria-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;

        max-width: 100%;
        padding: 0.38rem 0.85rem;

        border: 2px solid var(--mod-ink);
        border-radius: 9999px;
        box-shadow: 0 2px 0 var(--mod-ink);
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 0.84rem;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    /* =========================================
    PREGUNTA Y MOTIVO
    ========================================= */

    .pregunta-texto {
        width: 100%;
        color: var(--mod-ink);
        font-size: 0.96rem;
        font-weight: 700;
        line-height: 1.5;

        white-space: normal;
        overflow-wrap: anywhere;
        text-align: center;
    }

    .motivo-texto {
        color: var(--mod-muted);
        font-size: 0.88rem;
        font-weight: 700;
        line-height: 1.4;

        white-space: normal;
        overflow-wrap: anywhere;
        text-align: center;
    }

    .motivo-texto::before {
        content: "Motivo: ";
        font-weight: 800;
        color: var(--mod-ink);
    }

    /* =========================================
    BOTÓN VER
    ========================================= */

    .btn-ver {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        min-width: 104px;
        min-height: 42px;
        padding: 0.45rem 1.25rem;

        border: 2.5px solid var(--mod-ink);
        border-radius: 9999px;
        box-shadow: 0 3px 0 var(--mod-ink);
        text-decoration: none;
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-weight: 800;
        font-size: 0.9rem;
        color: var(--mod-ink);

        transition: transform 0.1s ease, box-shadow 0.1s ease, filter 0.15s ease;
    }

    .btn-sugerencia {
        background: var(--mod-sky);
    }

    .btn-reporte {
        background: var(--mod-sun);
    }

    .btn-ver:active {
        transform: translateY(3px);
        box-shadow: 0 0 0 var(--mod-ink);
    }

    /* =========================================
    ESTADO VACÍO
    ========================================= */

    .sin-resultados {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        width: 100%;
        min-height: 190px;
        box-sizing: border-box;
        padding: 2rem 1.25rem;

        text-align: center;
        color: var(--mod-muted);
        font-weight: 700;

        background: var(--color-white, #ffffff);
        border: 3px solid var(--mod-ink);
        border-radius: 1.75rem;
        box-shadow: 0 8px 0 var(--mod-ink);
    }

    .sin-resultados span {
        font-size: 2.2rem;
        margin-bottom: 0.65rem;
    }

    .sin-resultados p {
        margin: 0;
        line-height: 1.5;
    }

    /* =========================================
    VOLVER
    ========================================= */

    .volver-link {
        display: inline-flex;
        align-items: center;
        min-height: 42px;
        margin-top: 1.5rem;
        padding: 0.45rem 1.05rem;

        color: var(--mod-ink);
        background: var(--color-white, #ffffff);
        border: 2px solid var(--mod-ink);
        border-radius: 9999px;
        box-shadow: 0 3px 0 var(--mod-ink);
        text-decoration: none;
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-weight: 800;
        font-size: 0.92rem;
        transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease;
    }

    .volver-link:hover {
        background-color: var(--mod-sky);
        transform: translateY(-2px);
        box-shadow: 0 5px 0 var(--mod-ink);
    }

    .volver-link:active {
        transform: translateY(3px);
        box-shadow: 0 0 0 var(--mod-ink);
    }

    /* =========================================
    TABLET: 768px EN ADELANTE
    ========================================= */

    @media (min-width: 768px) {

        .moderacion-container {
            padding: 2rem 1.5rem 2.75rem;
        }

        .moderacion-header {
            padding: 2rem 2.5rem;
            text-align: left;
        }

        .moderacion-header h1 {
            font-size: 2.35rem;
        }

        .tabla-container {
            overflow-x: auto;
            background: var(--color-white, #ffffff);
            border: 3px solid var(--mod-ink);
            border-radius: 1.75rem;
            box-shadow: 0 8px 0 var(--mod-ink);
        }

        .tabla-moderacion {
            display: table;
            max-width: none;
            border-collapse: collapse;
            border-spacing: 0;
        }

        .tabla-moderacion thead {
            display: table-header-group;
        }

        .tabla-moderacion tbody {
            display: table-row-group;
        }

        .tabla-moderacion tr {
            display: table-row;
            max-width: none;
            margin-bottom: 0;
            padding: 0;
            background: transparent;
            border: none;
            border-radius: 0;
            box-shadow: none;
            text-align: left;
        }

        .tabla-moderacion tbody tr:hover {
            background-color: #fffdf8;
        }

        .tabla-moderacion td {
            display: table-cell;
            width: auto;
            padding: 1rem 1.25rem;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        .tabla-moderacion th {
            padding: 1rem 1.25rem;
            text-align: left;
            background: #f8fafc;
            color: var(--mod-ink);
            font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
            font-size: 0.88rem;
            font-weight: 800;
            border-bottom: 1px solid #e2e8f0;
        }

        .tabla-moderacion tbody tr:last-child td {
            border-bottom: none;
        }

        .pregunta-texto,
        .motivo-texto {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            text-align: left;
        }

        .pregunta-texto {
            max-width: 450px;
        }

        .motivo-texto {
            max-width: 220px;
        }

        .motivo-texto::before {
            content: none;
        }

        .btn-ver:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 0 var(--mod-ink);
            filter: brightness(1.03);
        }
    }

    /* =========================================
    ESCRITORIO: 1024px EN ADELANTE
    ========================================= */

    @media (min-width: 1024px) {

        .moderacion-container {
            padding: 2.5rem 1.75rem 3rem;
        }

        .tabla-moderacion th,
        .tabla-moderacion td {
            padding: 1.1rem 1.4rem;
        }
    }
</style>

<main class="moderacion-container">

    <header class="moderacion-header">
        {{#esReporte}}
            <h1>Reportes de preguntas</h1>
            <p>Revisá los reportes enviados por los jugadores.</p>
        {{/esReporte}}

        {{^esReporte}}
            <h1>Sugerencias de preguntas</h1>
            <p>Revisá las nuevas preguntas propuestas por los jugadores.</p>
        {{/esReporte}}
    </header>

    {{#hayModeraciones}}

        <div class="tabla-container">
            <table class="tabla-moderacion">

                <thead>
                <tr>
                    <th>Categoría</th>
                    <th>Pregunta</th>

                    {{#esReporte}}
                        <th>Motivo</th>
                    {{/esReporte}}

                    <th>Acción</th>
                </tr>
                </thead>

                <tbody>
                {{#moderaciones}}
                    <tr
                            class="fila-moderacion"
                            onclick="window.location.href='{{urlDetalle}}'"
                    >
                        <td>
                                <span
                                        class="categoria-badge"
                                        style="background-color: {{pregunta.color}}30; color: #0f172a;"
                                >
                                    <span>{{pregunta.icono}}</span>
                                    {{pregunta.categoria}}
                                </span>
                        </td>

                        <td>
                            <div class="pregunta-texto" title="{{pregunta.texto}}">
                                {{pregunta.texto}}
                            </div>
                        </td>

                        {{#esReporte}}
                            <td>
                                <div class="motivo-texto" title="{{reporte.motivo}}">
                                    {{reporte.motivo}}
                                </div>
                            </td>
                        {{/esReporte}}

                        <td>
                            <a
                                    href="{{urlDetalle}}"
                                    class="btn-ver {{#esReporte}}btn-reporte{{/esReporte}}{{^esReporte}}btn-sugerencia{{/esReporte}}"
                                    onclick="event.stopPropagation();"
                            >
                                Ver
                            </a>
                        </td>
                    </tr>
                {{/moderaciones}}
                </tbody>

            </table>
        </div>

    {{/hayModeraciones}}

    {{^hayModeraciones}}
        <div class="sin-resultados">
            <span>📭</span>
            {{#esReporte}}
                <p>No hay reportes pendientes para revisar.</p>
            {{/esReporte}}

            {{^esReporte}}
                <p>No hay sugerencias pendientes para revisar.</p>
            {{/esReporte}}
        </div>
    {{/hayModeraciones}}

    <a href="{{urlVolver}}" class="volver-link">
        ← Volver al panel de editor
    </a>

</main>