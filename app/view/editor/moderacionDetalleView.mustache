<style>
    body {
        background-color: var(--color-cream, #fff8e8);
    }

    .mod-detalle,
    .mod-detalle *,
    .mod-detalle *::before,
    .mod-detalle *::after {
        box-sizing: border-box;
    }

    .mod-detalle {
        --md-ink: var(--color-ink, #0f172a);
        --md-muted: var(--color-ink-soft, #334155);
        --md-primary: var(--color-primary, #0284c7);
        --md-sky: var(--color-sky-soft, #bfe6fb);

        max-width: 820px;
        margin: 0 auto;
        padding: 1.5rem 1rem 2.5rem;
        font-family: var(--font-text, "Nunito", system-ui, sans-serif);
        color: var(--md-ink);
    }

    .mensaje-exito {
        display: flex;
        align-items: center;
        gap: 12px;

        width: 100%;
        box-sizing: border-box;
        padding: 0.95rem 1.15rem;
        margin-bottom: 1.25rem;

        background: #bbf7d0;
        border: 2.5px solid var(--md-ink);
        border-radius: 1.25rem;
        box-shadow: 0 5px 0 var(--md-ink);

        color: var(--md-ink);
        font-weight: 700;
    }

    .mensaje-exito-icono {
        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;
        width: 30px;
        height: 30px;

        background: var(--color-white, #ffffff);
        border: 2px solid var(--md-ink);
        border-radius: 50%;

        font-weight: 800;
    }

    .mensaje-exito p {
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.4;
    }

    /* ---------- Encabezado ---------- */

    .mod-detalle__hero {
        margin-bottom: 1.5rem;
        padding: 1.5rem;
        background-color: var(--md-sky);
        border: 3px solid var(--md-ink);
        border-radius: 1.75rem;
        box-shadow: 0 8px 0 var(--md-ink);
    }

    .mod-detalle__title {
        margin: 0;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--md-ink);
    }

    .mod-detalle__subtitle {
        margin: 0.4rem 0 0;
        font-size: 0.98rem;
        font-weight: 700;
        color: var(--md-muted);
    }

    /* ---------- Tarjeta de pregunta ---------- */

    .mod-detalle__question {
        padding: 1.45rem;
        background-color: var(--color-white, #ffffff);
        border: 3px solid var(--md-ink);
        border-radius: 1.75rem;
        box-shadow: 0 8px 0 var(--md-ink);
    }

    .mod-detalle__category {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.4rem 0.9rem;
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 0.86rem;
        font-weight: 800;
        color: var(--md-ink);
        background-color: #ede9fe;
        border: 2px solid var(--md-ink);
        border-radius: 9999px;
        box-shadow: 0 2px 0 var(--md-ink);
    }

    .mod-detalle__question-title {
        margin: 1rem 0 1.25rem;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.38rem;
        font-weight: 700;
        line-height: 1.35;
        color: var(--md-ink);
    }

    .mod-detalle__section-title {
        margin: 0 0 0.75rem;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--md-ink);
    }

    /* ---------- Opciones ---------- */

    .mod-detalle__options {
        display: grid;
        gap: 0.75rem;
        margin: 0;
        padding: 0;
        list-style: none;
        counter-reset: opcion-item;
    }

    .mod-detalle__option {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        min-height: 50px;
        padding: 0.7rem 0.95rem;
        font-size: 0.96rem;
        font-weight: 700;
        color: var(--md-ink);
        background-color: #fffdf8;
        border: 2.5px solid var(--md-ink);
        border-radius: 1.15rem;
        box-shadow: 0 3px 0 var(--md-ink);
        overflow-wrap: anywhere;
        counter-increment: opcion-item;
    }

    .mod-detalle__option-icon {
        display: grid;
        flex-shrink: 0;
        place-items: center;
        width: 32px;
        height: 32px;
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 0.9rem;
        font-weight: 800;
        color: var(--md-ink);
        background-color: var(--md-sky);
        border: 2px solid var(--md-ink);
        border-radius: 50%;
    }

    .mod-detalle__option-icon::before {
        content: counter(opcion-item);
    }

    /* ---------- Reporte ---------- */

    .mod-detalle__report {
        margin-top: 1.5rem;
        padding: 1.35rem 1.5rem;
        background-color: #fff7ed;
        border: 3px solid var(--md-ink);
        border-radius: 1.75rem;
        box-shadow: 0 6px 0 var(--md-ink);
    }

    .mod-detalle__report-title {
        margin: 0 0 1rem;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.3rem;
        font-weight: 700;
        color: #9a3412;
    }

    .mod-detalle__report-label {
        margin: 0 0 0.2rem;
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 0.85rem;
        font-weight: 800;
        color: #7c2d12;
    }

    .mod-detalle__report-value {
        margin: 0 0 0.95rem;
        font-size: 0.96rem;
        font-weight: 700;
        color: var(--md-ink);
        overflow-wrap: anywhere;
    }

    .mod-detalle__report-value:last-child {
        margin-bottom: 0;
    }

    /* ---------- Acciones ---------- */

    .mod-detalle__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        margin-top: 1.5rem;
    }

    .mod-detalle__button {
        display: inline-flex;
        flex: 1;
        align-items: center;
        justify-content: center;
        min-height: 50px;
        padding: 0 1.4rem;
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 1rem;
        font-weight: 800;
        color: var(--md-ink);
        border: 3px solid var(--md-ink);
        border-radius: 9999px;
        box-shadow: 0 5px 0 var(--md-ink);
        cursor: pointer;
        transition: transform 0.1s ease, box-shadow 0.1s ease, filter 0.15s ease;
    }

    .mod-detalle__button--accept {
        background-color: #bbf7d0;
    }

    .mod-detalle__button--reject {
        background-color: #fecaca;
    }

    .mod-detalle__button:hover {
        filter: brightness(1.03);
        transform: translateY(-2px);
        box-shadow: 0 7px 0 var(--md-ink);
    }

    .mod-detalle__button:active {
        transform: translateY(5px);
        box-shadow: 0 0 0 var(--md-ink);
    }

    .mod-detalle__button:focus-visible {
        outline: 3px solid var(--md-primary);
        outline-offset: 3px;
    }

    /* ---------- Volver ---------- */

    .mod-detalle__links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
        margin-top: 1.65rem;
    }

    .mod-detalle__back {
        display: inline-flex;
        align-items: center;
        min-height: 42px;
        padding: 0.45rem 1.05rem;
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 0.92rem;
        font-weight: 800;
        color: var(--md-ink);
        background-color: var(--color-white, #ffffff);
        border: 2px solid var(--md-ink);
        border-radius: 9999px;
        box-shadow: 0 3px 0 var(--md-ink);
        text-decoration: none;
        transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease;
    }

    .mod-detalle__back:hover {
        background-color: var(--md-sky);
        transform: translateY(-2px);
        box-shadow: 0 5px 0 var(--md-ink);
    }

    .mod-detalle__back:active {
        transform: translateY(3px);
        box-shadow: 0 0 0 var(--md-ink);
    }

    .mod-detalle__back:focus-visible {
        outline: 3px solid var(--md-primary);
        outline-offset: 3px;
    }

    @media (prefers-reduced-motion: reduce) {
        .mod-detalle__button,
        .mod-detalle__back {
            transition: none;
        }
    }

    /* ---------- Tablet ---------- */

    @media (min-width: 768px) {
        .mod-detalle {
            padding: 2rem 1.5rem 2.75rem;
        }

        .mod-detalle__hero {
            padding: 2rem 2.5rem;
        }

        .mod-detalle__title {
            font-size: 2.35rem;
        }

        .mod-detalle__question {
            padding: 1.85rem 2rem;
        }

        .mod-detalle__question-title {
            font-size: 1.6rem;
        }

        .mod-detalle__report {
            padding: 1.5rem 1.85rem;
        }

        .mod-detalle__actions {
            justify-content: flex-end;
        }

        .mod-detalle__button {
            flex: initial;
            min-width: 180px;
        }
    }

    @media (min-width: 1024px) {
        .mod-detalle {
            padding-top: 2.5rem;
        }
    }
</style>

<section class="mod-detalle">

    <header class="mod-detalle__hero">

        {{#esReporte}}
            <h1 class="mod-detalle__title">
                Pregunta reportada
            </h1>

            <p class="mod-detalle__subtitle">
                Analizá el problema informado por el jugador.
            </p>
        {{/esReporte}}

        {{^esReporte}}
            <h1 class="mod-detalle__title">
                Pregunta sugerida
            </h1>

            <p class="mod-detalle__subtitle">
                Evaluá la nueva pregunta propuesta.
            </p>
        {{/esReporte}}

    </header>


    <article class="mod-detalle__question">

        <span class="mod-detalle__category">
            {{pregunta.icono}}
            {{pregunta.categoria}}
        </span>

        <h2 class="mod-detalle__question-title">
            {{pregunta.texto}}
        </h2>

        <h3 class="mod-detalle__section-title">
            Opciones de respuesta
        </h3>

        <ol class="mod-detalle__options">

            {{#opciones}}
                <li class="mod-detalle__option">
                    <span class="mod-detalle__option-icon" aria-hidden="true"></span>
                    <span>{{texto}}</span>
                </li>
            {{/opciones}}

        </ol>

    </article>

    {{#esReporte}}
        <article class="mod-detalle__report">

            <h2 class="mod-detalle__report-title">
                🚩 Información del reporte
            </h2>

            <p class="mod-detalle__report-label">
                Motivo
            </p>

            <p class="mod-detalle__report-value">
                {{reporte.motivo}}
            </p>

            {{#reporte.descripcion}}
                <p class="mod-detalle__report-label">
                    Descripción adicional
                </p>

                <p class="mod-detalle__report-value">
                    {{reporte.descripcion}}
                </p>
            {{/reporte.descripcion}}

            <p class="mod-detalle__report-label">
                Fecha del reporte
            </p>

            <p class="mod-detalle__report-value">
                {{reporte.fecha}}
            </p>

        </article>
    {{/esReporte}}

    <form action="{{urlProcesar}}" method="POST">

        <input type="hidden" name="pregunta_id" value="{{pregunta.id}}">
        <input type="hidden" name="reporte_id" value="{{reporte.reporte_id}}">

        <div class="mod-detalle__actions">

            <button
                    class="mod-detalle__button mod-detalle__button--accept"
                    type="submit"
                    name="accion"
                    value="aceptar"
            >
                ✓ Aceptar
            </button>

            <button
                    class="mod-detalle__button mod-detalle__button--reject"
                    type="submit"
                    name="accion"
                    value="rechazar"
            >
                ✕ Rechazar
            </button>

        </div>

    </form>

    {{#esReporte}}
        <nav class="mod-detalle__links">
            <a class="mod-detalle__back" href="{{urlListado}}"> ← Volver al listado de reportes </a>
            <a class="mod-detalle__back" href="{{urlBanco}}"> ← Volver al banco de preguntas </a>
        </nav>
    {{/esReporte}}

    {{^esReporte}}
        <nav class="mod-detalle__links">
            <a class="mod-detalle__back" href="{{urlListado}}"> ← Volver al listado de sugerencias </a>
            <a class="mod-detalle__back" href="{{urlBanco}}"> ← Volver al banco de preguntas </a>
        </nav>
    {{/esReporte}}

</section>