<style>
    body {
        background-color: var(--color-cream, #fff8e8);
    }

    .editor {
        --ed-ink: var(--color-ink, #0f172a);
        --ed-muted: var(--color-ink-soft, #334155);
        --ed-primary: var(--color-primary, #0284c7);
        --ed-sky: var(--color-sky-soft, #bfe6fb);
        --ed-sun: var(--color-sun, #fcd34d);
        --ed-amber: var(--color-amber, #f59e0b);

        max-width: 1100px;
        margin: 0 auto;
        padding: 1.5rem 1rem 2.5rem;
        font-family: var(--font-text, "Nunito", system-ui, sans-serif);
        color: var(--ed-ink);
        box-sizing: border-box;
    }

    .editor *,
    .editor *::before,
    .editor *::after {
        box-sizing: border-box;
    }

    /* Saludo */
    .editor__hello {
        margin: 0 0 0.75rem;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--ed-muted);
    }

    .editor__hello strong {
        color: var(--ed-ink);
        font-weight: 800;
    }

    /* Encabezado */
    .editor__hero {
        padding: 1.5rem;
        margin-bottom: 1.75rem;
        background-color: var(--ed-sky);
        border: 3px solid var(--ed-ink);
        border-radius: 1.75rem;
        box-shadow: 0 8px 0 var(--ed-ink);
    }

    .editor__title {
        margin: 0 0 0.45rem;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.85rem;
        font-weight: 700;
        color: var(--ed-ink);
    }

    .editor__description {
        margin: 0;
        font-size: 0.98rem;
        font-weight: 700;
        line-height: 1.5;
        color: var(--ed-muted);
    }

    /* Título de sección */
    .editor__section-title {
        margin: 1.75rem 0 0.25rem;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.45rem;
        font-weight: 700;
        color: var(--ed-ink);
    }

    .editor__section-text {
        margin: 0 0 1.15rem;
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--ed-muted);
    }

    /* Tarjetas */
    .editor__cards {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }

    .editor__card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1.35rem;
        min-height: 240px;
        padding: 1.4rem;
        background: var(--card-bg, #ffffff);
        border: 3px solid var(--ed-ink);
        border-radius: 1.75rem;
        box-shadow: 0 8px 0 var(--ed-ink);
    }

    .editor__card--suggestions {
        --card-bg: #e0f2fe;
    }

    .editor__card--reports {
        --card-bg: #fff7ed;
    }

    .editor__card-header {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .editor__icon {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 52px;
        height: 52px;
        font-size: 1.55rem;
        background-color: var(--color-white, #ffffff);
        border: 2.5px solid var(--ed-ink);
        border-radius: 50%;
        box-shadow: 0 3px 0 var(--ed-ink);
    }

    .editor__card-title {
        margin: 0;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--ed-ink);
    }

    .editor__card-description {
        margin: 0.9rem 0 0;
        font-size: 0.96rem;
        font-weight: 700;
        line-height: 1.5;
        color: var(--ed-muted);
    }

    /* Pendientes */
    .editor__pending {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        width: fit-content;
        min-height: 36px;
        margin: 0 0 0.85rem;
        padding: 0 0.95rem;
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 0.9rem;
        font-weight: 800;
        color: var(--ed-ink);
        background-color: var(--color-white, #ffffff);
        border: 2px solid var(--ed-ink);
        border-radius: 9999px;
        box-shadow: 0 2px 0 var(--ed-ink);
    }

    /* Botones */
    .editor__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 50px;
        padding: 0 1.4rem;
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 0.98rem;
        font-weight: 800;
        text-decoration: none;
        text-align: center;
        color: var(--ed-ink);
        background-color: var(--ed-amber);
        border: 3px solid var(--ed-ink);
        border-radius: 9999px;
        box-shadow: 0 5px 0 var(--ed-ink);
        transition: transform 0.1s ease, box-shadow 0.1s ease, filter 0.15s ease;
    }

    .editor__button:hover {
        filter: brightness(1.04);
        transform: translateY(-2px);
        box-shadow: 0 7px 0 var(--ed-ink);
    }

    .editor__button:active {
        transform: translateY(5px);
        box-shadow: 0 0 0 var(--ed-ink);
    }

    .editor__button:focus-visible {
        outline: 3px solid var(--ed-primary);
        outline-offset: 3px;
    }

    .editor__button--suggestions {
        background-color: var(--ed-sky);
    }

    .editor__button--suggestions:hover {
        background-color: #93d5fa;
    }

    @media (min-width: 768px) {
        .editor {
            padding: 2rem 1.5rem 2.75rem;
        }

        .editor__hero {
            padding: 2rem 2.5rem;
        }

        .editor__title {
            font-size: 2.4rem;
        }

        .editor__description {
            font-size: 1.05rem;
        }

        .editor__hello {
            font-size: 1.15rem;
        }

        .editor__section-title {
            font-size: 1.65rem;
        }

        .editor__cards {
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
        }

        .editor__card {
            min-height: 280px;
            padding: 1.75rem;
        }

        .editor__card-title {
            font-size: 1.45rem;
        }

        .editor__button {
            width: auto;
            min-width: 210px;
            font-size: 1rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .editor__button {
            transition: none;
        }
    }
</style>

<main class="editor">

    <!-- Saludo -->
    <p class="editor__hello">
        ¡Hola, <strong>{{nombreUsuario}}</strong>!
    </p>

    <!-- Encabezado -->
    <section class="editor__hero">
        <h1 class="editor__title">Panel de moderación</h1>

        <p class="editor__description">
            ¡Tu ayuda mantiene la calidad del juego!
            Revisá las preguntas sugeridas por los jugadores
            y los reportes recibidos.
        </p>
    </section>

    <!-- Opciones de moderación -->
    <section>
        <h2 class="editor__section-title">Tareas</h2>

        <p class="editor__section-text">
            Elegí una para comenzar.
        </p>

        <div class="editor__cards">

            <!-- Preguntas sugeridas -->
            <article class="editor__card editor__card--suggestions">

                <div>
                    <div class="editor__card-header">
                        <span class="editor__icon" aria-hidden="true">💡</span>
                        <h3 class="editor__card-title">
                            Preguntas sugeridas
                        </h3>
                    </div>

                    <p class="editor__card-description">
                        Revisá las nuevas preguntas propuestas por
                        los jugadores y decidí si cumplen con los
                        requisitos para incorporarse al juego.
                    </p>
                </div>

                <div>
                    <p class="editor__pending">
                        📋 {{totalSugerencias}} pendientes
                    </p>

                    <a href="{{base_url}}/editor/listarSugerencias"
                       class="editor__button editor__button--suggestions">
                        Revisar sugerencias
                    </a>
                </div>

            </article>

            <!-- Preguntas reportadas -->
            <article class="editor__card editor__card--reports">

                <div>
                    <div class="editor__card-header">
                        <span class="editor__icon" aria-hidden="true">🚩</span>
                        <h3 class="editor__card-title">
                            Preguntas reportadas
                        </h3>
                    </div>

                    <p class="editor__card-description">
                        Analizá los reportes realizados por los jugadores
                        sobre preguntas existentes y determiná si
                        corresponde tomar alguna medida.
                    </p>
                </div>

                <div>
                    <p class="editor__pending">
                        📋 {{totalReportes}} pendientes
                    </p>

                    <a href="{{base_url}}/editor/listarReportes"
                       class="editor__button">
                        Revisar reportes
                    </a>
                </div>

            </article>

        </div>
    </section>

</main>