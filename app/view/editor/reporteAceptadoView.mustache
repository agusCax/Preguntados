<style>
    /* =========================================
       CONTENEDOR GENERAL
    ========================================= */

    body {
        background-color: var(--color-cream, #fff8e8);
    }

    .resolucion-container {
        --res-ink: var(--color-ink, #0f172a);
        --res-muted: var(--color-ink-soft, #334155);
        --res-primary: var(--color-primary, #0284c7);
        --res-sky: var(--color-sky-soft, #bfe6fb);

        width: 100%;
        max-width: 820px;
        margin-inline: auto;
        padding: 1.5rem 1rem 2.5rem;
        font-family: var(--font-text, "Nunito", system-ui, sans-serif);
        color: var(--res-ink);
        box-sizing: border-box;
    }

    .resolucion-header {
        margin-bottom: 1.5rem;
        padding: 1.5rem;
        text-align: center;
        background-color: var(--res-sky);
        border: 3px solid var(--res-ink);
        border-radius: 1.75rem;
        box-shadow: 0 8px 0 var(--res-ink);
    }

    .resolucion-header h1 {
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--res-ink);
        margin: 0 0 0.4rem;
    }

    .resolucion-header p {
        color: var(--res-muted);
        font-size: 0.98rem;
        font-weight: 700;
        line-height: 1.5;
        margin: 0;
    }

    /* =========================================
       TARJETA DE INFORMACIÓN DEL REPORTE
    ========================================= */

    .reporte-resumen {
        padding: 1.35rem 1.5rem;
        margin-bottom: 1.5rem;
        background: #fff7ed;
        border: 3px solid var(--res-ink);
        border-radius: 1.75rem;
        box-shadow: 0 6px 0 var(--res-ink);
    }

    .reporte-resumen h2 {
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.3rem;
        font-weight: 700;
        color: #9a3412;
        margin: 0 0 0.85rem;
    }

    .reporte-resumen p {
        color: var(--res-ink);
        font-size: 0.96rem;
        font-weight: 700;
        line-height: 1.5;
        margin: 0.5rem 0;
    }

    .reporte-resumen strong {
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-weight: 800;
        color: #9a3412;
    }

    /* =========================================
       SECCIONES DE RESOLUCIÓN
    ========================================= */

    .resolucion-section {
        padding: 1.5rem 1.25rem;
        margin-bottom: 1.5rem;
        background: var(--color-white, #ffffff);
        border: 3px solid var(--res-ink);
        border-radius: 1.75rem;
        box-shadow: 0 8px 0 var(--res-ink);
    }

    .resolucion-section h2 {
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--res-ink);
        margin: 0 0 0.45rem;
    }

    .resolucion-section > p {
        color: var(--res-muted);
        font-size: 0.94rem;
        font-weight: 700;
        line-height: 1.5;
        margin: 0 0 1.25rem;
    }

    /* =========================================
       INACTIVAR PREGUNTA
    ========================================= */

    .inactivar-section {
        background: #fef2f2;
    }

    .btn-inactivar {
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        display: inline-flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        min-height: 48px;
        padding: 0.65rem 1.4rem;
        box-sizing: border-box;

        background: #fecaca;
        color: var(--res-ink);
        border: 3px solid var(--res-ink);
        border-radius: 9999px;
        box-shadow: 0 5px 0 var(--res-ink);

        font-size: 0.98rem;
        font-weight: 800;
        cursor: pointer;
        transition: transform 0.1s ease, box-shadow 0.1s ease, filter 0.15s ease;
    }

    .btn-inactivar:hover {
        filter: brightness(1.03);
        transform: translateY(-2px);
        box-shadow: 0 7px 0 var(--res-ink);
    }

    .btn-inactivar:active {
        transform: translateY(5px);
        box-shadow: 0 0 0 var(--res-ink);
    }

    /* =========================================
       BOTONES Y AVISOS
    ========================================= */

    .volver-link {
        display: inline-flex;
        align-items: center;
        min-height: 42px;
        margin-top: 0.25rem;
        padding: 0.45rem 1.05rem;
        color: var(--res-ink);
        background: var(--color-white, #ffffff);
        border: 2px solid var(--res-ink);
        border-radius: 9999px;
        box-shadow: 0 3px 0 var(--res-ink);
        text-decoration: none;
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-weight: 800;
        font-size: 0.92rem;
        transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease;
    }

    .volver-link:hover {
        background-color: var(--res-sky);
        transform: translateY(-2px);
        box-shadow: 0 5px 0 var(--res-ink);
    }

    .volver-link:active {
        transform: translateY(3px);
        box-shadow: 0 0 0 var(--res-ink);
    }

    /* =========================================
       TABLET Y ESCRITORIO
    ========================================= */

    @media (min-width: 768px) {
        .resolucion-container {
            padding: 2.25rem 1.5rem 2.75rem;
        }

        .resolucion-header {
            padding: 2rem 2.5rem;
            text-align: left;
        }

        .resolucion-header h1 {
            font-size: 2.35rem;
        }

        .resolucion-section {
            padding: 1.85rem 2rem;
        }

        .btn-inactivar {
            width: auto;
            min-width: 220px;
        }
    }
</style>

<main class="resolucion-container">

    <header class="resolucion-header">
        <h1>Resolución del reporte</h1>
        <p>Revisá la pregunta y elegí cómo resolver el inconveniente informado.</p>
    </header>

    <!-- INFORMACIÓN DEL REPORTE -->

    <section class="reporte-resumen">
        <h2>Información del reporte</h2>

        <p>
            <strong>Motivo:</strong>
            {{reporte.motivo}}
        </p>

        {{#reporte.descripcion}}
            <p>
                <strong>Descripción:</strong>
                {{reporte.descripcion}}
            </p>
        {{/reporte.descripcion}}

        <p>
            <strong>Pregunta reportada:</strong>
            {{pregunta.texto}}
        </p>
    </section>

    <!-- OPCIÓN 1: INACTIVAR -->

    <section class="resolucion-section inactivar-section">
        <h2>Inactivar pregunta</h2>

        <p>
            Si considerás que la pregunta no debería seguir formando
            parte del juego, podés inactivarla.
        </p>

        <form
                action="{{urlInactivar}}"
                method="POST"
                data-confirmar="¿Estás seguro de que querés inactivar esta pregunta y aceptar el reporte?"
        >
            <input type="hidden" name="reporte_id" value="{{reporte.reporte_id}}">
            <input type="hidden" name="pregunta_id" value="{{pregunta.id}}">

            <button type="submit" class="btn-inactivar">
                Aceptar reporte e inactivar pregunta
            </button>
        </form>
    </section>

    <!-- OPCIÓN 2: EDITAR -->

    <section class="resolucion-section">
        <h2>Editar pregunta</h2>

        <p>
            Si el problema puede corregirse, modificá el contenido
            de la pregunta antes de volver a habilitarla.
        </p>

        {{> editor/formPreguntaView}}

    </section>

    <a href="{{urlListado}}" class="volver-link">
        ← Volver al listado de reportes
    </a>

</main>

{{> editor/confirmarView}}