<style>
    /* =========================================
       FORMULARIO DE PREGUNTA (partial reutilizable)
    ========================================= */

    .form-grupo {
        margin-bottom: 1.35rem;
    }

    .form-grupo label,
    .form-label {
        display: block;
        margin-bottom: 0.5rem;
        color: var(--color-ink, #0f172a);
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-weight: 800;
        font-size: 0.94rem;
    }

    .form-control {
        width: 100%;
        min-height: 46px;
        padding: 0.7rem 0.9rem;
        box-sizing: border-box;

        background: var(--color-white, #ffffff);
        border: 2.5px solid var(--color-ink, #0f172a);
        border-radius: 1rem;
        box-shadow: 0 3px 0 var(--color-ink, #0f172a);

        color: var(--color-ink, #0f172a);
        font-family: var(--font-text, "Nunito", system-ui, sans-serif);
        font-size: 0.96rem;
        font-weight: 700;
        transition: box-shadow 0.12s ease, background-color 0.15s ease;
    }

    .form-control:focus {
        outline: 3px solid var(--color-primary, #0284c7);
        outline-offset: 2px;
        background-color: #fffdf8;
    }

    textarea.form-control {
        min-height: 104px;
        resize: vertical;
    }

    .respuestas-titulo {
        margin: 1.65rem 0 0.35rem;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--color-ink, #0f172a);
    }

    .respuestas-ayuda {
        margin: 0 0 1rem;
        color: var(--color-ink-soft, #334155);
        font-size: 0.9rem;
        font-weight: 700;
        line-height: 1.5;
    }

    .respuesta-item {
        padding: 1.1rem 1.15rem;
        margin-bottom: 1rem;
        background: #fffdf8;
        border: 2.5px solid var(--color-ink, #0f172a);
        border-radius: 1.35rem;
        box-shadow: 0 4px 0 var(--color-ink, #0f172a);
    }

    .respuesta-cabecera {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 0.65rem;
    }

    .respuesta-letra {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.75rem;
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 0.85rem;
        font-weight: 800;
        color: var(--color-ink, #0f172a);
        background-color: var(--color-sky-soft, #bfe6fb);
        border: 2px solid var(--color-ink, #0f172a);
        border-radius: 9999px;
    }

    .respuesta-item label:not(.respuesta-correcta) {
        display: block;
        margin-bottom: 0.45rem;
        color: var(--color-ink-soft, #334155);
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 0.88rem;
        font-weight: 800;
    }

    .respuesta-correcta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.85rem;
        padding: 0.45rem 0.95rem;
        background-color: var(--color-white, #ffffff);
        border: 2px solid var(--color-ink, #0f172a);
        border-radius: 9999px;
        box-shadow: 0 2px 0 var(--color-ink, #0f172a);
        color: var(--color-ink, #0f172a);
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 0.86rem;
        font-weight: 800;
        cursor: pointer;
        transition: background-color 0.15s ease, transform 0.1s ease;
    }

    .respuesta-correcta:has(input:checked) {
        background-color: #bbf7d0;
    }

    .respuesta-correcta input {
        width: 17px;
        height: 17px;
        margin: 0;
        accent-color: #16a34a;
        cursor: pointer;
    }

    .info-edicion {
        padding: 0.9rem 1.1rem;
        margin: 1.4rem 0;
        background: #e0f2fe;
        border: 2.5px solid var(--color-ink, #0f172a);
        border-radius: 1.15rem;
        box-shadow: 0 4px 0 var(--color-ink, #0f172a);
        color: var(--color-ink, #0f172a);
        font-size: 0.9rem;
        font-weight: 700;
        line-height: 1.5;
    }

    .btn-guardar {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        min-height: 50px;
        padding: 0.7rem 1.6rem;

        background: var(--color-amber, #f59e0b);
        color: var(--color-ink, #0f172a);
        border: 3px solid var(--color-ink, #0f172a);
        border-radius: 9999px;
        box-shadow: 0 5px 0 var(--color-ink, #0f172a);

        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-size: 1rem;
        font-weight: 800;
        cursor: pointer;
        transition: transform 0.1s ease, box-shadow 0.1s ease, filter 0.15s ease;
    }

    .btn-guardar:hover {
        filter: brightness(1.04);
        transform: translateY(-2px);
        box-shadow: 0 7px 0 var(--color-ink, #0f172a);
    }

    .btn-guardar:active {
        transform: translateY(5px);
        box-shadow: 0 0 0 var(--color-ink, #0f172a);
    }

    .btn-guardar:focus-visible {
        outline: 3px solid var(--color-primary, #0284c7);
        outline-offset: 3px;
    }

    @media (min-width: 768px) {
        .btn-guardar {
            width: auto;
            min-width: 210px;
        }
    }
</style>

{{!
    PARTIAL: formulario de pregunta

    Datos que espera del controlador:
      - urlForm          (string)  a dónde se envía el form
      - textoBtnForm         (string)  texto del botón de guardar
      - confirmacionForm (string, opcional) mensaje de la ventana de confirmacion (requiere incluir editor/confirmarView en la pagina)
      - infoForm              (string, opcional) cartel informativo antes del botón
      - pregunta.id        (opcional: vacío en el alta)
      - pregunta.texto     (vacío en el alta)
      - reporte.reporte_id (opcional: solo al resolver un reporte)
      - respuestas         (siempre 4 ítems: indice, letra, id, texto, esCorrecta)
      - categorias         (id, nombre, icono, seleccionada)
}}

<form
        action="{{urlForm}}"
        method="POST"
        {{#confirmacionForm}}data-confirmar="{{confirmacionForm}}"{{/confirmacionForm}}
>
    <input type="hidden" name="pregunta_id" value="{{pregunta.id}}">

    {{#reporte}}
        <input type="hidden" name="reporte_id" value="{{reporte_id}}">
    {{/reporte}}

    <!-- ENUNCIADO -->

    <div class="form-grupo">
        <label for="pregunta_texto">Pregunta</label>

        <textarea
                class="form-control"
                id="pregunta_texto"
                name="pregunta_texto"
                required
        >{{pregunta.texto}}</textarea>
    </div>

    <!-- RESPUESTAS -->

    <h3 class="respuestas-titulo">Opciones de respuesta</h3>

    <p class="respuestas-ayuda">
        Completá las cuatro opciones y marcá cuál es la correcta.
    </p>

    {{#respuestas}}
        <div class="respuesta-item">

            <div class="respuesta-cabecera">
                <span class="respuesta-letra">Opción {{letra}}</span>
            </div>

            <input
                    type="hidden"
                    name="respuestas[{{indice}}][id]"
                    value="{{id}}"
            >

            <label for="respuesta-{{indice}}">Texto de la respuesta</label>

            <input
                    type="text"
                    class="form-control"
                    id="respuesta-{{indice}}"
                    name="respuestas[{{indice}}][texto]"
                    value="{{texto}}"
                    required
            >

            <label class="respuesta-correcta">
                <input
                        type="radio"
                        name="respuesta_correcta"
                        value="{{indice}}"
                        {{#esCorrecta}}checked{{/esCorrecta}}
                        required
                >
                Es la respuesta correcta
            </label>

        </div>
    {{/respuestas}}

    <!-- CATEGORÍA -->

    <div class="form-grupo">
        <label for="categoria_id">Categoría</label>

        <select
                class="form-control"
                id="categoria_id"
                name="categoria_id"
                required
        >
            {{#categorias}}
                <option
                        value="{{id}}"
                        {{#seleccionada}}selected{{/seleccionada}}
                >
                    {{icono}} {{nombre}}
                </option>
            {{/categorias}}
        </select>
    </div>

    {{#infoForm}}
        <div class="info-edicion">{{infoForm}}</div>
    {{/infoForm}}

    <button type="submit" class="btn-guardar">
        {{textoBtnForm}}
    </button>

</form>