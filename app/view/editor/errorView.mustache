<style>
    .editor-error {
        width: 100%;
        max-width: 640px;
        margin: 0 auto;
        padding: 2rem 1rem 3rem;
        font-family: var(--font-text, "Nunito", system-ui, sans-serif);
        box-sizing: border-box;
    }

    .editor-error__mensaje {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        width: 100%;
        box-sizing: border-box;
        padding: 1.25rem 1.4rem;
        margin-bottom: 1.5rem;
        background: #fee2e2;
        border: 3px solid var(--color-ink, #0f172a);
        border-radius: 1.5rem;
        box-shadow: 0 6px 0 var(--color-ink, #0f172a);
        color: var(--color-ink, #0f172a);
    }

    .editor-error__icono {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 34px;
        height: 34px;
        background: #fca5a5;
        border: 2.5px solid var(--color-ink, #0f172a);
        border-radius: 50%;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--color-ink, #0f172a);
    }

    .editor-error__titulo {
        margin: 0 0 4px;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--color-ink, #0f172a);
    }

    .editor-error__texto {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 700;
        line-height: 1.45;
        color: #7f1d1d;
        overflow-wrap: anywhere;
    }

    .editor-error__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
    }

    .editor-error__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 1.4rem;
        border: 3px solid var(--color-ink, #0f172a);
        border-radius: 9999px;
        box-shadow: 0 5px 0 var(--color-ink, #0f172a);
        font-family: var(--font-ui, var(--font-family, "Outfit", system-ui, sans-serif));
        font-weight: 800;
        text-decoration: none;
        transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease, filter 0.15s ease;
    }

    .editor-error__button--primary {
        color: var(--color-white, #ffffff);
        background: var(--color-primary, #0284c7);
    }

    .editor-error__button--primary:hover {
        filter: brightness(1.05);
        transform: translateY(-2px);
        box-shadow: 0 7px 0 var(--color-ink, #0f172a);
    }

    .editor-error__button--secondary {
        color: var(--color-ink, #0f172a);
        background: var(--color-white, #ffffff);
    }

    .editor-error__button--secondary:hover {
        background: var(--color-sky-soft, #bfe6fb);
        transform: translateY(-2px);
        box-shadow: 0 7px 0 var(--color-ink, #0f172a);
    }

    .editor-error__button:active {
        transform: translateY(5px);
        box-shadow: 0 0 0 var(--color-ink, #0f172a);
    }

    @media (prefers-reduced-motion: reduce) {
        .editor-error__button {
            transition: none;
        }
    }
</style>

{{!
    Vista de error generica del editor.
    Datos que espera del controlador:
      - titulo     (string, opcional) encabezado del mensaje
      - mensaje    (string) detalle del error
      - volverUrl  (string) a donde vuelve el boton principal
}}

<main class="editor-error">

    <div class="editor-error__mensaje" role="alert">
        <span class="editor-error__icono" aria-hidden="true">!</span>

        <div>
            {{#titulo}}
                <p class="editor-error__titulo">{{titulo}}</p>
            {{/titulo}}

            <p class="editor-error__texto">{{mensaje}}</p>
        </div>
    </div>

    <nav class="editor-error__actions" aria-label="Salir del error">
        <a class="editor-error__button editor-error__button--primary" href="{{volverUrl}}">Volver</a>
        <a class="editor-error__button editor-error__button--secondary" href="{{base_url}}/editor/show">Ir al inicio</a>
    </nav>

</main>