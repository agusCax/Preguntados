{{> header}}

<div class="max-w-[540px] mx-auto p-4 bg-[#f7f9fb] min-h-screen text-[#191c1e] font-['Outfit'] pb-20">
    <div class="flex justify-between items-center mb-6">
        <a href="index.php?controller=inicio&method=show" class="text-2xl font-bold">&lt;</a>
        <h1 class="text-lg font-bold">Perfil</h1>
        <button class="text-xl">≡</button>
    </div>

    <div class="flex items-center gap-4 mb-4">
        <div class="relative">
            <div class="w-20 h-20 rounded-full bg-[#2d3133] text-white flex items-center justify-center text-3xl font-extrabold border-4 border-[#0284C7]">
                E
            </div>
            <span class="absolute bottom-0 right-0 bg-[#0284C7] p-1.5 rounded-full text-white text-xs">📷</span>
        </div>
        <div>
            <div class="flex items-center gap-2">
                <span class="font-extrabold text-lg">@{{usuario}}</span>
                <span class="text-sm">✏️</span>
            </div>
            <div class="text-sm text-[#3f4850] mt-1">
                <strong>{{seguidores}}</strong> Seguidores &nbsp;&nbsp; <strong>{{seguidos}}</strong> Seguidos
            </div>
        </div>
    </div>

    <div class="flex gap-3 mb-6">
        <button class="flex-1 bg-white border-2 border-[#bfc7d2] text-[#0f172a] py-2.5 rounded-full font-bold shadow-[0_3px_0_#94A3B8]">
            Compartir
        </button>
        <a href="index.php?controller=perfil&method=editar" class="flex-1 bg-[#0284C7] text-white py-2.5 rounded-full font-bold text-center shadow-[0_4px_0_#0369A1] block">
            Editar perfil
        </a>
    </div>

    <div class="flex border-b border-[#e2e8f0] mb-6 text-center font-bold">
        <div class="flex-1 pb-2 border-b-4 border-[#0284C7] text-[#0284C7]">Desempeño</div>
        <div class="flex-1 pb-2 text-[#707881]">Preguntas</div>
    </div>

    <div class="text-center mb-8">
        <h2 class="text-3xl font-extrabold tracking-tight">Nivel {{nivel}}</h2>
        <p class="text-sm text-[#3f4850] mt-1">Has respondido {{preguntasCorrectas}} preguntas correctamente</p>
    </div>

    <div class="bg-white p-4 rounded-3xl border-2 border-[#e2e8f0] shadow-sm mb-4 flex items-center justify-between">
        <div>
            <span class="text-xs font-bold text-[#707881] block mb-1">Tu especialidad</span>
            <span class="text-lg font-extrabold text-[#F59E0B]">{{especialidad}}</span>
            <p class="text-sm font-bold text-[#0f172a] mt-1">{{especialidadAciertos}}% aciertos</p>
            <div class="w-48 bg-[#e2e8f0] h-3 rounded-full mt-2 overflow-hidden">
                <div class="bg-[#F59E0B] h-full rounded-full" style="width: {{especialidadAciertos}}%;"></div>
            </div>
        </div>
        <div class="text-4xl">🏈</div>
    </div>

    <div class="bg-white p-4 rounded-3xl border-2 border-[#e2e8f0] shadow-sm mb-6 flex items-center justify-between">
        <div>
            <span class="text-xs font-bold text-[#707881] block mb-1">La más desafiante</span>
            <span class="text-lg font-extrabold text-[#10B981]">{{desafiante}}</span>
            <p class="text-sm font-bold text-[#0f172a] mt-1">{{desafianteAciertos}}% aciertos</p>
            <div class="w-48 bg-[#e2e8f0] h-3 rounded-full mt-2 overflow-hidden">
                <div class="bg-[#10B981] h-full rounded-full" style="width: {{desafianteAciertos}}%;"></div>
            </div>
        </div>
        <div class="text-4xl">🧪</div>
    </div>

    <div class="bg-white py-4 px-2 rounded-3xl border-2 border-[#e2e8f0] flex justify-around text-center mb-8">
        <div>
            <div class="text-xl font-extrabold">{{partidasGanadas}}</div>
            <div class="text-xs text-[#707881]">Partidas ganadas</div>
        </div>
        <div class="border-r border-[#e2e8f0]"></div>
        <div>
            <div class="text-xl font-extrabold">{{partidasPerdidas}}</div>
            <div class="text-xs text-[#707881]">Partidas perdidas</div>
        </div>
        <div class="border-r border-[#e2e8f0]"></div>
        <div>
            <div class="text-xl font-extrabold">{{partidasRendidas}}</div>
            <div class="text-xs text-[#707881]">Partidas rendidas</div>
        </div>
    </div>
</div>

{{> footer}}