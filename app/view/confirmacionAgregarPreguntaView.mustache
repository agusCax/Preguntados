<style>
    body {
        background-color: var(--color-cream, #fff8e8);
    }

    .confirmation__content,
    .confirmation__content *,
    .confirmation__content *::before,
    .confirmation__content *::after {
        box-sizing: border-box;
    }

    .confirmation__content {
        --confirm-ink: var(--color-ink, #0f172a);
        --confirm-ink-soft: var(--color-ink-soft, #334155);
        --confirm-primary: var(--color-primary, #0284c7);
        --confirm-sky: var(--color-sky-soft, #bfe6fb);
        --confirm-success: var(--color-success, #4ade80);
        --confirm-blob: 58% 42% 55% 45% / 50% 56% 44% 50%;

        position: relative;
        width: min(100% - 2rem, 560px);
        margin: 4.5rem auto 2.5rem;
        padding: 3.5rem clamp(1.5rem, 5vw, 2.5rem) clamp(1.75rem, 5vw, 2.5rem);
        color: var(--confirm-ink);
        font-family: var(--font-text, "Nunito", "Outfit", system-ui, sans-serif);
        text-align: center;
        background-color: var(--color-white, #ffffff);
        border: 3px solid var(--confirm-ink);
        border-radius: 1.75rem;
        box-shadow: 0 8px 0 var(--confirm-ink);
        animation: confirm-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    .confirmation__content::before {
        content: "✓";
        position: absolute;
        top: -2.6rem;
        left: 50%;
        width: 84px;
        height: 84px;
        display: grid;
        place-items: center;
        font-family: var(--font-display, "Fredoka", "Outfit", system-ui, sans-serif);
        font-size: 2.35rem;
        font-weight: 700;
        color: var(--confirm-ink);
        background-color: var(--confirm-success);
        border: 3px solid var(--confirm-ink);
        border-radius: var(--confirm-blob);
        box-shadow: 0 4px 0 var(--confirm-ink);
        transform: translateX(-50%);
    }

    .confirmation__title {
        margin: 0;
        font-family: var(--font-display, "Fredoka", "Outfit", system-ui, sans-serif);
        font-size: clamp(1.7rem, 5vw, 2.25rem);
        line-height: 1.15;
        font-weight: 700;
        color: var(--confirm-ink);
    }

    .confirmation__message {
        max-width: 46ch;
        margin: 0.85rem auto 0;
        color: var(--confirm-ink-soft);
        font-size: 1.05rem;
        font-weight: 700;
        line-height: 1.55;
    }

    .confirmation__actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.85rem;
        margin-top: 1.85rem;
    }

    .confirmation__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 170px;
        min-height: 48px;
        padding: 0.7rem 1.4rem;
        font-family: var(--font-ui, "Outfit", system-ui, sans-serif);
        font-size: 1rem;
        font-weight: 800;
        border: 3px solid var(--confirm-ink);
        border-radius: 9999px;
        box-shadow: 0 5px 0 var(--confirm-ink);
        cursor: pointer;
        text-decoration: none;
        transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease, filter 0.15s ease;
    }

    .confirmation__button:hover {
        transform: translateY(-2px);
        box-shadow: 0 7px 0 var(--confirm-ink);
    }

    .confirmation__button:active {
        transform: translateY(5px);
        box-shadow: 0 0 0 var(--confirm-ink);
    }

    .confirmation__button--play {
        color: var(--color-white, #ffffff);
        background-color: var(--confirm-primary);
    }

    .confirmation__button--play:hover {
        filter: brightness(1.05);
    }

    .confirmation__button--home {
        color: var(--confirm-ink);
        background-color: var(--color-white, #ffffff);
    }

    .confirmation__button--home:hover {
        background-color: var(--confirm-sky);
    }

    .confirmation__button:focus-visible {
        outline: 3px solid var(--confirm-primary);
        outline-offset: 3px;
    }

    @keyframes confirm-pop {
        from {
            opacity: 0;
            transform: scale(0.92) translateY(16px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    @media (max-width: 480px) {
        .confirmation__actions {
            flex-direction: column;
        }

        .confirmation__button {
            width: 100%;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .confirmation__content {
            animation: none;
        }

        .confirmation__button {
            transition: none;
        }
    }
</style>

<main class="confirmation__content">
    <h1 class="confirmation__title">{{confirmacion_titulo}}</h1>
    <p class="confirmation__message">{{confirmacion_mensaje}}</p>
    <nav class="confirmation__actions" aria-label="Opciones de propuesta">
        <a class="confirmation__button confirmation__button--home" href="{{url_boton_secundario}}">{{confirmacion_boton_secundario}}</a>
        <a class="confirmation__button confirmation__button--play" href="{{url_boton_principal}}">{{confirmacion_boton_principal}}</a>
    </nav>
</main>