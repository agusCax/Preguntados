<style>
    body {
        background-color: var(--color-cream, #fff8e8);
    }

    .adm,
    .adm *,
    .adm *::before,
    .adm *::after {
        box-sizing: border-box;
    }

    .adm {
        --adm-ink: var(--color-ink, #0f172a);
        --adm-muted: var(--color-ink-soft, #334155);
        --adm-primary: var(--color-primary, #0284c7);
        --adm-primary-dark: var(--color-primary-dark, #0369a1);
        --adm-sky: var(--color-sky-soft, #bfe6fb);
        --adm-sun: var(--color-sun, #fcd34d);

        max-width: 1060px;
        margin: 0 auto;
        padding: 1.75rem 1rem 2.75rem;
        font-family: var(--font-text, "Nunito", "Outfit", system-ui, sans-serif);
        color: var(--adm-ink);
    }

    .adm a:focus-visible,
    .adm button:focus-visible,
    .adm select:focus-visible {
        outline: 3px solid var(--adm-primary);
        outline-offset: 3px;
    }

    /* Encabezado con los filtros */
    .adm__top {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.15rem;
        padding: clamp(1.25rem, 3.5vw, 1.75rem);
        margin-bottom: 1.5rem;
        background-color: var(--adm-sky);
        border: 3px solid var(--adm-ink);
        border-radius: 1.75rem;
        box-shadow: 0 8px 0 var(--adm-ink);
    }

    .adm__title {
        margin: 0;
        font-family: var(--font-display, "Fredoka", "Outfit", system-ui, sans-serif);
        font-size: clamp(1.65rem, 5vw, 2.25rem);
        line-height: 1.15;
        font-weight: 700;
        color: var(--adm-ink);
    }

    .adm__subtitle {
        margin: 0.3rem 0 0;
        color: var(--adm-muted);
        font-size: 1rem;
        font-weight: 800;
    }

    .adm__filtros {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 0.75rem;
    }

    .adm__campo {
        display: grid;
        gap: 0.3rem;
        font-family: var(--font-ui, "Outfit", system-ui, sans-serif);
        font-weight: 800;
        font-size: 0.88rem;
        color: var(--adm-ink);
    }

    .adm__select {
        min-height: 46px;
        padding: 0 0.95rem;
        font-family: var(--font-text, "Nunito", system-ui, sans-serif);
        font-size: 0.98rem;
        font-weight: 800;
        color: var(--adm-ink);
        background-color: var(--color-white, #ffffff);
        border: 2.5px solid var(--adm-ink);
        border-radius: 0.95rem;
        box-shadow: 0 3px 0 var(--adm-ink);
        cursor: pointer;
    }

    .adm__boton {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 1.25rem;
        font-family: var(--font-ui, "Outfit", system-ui, sans-serif);
        font-size: 0.95rem;
        font-weight: 800;
        text-decoration: none;
        color: var(--color-white, #ffffff);
        background-color: var(--adm-primary);
        border: 3px solid var(--adm-ink);
        border-radius: 9999px;
        box-shadow: 0 4px 0 var(--adm-ink);
        cursor: pointer;
        transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.15s ease, filter 0.15s ease;
    }

    button.adm__boton {
        color: var(--adm-ink);
        background-color: var(--adm-sun);
    }

    .adm__boton:hover {
        filter: brightness(1.04);
        transform: translateY(-2px);
        box-shadow: 0 6px 0 var(--adm-ink);
    }

    .adm__boton:active {
        transform: translateY(4px);
        box-shadow: 0 0 0 var(--adm-ink);
    }

    .adm__aviso {
        margin: 0 0 1.25rem;
        padding: 0.85rem 1.15rem;
        font-weight: 800;
        color: #b91c1c;
        background-color: #fecaca;
        border: 2.5px solid var(--adm-ink);
        border-radius: 1.15rem;
        box-shadow: 0 4px 0 var(--adm-ink);
    }

    .adm__aviso:empty {
        display: none;
    }

    /* Tarjetas con los números */
    .adm__kpis {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(165px, 1fr));
        gap: 0.95rem;
        margin-bottom: 1.65rem;
    }

    .adm__kpi {
        padding: 1.1rem 0.9rem;
        text-align: center;
        background-color: var(--color-white, #ffffff);
        border: 3px solid var(--adm-ink);
        border-radius: 1.5rem;
        box-shadow: 0 6px 0 var(--adm-ink);
    }

    .adm__kpi-numero {
        margin: 0;
        font-family: var(--font-display, "Fredoka", "Outfit", system-ui, sans-serif);
        font-size: 2.15rem;
        line-height: 1.1;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        color: var(--adm-primary-dark);
    }

    .adm__kpi-texto {
        margin: 0.3rem 0 0;
        font-size: 0.9rem;
        font-weight: 800;
        color: var(--adm-muted);
    }

    /* Un bloque por reporte: gráfico + tabla */
    .adm__grid {
        display: grid;
        gap: 1.35rem;
    }

    .adm__reporte {
        min-width: 0;
        padding: 1.35rem;
        background-color: var(--color-white, #ffffff);
        border: 3px solid var(--adm-ink);
        border-radius: 1.75rem;
        box-shadow: 0 8px 0 var(--adm-ink);
    }

    .adm__reporte-titulo {
        margin: 0 0 0.9rem;
        font-family: var(--font-display, "Fredoka", "Outfit", system-ui, sans-serif);
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--adm-ink);
    }

    .adm__grafico {
        position: relative;
        height: 260px;
        margin-bottom: 1.1rem;
        padding: 0.5rem;
    }

    .adm__tabla-wrap {
        overflow-x: auto;
    }

    .adm__tabla {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
        background-color: var(--color-white, #ffffff);
    }

    .adm__tabla th,
    .adm__tabla td {
        padding: 0.6rem 0.75rem;
        text-align: left;
    }

    .adm__tabla th:last-child,
    .adm__tabla td:last-child {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .adm__tabla thead th {
        font-family: var(--font-ui, "Outfit", system-ui, sans-serif);
        font-weight: 800;
        color: var(--adm-ink);
        background-color: var(--adm-sky);
    }

    .adm__tabla thead th:first-child {
        border-top-left-radius: 0.85rem;
        border-bottom-left-radius: 0.85rem;
    }

    .adm__tabla thead th:last-child {
        border-top-right-radius: 0.85rem;
        border-bottom-right-radius: 0.85rem;
    }

    .adm__tabla tbody td {
        font-weight: 700;
        border-bottom: 1px solid #e2e8f0;
    }

    .adm__tabla tbody tr:last-child td {
        border-bottom: 0;
    }

    .adm__vacio {
        color: var(--adm-muted);
        font-style: italic;
        text-align: center !important;
    }

    @media (min-width: 900px) {
        .adm__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .adm__boton {
            transition: none;
        }
    }

    /* Al imprimir se muestran solo las tablas de datos */
    @media print {
        body {
            background: #ffffff;
        }

        header,
        footer,
        .adm__filtros,
        .adm__grafico,
        .adm__aviso {
            display: none !important;
        }

        .adm__top,
        .adm__kpi,
        .adm__reporte {
            background: none;
            border: 1px solid #0f172a;
            box-shadow: none;
        }

        .adm__grid {
            grid-template-columns: 1fr;
        }

        .adm__reporte {
            break-inside: avoid;
        }
    }
</style>

<main class="adm">

    <section class="adm__top">
        <div>
            <h1 class="adm__title">Panel del administrador</h1>
            <p class="adm__subtitle">Estadísticas de Cerebrito</p>
        </div>

        <div class="adm__filtros">
            <label class="adm__campo" for="periodo">
                Período
                <select class="adm__select" id="periodo">
                    <option value="dia">Último día</option>
                    <option value="semana">Última semana</option>
                    <option value="mes" selected>Último mes</option>
                    <option value="anio">Último año</option>
                </select>
            </label>
            <button type="button" class="adm__boton" id="imprimir">Imprimir</button>
            <a class="adm__boton" href="{{base_url}}/administrador/usuarios">Gestionar usuarios</a>
            <a class="adm__boton" href="{{base_url}}/reporte/ranking">Reporte de ranking</a>
        </div>
    </section>

    <p class="adm__aviso" id="aviso" role="status" aria-live="polite"></p>

    <!-- Números sueltos -->
    <section class="adm__kpis" aria-label="Resumen">
        <div class="adm__kpi">
            <p class="adm__kpi-numero" id="kpi-jugadores">–</p>
            <p class="adm__kpi-texto">Jugadores</p>
        </div>
        <div class="adm__kpi">
            <p class="adm__kpi-numero" id="kpi-partidas">–</p>
            <p class="adm__kpi-texto">Partidas jugadas</p>
        </div>
        <div class="adm__kpi">
            <p class="adm__kpi-numero" id="kpi-preguntas-activas">–</p>
            <p class="adm__kpi-texto">Preguntas en el juego</p>
        </div>
        <div class="adm__kpi">
            <p class="adm__kpi-numero" id="kpi-preguntas-creadas">–</p>
            <p class="adm__kpi-texto">Preguntas creadas</p>
        </div>
        <div class="adm__kpi">
            <p class="adm__kpi-numero" id="kpi-usuarios-nuevos">–</p>
            <p class="adm__kpi-texto">Usuarios nuevos</p>
        </div>
    </section>

    <!-- Reportes: cada uno tiene su gráfico y su tabla -->
    <div class="adm__grid">

        <section class="adm__reporte">
            <h2 class="adm__reporte-titulo">Usuarios por país</h2>
            <div class="adm__grafico">
                <canvas id="grafico-pais" role="img" aria-label="Gráfico de usuarios por país"></canvas>
            </div>
            <div class="adm__tabla-wrap">
                <table class="adm__tabla" id="tabla-pais">
                    <thead><tr><th>País</th><th>Usuarios</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>

        <section class="adm__reporte">
            <h2 class="adm__reporte-titulo">Usuarios por sexo</h2>
            <div class="adm__grafico">
                <canvas id="grafico-sexo" role="img" aria-label="Gráfico de usuarios por sexo"></canvas>
            </div>
            <div class="adm__tabla-wrap">
                <table class="adm__tabla" id="tabla-sexo">
                    <thead><tr><th>Sexo</th><th>Usuarios</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>

        <section class="adm__reporte">
            <h2 class="adm__reporte-titulo">Usuarios por grupo de edad</h2>
            <div class="adm__grafico">
                <canvas id="grafico-edad" role="img" aria-label="Gráfico de usuarios por grupo de edad"></canvas>
            </div>
            <div class="adm__tabla-wrap">
                <table class="adm__tabla" id="tabla-edad">
                    <thead><tr><th>Grupo</th><th>Usuarios</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>

        <section class="adm__reporte">
            <h2 class="adm__reporte-titulo">Respuestas correctas por usuario</h2>
            <div class="adm__grafico">
                <canvas id="grafico-aciertos" role="img" aria-label="Gráfico del porcentaje de respuestas correctas por usuario"></canvas>
            </div>
            <div class="adm__tabla-wrap">
                <table class="adm__tabla" id="tabla-aciertos">
                    <thead><tr><th>Usuario</th><th>% correctas</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>

    </div>
</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
    (function () {
        // Ruta que devuelve todos los datos en JSON (la arma el AdministradorController)
        const URL_DATOS = '{{base_url}}/administrador/datos';

        const colores = ['#0284c7', '#f59e0b', '#4ade80', '#ec4899', '#8b5cf6', '#ef4444'];
        const nombresSexo = {
            masculino: 'Masculino',
            femenino: 'Femenino',
            no_informa: 'Prefiere no cargarlo'
        };

        const selectorPeriodo = document.getElementById('periodo');
        const aviso = document.getElementById('aviso');
        const graficos = {};

        // Completa una tabla con las filas { etiqueta, valor }
        function llenarTabla(idTabla, filas, sufijo) {
            const cuerpo = document.querySelector('#' + idTabla + ' tbody');
            cuerpo.innerHTML = '';

            if (filas.length === 0) {
                const fila = cuerpo.insertRow();
                const celda = fila.insertCell();
                celda.colSpan = 2;
                celda.className = 'adm__vacio';
                celda.textContent = 'Sin datos para este período.';
                return;
            }

            filas.forEach(function (dato) {
                const fila = cuerpo.insertRow();
                // textContent (y no innerHTML) para que un nombre raro no se interprete como HTML
                fila.insertCell().textContent = dato.etiqueta;
                fila.insertCell().textContent = Number(dato.valor).toLocaleString('es-AR') + sufijo;
            });
        }

        // Dibuja un gráfico. Si ya existía uno, lo borra y lo vuelve a crear con los datos nuevos
        function dibujar(idCanvas, tipo, filas, nombreDato, horizontal, maximo) {
            if (graficos[idCanvas]) {
                graficos[idCanvas].destroy();
            }

            const esTorta = tipo === 'doughnut';

            graficos[idCanvas] = new Chart(document.getElementById(idCanvas), {
                type: tipo,
                data: {
                    labels: filas.map(function (dato) { return dato.etiqueta; }),
                    datasets: [{
                        label: nombreDato,
                        data: filas.map(function (dato) { return Number(dato.valor); }),
                        backgroundColor: esTorta ? colores : colores[0],
                        borderColor: '#0f172a',
                        borderWidth: 2,
                        borderRadius: esTorta ? 0 : 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    indexAxis: horizontal ? 'y' : 'x',
                    plugins: {
                        legend: { display: esTorta }
                    },
                    scales: esTorta ? {} : {
                        [horizontal ? 'x' : 'y']: {
                            beginAtZero: true,
                            max: maximo,
                            ticks: { precision: 0 }
                        }
                    }
                }
            });
        }

        // Recibe el JSON del servidor y actualiza toda la pantalla
        function pintar(datos) {
            document.getElementById('kpi-jugadores').textContent = datos.totales.jugadores;
            document.getElementById('kpi-partidas').textContent = datos.totales.partidas;
            document.getElementById('kpi-preguntas-activas').textContent = datos.totales.preguntas_activas;
            document.getElementById('kpi-preguntas-creadas').textContent = datos.totales.preguntas_creadas;
            document.getElementById('kpi-usuarios-nuevos').textContent = datos.totales.usuarios_nuevos;

            dibujar('grafico-pais', 'bar', datos.pais, 'Usuarios', false);
            llenarTabla('tabla-pais', datos.pais, '');

            const sexo = datos.sexo.map(function (dato) {
                return { etiqueta: nombresSexo[dato.etiqueta] || dato.etiqueta, valor: dato.valor };
            });
            dibujar('grafico-sexo', 'doughnut', sexo, 'Usuarios', false);
            llenarTabla('tabla-sexo', sexo, '');

            dibujar('grafico-edad', 'bar', datos.edad, 'Usuarios', false);
            llenarTabla('tabla-edad', datos.edad, '');

            dibujar('grafico-aciertos', 'bar', datos.aciertos, '% correctas', true, 100);
            llenarTabla('tabla-aciertos', datos.aciertos, '%');
        }

        // Le pide los datos al servidor según el período elegido
        function cargar() {
            aviso.textContent = '';

            fetch(URL_DATOS + '?periodo=' + encodeURIComponent(selectorPeriodo.value))
                    .then(function (respuesta) {
                        if (!respuesta.ok) {
                            throw new Error('Respuesta inválida');
                        }
                        return respuesta.json();
                    })
                    .then(pintar)
                    .catch(function () {
                        aviso.textContent = 'No se pudieron cargar los datos. Probá de nuevo.';
                    });
        }

        selectorPeriodo.addEventListener('change', cargar);
        document.getElementById('imprimir').addEventListener('click', function () {
            // Abre el PDF del período elegido en una pestaña nueva
            window.open('{{base_url}}/administrador/panelPdf?periodo=' + encodeURIComponent(selectorPeriodo.value), '_blank');
        });

        cargar();
    })();
</script>