<style>
    .usr {
        max-width: 860px;
        margin: 0 auto;
        padding: 1.5rem 1rem 2.5rem;
        font-family: var(--font-text, "Nunito", system-ui, sans-serif);
        color: var(--color-ink, #0f172a);
    }

    .usr__title {
        margin: 0 0 0.25rem;
        font-family: var(--font-display, "Fredoka", system-ui, sans-serif);
        font-size: clamp(1.6rem, 5vw, 2.2rem);
    }

    .usr__mensaje {
        margin: 1rem 0;
        padding: 0.7rem 1rem;
        background: #e0f2fe;
        border-radius: 0.75rem;
        font-weight: 700;
    }

    .usr__tabla {
        width: 100%;
        border-collapse: collapse;
        background: #ffffff;
        border-radius: 1rem;
        overflow: hidden;
    }

    .usr__tabla th,
    .usr__tabla td {
        padding: 0.75rem 1rem;
        text-align: left;
        border-bottom: 1px solid #e2e8f0;
    }

    .usr__tabla th {
        background: #f1f5f9;
    }

    .usr__form {
        display: flex;
        gap: 0.5rem;
        margin: 0;
    }

    .usr__select,
    .usr__boton {
        min-height: 40px;
        padding: 0 0.8rem;
        font: inherit;
        border-radius: 9999px;
    }

    .usr__select {
        border: 2px solid #cbd5e1;
        background: #ffffff;
    }

    .usr__boton {
        border: 0;
        font-weight: 800;
        color: #ffffff;
        background: #0284c7;
        cursor: pointer;
    }

    .usr__yo {
        color: #64748b;
        font-weight: 700;
    }
</style>

<main class="usr">
    <h1 class="usr__title">Gestión de usuarios</h1>
    <p><a href="{{base_url}}/administrador/show">← Volver al panel</a></p>

    {{#mensaje}}
        <p class="usr__mensaje" role="status">{{mensaje}}</p>
    {{/mensaje}}

    <table class="usr__tabla">
        <thead>
        <tr>
            <th>Usuario</th>
            <th>Email</th>
            <th>Rol</th>
        </tr>
        </thead>
        <tbody>
        {{#usuarios}}
            <tr>
                <td>{{nombre_usuario}}</td>
                <td>{{email}}</td>
                <td>
                    {{#es_usuario_actual}}
                        <span class="usr__yo">Vos (no se puede cambiar)</span>
                    {{/es_usuario_actual}}
                    {{^es_usuario_actual}}
                        <form class="usr__form" method="post" action="{{base_url}}/administrador/cambiarRol">
                            <input type="hidden" name="usuario_id" value="{{id}}">
                            <select class="usr__select" name="rol_id" aria-label="Rol de {{nombre_usuario}}">
                                {{#roles}}
                                    <option value="{{valor}}" {{#seleccionado}}selected{{/seleccionado}}>{{nombre}}</option>
                                {{/roles}}
                            </select>
                            <button class="usr__boton" type="submit">Guardar</button>
                        </form>
                    {{/es_usuario_actual}}
                </td>
            </tr>
        {{/usuarios}}
        </tbody>
    </table>
</main>